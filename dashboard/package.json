{
  "name": "battle-city-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Battle City Web 训练控制台（NN 训练栈的观测 + 操作面板，独立 bun 项目）",
  "type": "module",
  "scripts": {
    "start": "bun src/server/server.ts",
    "launch": "bun src/launch/cli.ts",
    "build:ui": "bun src/server/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel --timeout=50000 tests",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "typescript": "7.0.2"
  }
}
