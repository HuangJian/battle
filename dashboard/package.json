{
  "name": "battle-city-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Battle City Web 训练控制台（NN 训练栈的观测 + 操作面板，独立 bun 项目）",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun src/server/server.ts",
    "launch": "bun src/launch/cli.ts",
    "course-metrics": "bun scripts/course-metrics.ts",
    "build:ui": "bun src/server/build.ts",
    "typecheck": "bun check --no-script",
    "test": "bun scripts/run-tests.ts",
    "lint": "oxlint",
    "format": "bun fmt"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint": "^1.74.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0"
  }
}
