# Call history archive (plan/God-AI-Replay-Visualization)
replays/
*.cpuprofile

# 控制台客户端 bundle（dashboard/src/server/build.ts 启动自动构建，产物不入库）
dashboard/.build/

# God AI 调优一次性诊断产物（progress doc §0.C：A/B 脚本不入库，临时数据 commit 前删除）
tmp/
# Generated probe courses (human-opening probe). One course per human session:
# the list is scratch and the manifest is served, never versioned — the durable
# record of a probe is its session pack (zip). Regenerate with
#   bun tools/probe/flatten-manifest.ts
/public/probe/
reports/
ab-test-*.ts

nn-demo/
nn-training/weights/**/*.json
nn-training/weights/**/*.ckpt.*
nn-training/weights/**/*.md
nn-training/archive

# 课程封存区（plan/course-archive.plan.md §3.1）：只入库索引两件（可查/可比的载体：
# ARCHIVE.md + archive-manifest.json），权重/账本/判决行/gz 件留本地——与上面
# nn-training/weights/**/*.json 同一条理（大件不进库，且这些 json 本来就已被忽略）。
# 归档根在**仓根** archive/，与上面的历史条目 nn-training/archive **不是**同一路径。
# 写法照 dashboard/data/evalboard/*：不先整树排除父目录，只排课目录下的一层，
# 再用否定把两件索引捞回来。
archive/courses/*/*
!archive/courses/*/ARCHIVE.md
!archive/courses/*/archive-manifest.json

.venv/

# 分布式采样密钥（plan/distributed-rollout.md v3.3，严禁入库）
tools/agent/agent.auth

# RL EvalBench 账本（plan/rl-eval-system.md §3.1：gitignore + 人工备份，无 git 兜底；
# 唯一例外 README.md 入库，写备份纪律；备份由 backup.ts 导出仓库外。
# 写法注意：不能先整树排除父目录（被排除目录内的否定无效），只能逐项排除内容。）
dashboard/data/evalboard/*
!dashboard/data/evalboard/README.md

*.lock
*.lock.*
*.log
*.zip

# Python 字节码缓存（nn-training/.gitignore 有自己的副本；dashboard/ 下也有 .py
# （kick-once.py 等），其测试 import 它们会生成 __pycache__）
__pycache__/
*.pyc

# uv.lock 是 universal 锁文件，必须入库（2026-09-04 决策：uv + uv.lock 真锁）
!nn-training/uv.lock

# dashboard 是独立 bun 项目，bun.lock 是它可复现安装的唯一保证（同上条逻辑：
# 上面的 *.lock 本意是运行时 PID 锁文件，不该连带把真依赖锁文件也挡在外面）。
!dashboard/bun.lock
nn-training/rl-config.json
