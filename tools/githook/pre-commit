#!/bin/sh
# pre-commit hook — 多 agent 并行安全版：报错按文件归因（DECISIONS §344，2026-09-06）。
#
# 语义：全量门禁照常运行（判定质量不降级），但 **拦截只认 staged 归因** ——
# 报错落在本次提交的文件上才中止；落在未暂存/未跟踪文件上（多 agent 并行时
# 他人的在途改动随时会把整程序门禁打成红）只告警不拦，由改动的主人后继自理。
#
#   门禁            行为
#   --------------  -----------------------------------------------------------
#   ruff            只对 staged 的 nn-training/**/*.py 运行，红即拦
#                   （范围化 = 归因化：未暂存文件根本不参与判定）
#   mypy + pytest   nn-python-gate.sh 全量运行；**仅当 staged 里存在
#                   nn-training/**/*.py 时才跑** —— 无 staged py 时，mypy/pytest
#                   的报错归因交集必然为空（全部落在未暂存/他人文件上 ⇒ 本来就放行），
#                   跑它零拦截收益、白烧 25s+（2026-09-14：一个只改
#                   nn-training/weights/WEIGHTS.md 的提交触发了全量 python 门禁）。
#                   mypy 报错按文件归因：staged 归因 → 拦；全部未暂存 → 放行；
#                   pytest 红 → 拦 + 归因指引（因果由提交 agent 判定：自己的修，
#                   他人的汇报后定向跳过重试 NN_GATE_SKIP=pytest）
#   tsc             **仅当 staged 含根项目 TS/JS（排除 dashboard/）时**全量运行；
#                   纯 md / nn-training / 仅 dashboard 提交不触发（2026-09-15）。
#                   报错按文件归因，staged → 拦；全部未暂存/未跟踪 → 放行；
#                   无法归因到文件的错误 → 拦（保守）
#   dashboard       仅 staged 含 dashboard/ 时运行（dashboard 是独立 bun
#                   项目，不属根 tsconfig / 根套件 —— 见 DECISIONS
#                   §2026-09-14-goalnn-dashboard-project）；tsc 报错前缀
#                   dashboard/ 归因，staged → 拦；bun test 红 → 拦 + 归因指引。
#                   **只改 dashboard 时不会连带跑根 bun test / 根 tsc / python /
#                   freeze**（外部套件与 dashboard 无归因交集）
#   bun test        仅当 staged 含根项目 TS/JS（排除 dashboard/）时运行；
#                   跑的是**全量**（非 heavy）——test-silent 已删除 basename 窄跑
#                   （它欠采样：改 stages.ts 只跑 1 个而 50 个依赖它；
#                   DECISIONS §2026-09-15-gate-trigger-scope）；纯文档/课程配置与
#                   只改 dashboard 仍直接跳过。红 → 拦 + 归因指引（SKIP_BUN_TEST=1 定向跳过重试）
#   oxfmt           逐 staged 文件格式化 + re-add；**另有未暂存改动（MM）的
#                   文件跳过** —— 格式化工作树内容会把未暂存编辑折进提交
#                   （2026-09-06 v1 事故教训）。永不阻断。
#   oxlint          staged 文件，红即拦（不变）
#   freeze          仅 staged 含 **根项目** TS/游戏代码（*.ts 等 / src/，
#                   排除 dashboard/）时运行；dashboard TS 与纯 md/nn-training
#                   不可能改变 det 签名。
#                   2026-09-15 再收窄：`tests/**` 与 `src/assets/**` 也豁免——签名闭包
#                   只含 src/** 与 tools/lib/**，不可能被测试文件或精灵图移动。该理由由
#                   tests/freeze-scope.test.ts 钉住（算传递闭包并断言与这两个目录零交集，
#                   且断非空防假通过）。**注意收益**：豁免当初按「各省 ~100s」立项，
#                   实测只省 ~3.7s（旧数字错 ~27×）——见下方 freeze 块。
#
#   逃生口：NN_GATE_SKIP=<tools>（python 单工具，已有）、NN_GATE_SKIP_E2E=1
#   （只退 python 门禁里的 e2e 集成层，单测层照跑——e2e 有竞速/负载敏感用例，
#   见 docs/nn.progress.md §313）、SKIP_BUN_TEST=1、SKIP_DASHBOARD_GATE=1、
#   --no-verify（全跳，最后手段）。
#   --selftest：不跑门禁，只对归因解析器跑内置断言（改本 hook 必跑）。
#
#   铁律：除 oxfmt 对「无未暂存改动的 staged 文件」的精确格式化外，本 hook
#   对工作树 **零写操作**。历史教训：v1「临时摘除未暂存改动」在多 agent 并行
#   下弄丢了他人在途工作；v2 影子树方案（junction/锁/守卫）因复杂危险被否决
#   ——归因式拦截是既不弃门禁又不碰工作树的解。
#   已知接受的误差（用户裁定语义）：staged 改共享接口 → 报错落在他人未暂存
#   文件上 → 放行，对方后继撞见并修复；反向（他人半成品 import 进我的
#   staged 文件）→ 假拦截，肉眼可辨后走逃生口。

# Abort on the first failing command.
set -e

# --- 沙箱删除免疫（进程树级；唯一实现 = tools/githook/_sandbox-sanitize.sh）-----
# 机理 / 铁律 / 被否备选：DECISIONS §2026-09-15-sandbox-precommit-immunity。
# 一句话：WorkBuddy / Mimo 的删除保护沙箱经环境变量随进程树注入（BASH_ENV 包装
# rm 函数 + python sitecustomize 守卫），子进程照拦不误；本 hook 与 nn-py-safe.sh
# 共享下面这份拉闸（BASH_ENV→/dev/null、unset 注入变量、python 守卫=0、PATH 滤 shim）。
_hdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
. "$_hdir/_sandbox-sanitize.sh"
unset _hdir

# --- Locate `bun` even if it is not yet on PATH ---------------------------------
# Coding agents may commit from a Linux shell, Windows Git Bash, or Windows PowerShell 7 (pwsh),
# each with a slightly different PATH. Augment PATH with the common bun install dirs so
# the hook resolves `bun` regardless of the calling environment.
add_to_path() {
  [ -z "$1" ] && return 0
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

if ! command -v bun >/dev/null 2>&1; then
  # npm global bin (where `npm i -g bun` installs)
  if command -v npm >/dev/null 2>&1; then
    NPM_GLOBAL=$(npm bin -g 2>/dev/null) || NPM_GLOBAL=$(npm prefix -g 2>/dev/null)
    add_to_path "$NPM_GLOBAL"
    add_to_path "$NPM_GLOBAL/bin"
  fi
  # bun's own installer location (all platforms)
  add_to_path "$HOME/.bun/bin"
  # Windows npm global lives under %APPDATA%\Roaming\npm
  if [ -n "$APPDATA" ]; then
    APPDIR=$(printf '%s' "$APPDATA" | tr '\\' '/' | tr '[:upper:]' '[:lower:]')
    APPDIR=$(printf '%s' "$APPDATA" | sed -E 's|^([a-z]):/|/\1/|')
    add_to_path "$APPDIR/Roaming/npm"
  fi
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "✗ 'bun' was not found on PATH and could not be located in common install dirs."
  echo "  Install bun (https://bun.sh) or add it to PATH, then retry the commit."
  exit 1
fi

BUN=$(command -v bun)
TOP=$(git rev-parse --show-toplevel)
cd "$TOP"

# ------------------------------------------------------------------ 归因解析器
# tsc 错误行：tools/x.ts(32,21): error TS2440: ... → 文件路径（正斜杠）
attrib_tsc() {
  grep -E '^[^ (]+\([0-9]+,[0-9]+\): error TS[0-9]+:' "$1" \
    | cut -d'(' -f1 | sed 's|\\|/|g' | sort -u
}
# mypy 错误行：tests\x.py:73: error: ... [code] → 文件路径（反斜杠归一；摘要行排除）
attrib_mypy() {
  grep -E '^[^ :]+:[0-9]+: error: ' "$1" \
    | sed -E 's|:[0-9]+: error: .*||; s|\\|/|g' | sort -u
}
# 候选文件（stdin）∩ staged 集合（$1 = staged 清单文件）→ 命中者
attrib_staged_hits() {
  grep -Fxf "$1" || true
}

hook_selftest() {
  D="tmp/selftest-$$"
  mkdir -p "$D"
  FAIL=0
  printf '%s\n' \
    'tools/agent/sampler-agent.ts(32,21): error TS2440: Import declaration conflicts with local declaration' \
    'src/foo.ts(1,1): error TS2322: Type "x" is not "y"' \
    'src/bar.ts(2,2): error TS9999: bad' \
    > "$D/tsc.log"
  TSC_OUT=$(attrib_tsc "$D/tsc.log")
  if ! printf '%s\n' "$TSC_OUT" | grep -Fqx 'tools/agent/sampler-agent.ts'; then
    echo "selftest FAIL: tsc 路径提取缺失"; FAIL=1
  fi
  if ! printf '%s\n' "$TSC_OUT" | grep -Fqx 'src/bar.ts'; then
    echo "selftest FAIL: tsc 路径提取缺失(src/bar.ts)"; FAIL=1
  fi
  printf '%s\n' \
    'tests\test_rl_remote_fixes.py:73: error: "object" has no attribute "_course_iter"  [attr-defined]' \
    'rl\loop_steps.py:10: error: Something [misc]' \
    'Found 2 errors in 2 files (checked 118 source files)' \
    > "$D/mypy.log"
  MYPY_OUT=$(attrib_mypy "$D/mypy.log")
  if ! printf '%s\n' "$MYPY_OUT" | grep -Fqx 'tests/test_rl_remote_fixes.py'; then
    echo "selftest FAIL: mypy 反斜杠归一失败"; FAIL=1
  fi
  if ! printf '%s\n' "$MYPY_OUT" | grep -Fqx 'rl/loop_steps.py'; then
    echo "selftest FAIL: mypy 路径提取缺失"; FAIL=1
  fi
  if printf '%s\n' "$MYPY_OUT" | grep -q 'Found 2 errors'; then
    echo "selftest FAIL: mypy 摘要行被误认为路径"; FAIL=1
  fi
  printf '%s\n' 'tools/agent/sampler-agent.ts' > "$D/staged.txt"
  printf '%s\n' "$TSC_OUT" > "$D/tsc.files"
  HITS=$(attrib_staged_hits "$D/staged.txt" < "$D/tsc.files")
  if [ -z "$HITS" ]; then
    echo "selftest FAIL: staged 交集应有命中"; FAIL=1
  fi
  printf '%s\n' 'other/thing.ts' > "$D/staged2.txt"
  HITS2=$(attrib_staged_hits "$D/staged2.txt" < "$D/tsc.files")
  if [ -n "$HITS2" ]; then
    echo "selftest FAIL: 非 staged 命中应为空"; FAIL=1
  fi
  # dashboard 门禁块（独立 bun 项目）：dashboard 内 tsc 输出的是**相对它自己**的
  # 路径，必须前缀 dashboard/ 才能与 staged 清单（仓库相对）求交 —— 漏了这一步，
  # 归因永远为空，dashboard 的 tsc 红会被当成「他人未暂存改动」而放行。
  printf '%s\n' \
    'src/server/build.ts(12,3): error TS2345: Argument of type x is not assignable' \
    'tests/evalboard-board.test.ts(4,1): error TS2554: Expected 1 arguments' \
    > "$D/dash-tsc.log"
  DASH_FILES=$(attrib_tsc "$D/dash-tsc.log" | sed 's|^|dashboard/|' | sort -u)
  if ! printf '%s\n' "$DASH_FILES" | grep -Fqx 'dashboard/src/server/build.ts'; then
    echo "selftest FAIL: dashboard 前缀归因缺失（src/server/build.ts）"; FAIL=1
  fi
  printf '%s\n' 'dashboard/src/server/build.ts' > "$D/dash-staged.txt"
  if [ -z "$(printf '%s\n' "$DASH_FILES" | attrib_staged_hits "$D/dash-staged.txt")" ]; then
    echo "selftest FAIL: dashboard 归因应与 staged 清单有交集"; FAIL=1
  fi
  printf '%s\n' 'src/server/build.ts' > "$D/dash-other.txt"
  if [ -n "$(printf '%s\n' "$DASH_FILES" | attrib_staged_hits "$D/dash-other.txt")" ]; then
    echo "selftest FAIL: dashboard 归因与非 staged 路径不得有交集"; FAIL=1
  fi
  # 零删除铁律（2026-09-15）：截断文件、不 rmdir（rmdir ✓ 也在沙箱包装清单上）。
  # 残留的 tmp/selftest-$$ 0 字节目录由 periodic 清理兜底。
  for __f in "$D"/*; do [ -e "$__f" ] && : > "$__f"; done
  if [ "$FAIL" -eq 0 ]; then
    echo "✓ hook selftest 全部通过"
  fi
  return "$FAIL"
}

if [ "${1:-}" = "--selftest" ]; then
  hook_selftest
  exit $?
fi

echo "▶ Running pre-commit checks (bun: $BUN)..."

# ---------- 提交内容清单（staged = 归因基准；dirty = 归因排除集） ----------
STAGED_LIST="tmp/pre-commit-staged-$$.txt"
DIRTY_LIST="tmp/pre-commit-dirty-$$.txt"
TSC_LOG="tmp/pre-commit-tsc-$$.log"
GATE_LOG="tmp/pre-commit-nn-$$.log"
DASH_TSC_LOG="tmp/pre-commit-dash-$$.log"
# EXIT 清理 = **截断不删除**（2026-09-15，进程树免疫的兜底铁律）：`rm -f` 是删除
# syscall，会被沙箱识别（配额 FAIL_CLOSED / 弹人工删除审批）——v1 实测门禁全绿提交
# 却被静默丢弃（2026-09-14：`✓ All pre-commit checks passed` 紧跟
# `[safe-delete][SAFE_DELETE_BULK_CONFIRM_REQUIRED] count=182 threshold=50`）。
# `: > file` 是写入不是删除，任何删除拦截都对其失效；残留 0 字节文件在 gitignored
# tmp/ 下由 periodic 清理兜底。清理自己的临时文件失败/被拦，没有任何理由决定提交成败。
trap 'for __f in "$STAGED_LIST" "$DIRTY_LIST" "$TSC_LOG" "$GATE_LOG" "$DASH_TSC_LOG"; do [ -e "$__f" ] && : > "$__f"; done' EXIT
# `--diff-filter=ACMR`（2026-09-21 修）：**删除的路径不能进归因清单** —— 各 linter 都是
# 「按路径打开文件」，路径不存在就是硬错（实测：删掉 `nn-training/tests/test_remote_degrade.py`
# 后被 ruff 判 `E902 The system cannot find the file specified` ⇒ 整次提交被拦，而代码本身全绿）。
# 归因集只需要「这次提交**留下**了什么」；A/C/M/R 即此意（D/U 排除）。
git diff --cached --name-only --diff-filter=ACMR > "$STAGED_LIST"
git diff --name-only --diff-filter=ACMR > "$DIRTY_LIST"
STAGED_N=$(wc -l < "$STAGED_LIST" | tr -d ' ')
DIRTY_N=$(wc -l < "$DIRTY_LIST" | tr -d ' ')
echo "  staged ${STAGED_N} 文件（门禁拦截归因集）；未暂存 ${DIRTY_N} 文件（他人改动，不参与拦截）"

# 根项目 TS/JS（**排除 dashboard/**）：dashboard 是独立 bun 项目；只改
# dashboard / 纯 md / nn-training 时根 tsc、根 bun test、freeze 都无归因
# 交集，不应触发（2026-09-15 用户口径）。
ROOT_TS_STAGED=$(grep -E '\.(ts|js|mjs|cjs|tsx|jsx)$' "$STAGED_LIST" | grep -v '^dashboard/' || true)
# freeze 敏感面：根项目 TS/JS + src/（游戏/det 路径），同样排除 dashboard/
# 豁免 tests/** 与 src/assets/**（2026-09-15）：签名 = tools/probe-det-baseline.sh 跑
# tools/diag/per-seed-diff.ts dump 出的文本哈希，其 import 传递闭包只含 src/**（游戏/
# 配置）与 tools/lib/**——测试文件与精灵图改不动它。
# **成本实测 ~3.7s（21 组合全网格，16 核 Linux，2026-09-15），而非原先注释写的 ~100s**
# （错 ~27×）。旧数字正是「豁免值不值」的唯一论据，所以别再引用它——下方 freeze 块会
# 自报每次的真实 elapsed。安全性不靠注释：tests/freeze-scope.test.ts 算闭包并断言零交集。
FREEZE_STAGED=$(grep -E '\.(ts|js|mjs|cjs|tsx|jsx)$|^src/' "$STAGED_LIST" \
  | grep -v '^dashboard/' | grep -vE '^(tests/|src/assets/)' || true)

# ---------- nn-training python 门禁（ruff staged 范围 + mypy/pytest 全量归因） ----
# 触发条件收窄到 **staged 的 nn-training python 文件**（2026-09-14）：原判定是
# `^nn-training/`，于是纯数据/文档提交（nn-training/weights/WEIGHTS.md、
# curricula/*.jsonc、manifest 等）也会跑全量 mypy + pytest。而该门禁的拦截语义是
# 「报错落在 staged 文件上」—— staged 无 py 时这个交集恒为空（按既定语义本来就
# 全部放行），跑它只有开销没有拦截收益。python 代码提交的行为**逐字不变**。
NN_STAGED=$(grep '^nn-training/.*\.py$' "$STAGED_LIST" || true)
if [ -n "$NN_STAGED" ]; then
  if [ -n "$SKIP_NN_TRAINING_GATE" ]; then
    echo "▸ skip nn-training python gate (SKIP_NN_TRAINING_GATE set)"
  else
    NN_PY="$TOP/nn-training/.venv/Scripts/python.exe"
    if [ ! -x "$NN_PY" ]; then NN_PY="$TOP/nn-training/.venv/bin/python"; fi
    STAGED_PY=$(grep '\.py$' "$STAGED_LIST" | grep '^nn-training/' || true)

    if [ -n "$STAGED_PY" ]; then
      echo " ▸ ruff（staged 范围：$(printf '%s\n' "$STAGED_PY" | wc -l | tr -d ' ') 文件——未暂存文件不参与判定）"
      if ! ( cd "$TOP/nn-training" \
             && printf '%s\n' "$STAGED_PY" | sed 's|^nn-training/||' \
             | xargs "$NN_PY" -m ruff check ); then
        echo "✗ ruff（staged 归因）——修复本次提交的文件后重试"
        exit 1
      fi
    fi

    GATE_SKIP="ruff"
    if [ -n "$NN_GATE_SKIP" ]; then GATE_SKIP="ruff,$NN_GATE_SKIP"; fi
    echo " ▸ mypy + pytest（nn-python-gate 全量；mypy 按文件归因，pytest 红走因果判定）"
    GATE_RC=0
    # stdin 丢弃：避免任何子进程继承 git 的 stdio 管道（Windows 上 git 会一直
    # 等 pipe EOF → 门禁全绿后 commit 卡死，2026-09-15）。
    # 不再传位置参数（历史上那个 `4` = 旧 nn-gate-shards.py 的分片数，工具已删）：
    # 并行旋钮由脚本自己定 —— worker 数 = min(核数, 12)（NN_GATE_NPROC 可覆盖）、
    # CPU 内线程 = 1（NN_GATE_THREADS 可覆盖，0 = 不设）。为什么必须成对、实测数据：
    # nn-python-gate.sh 头注（2026-09-17 从 ~36s 降到 ~23s）。
    NN_GATE_SKIP="$GATE_SKIP" sh "$TOP/tools/githook/nn-python-gate.sh" \
      > "$GATE_LOG" 2>&1 < /dev/null || GATE_RC=$?
    cat "$GATE_LOG"
    if [ "$GATE_RC" -ne 0 ]; then
      PYTEST_RED=0
      if grep -qE '^(FAILED |ERROR |={3,} short test summary info)' "$GATE_LOG"; then
        PYTEST_RED=1
      fi
      if [ "$PYTEST_RED" -eq 1 ]; then
        echo "✗ pytest 红——按多 agent 协作语义判定归因后重试："
        echo "   · 失败由你 staged 的改动造成 → 修复后重新 commit；"
        echo "   · 失败源自他人未暂存改动 → 汇报对方，并以 NN_GATE_SKIP=pytest 重试本次 commit。"
        exit 1
      fi
      MYPY_FILES=$(attrib_mypy "$GATE_LOG" | sed 's|^|nn-training/|' | sort -u)
      if [ -n "$MYPY_FILES" ]; then
        MYPY_BLOCK=$(printf '%s\n' "$MYPY_FILES" | attrib_staged_hits "$STAGED_LIST")
        if [ -n "$MYPY_BLOCK" ]; then
          echo "✗ mypy 错误落在 staged 文件（提交被拦）:"
          printf '    %s\n' $MYPY_BLOCK
          exit 1
        fi
        echo "⚠ mypy 错误全部落在未暂存文件（他人改动，本次不拦；对方后继自理）:"
        printf '    %s\n' $MYPY_FILES
        echo "  （nn-python-gate 其余失败项均未落在 staged 文件上——放行）"
      else
        echo "✗ nn-python-gate 失败且无法按文件归因（保守拦截）——见上方日志"
        exit 1
      fi
    fi
  fi
fi

# ---------- dashboard 门禁（独立 bun 项目；仅在 staged 含 dashboard/ 时跑） ----------
# dashboard/ 自带 package.json / bun.lock / node_modules，且**不在**根 tsconfig 与根
# 套件之内（DECISIONS §2026-09-14-goalnn-dashboard-project）。因此它必须有自己的
# 门禁块：否则「把 dashboard 切出根门禁」会静默降级为「没人跑 dashboard 门禁」。
# 归因语义与上方 mypy / 下方 tsc 块一致：报错前缀 dashboard/ 后与 staged 求交。
DASH_STAGED=$(grep '^dashboard/' "$STAGED_LIST" || true)
if [ -z "$DASH_STAGED" ]; then
  echo " ▸ dashboard gate skipped（staged 无 dashboard/ 改动）"
elif [ -n "$SKIP_DASHBOARD_GATE" ]; then
  echo "▸ skip dashboard gate (SKIP_DASHBOARD_GATE set——请确保失败已归因并汇报)"
else
  DASH_N=$(printf '%s\n' "$DASH_STAGED" | wc -l | tr -d ' ')
  if [ -d "$TOP/dashboard/node_modules" ]; then
    echo " ▸ dashboard gate（独立项目，$DASH_N staged 文件）"
  else
    echo " ▸ dashboard gate（独立项目，$DASH_N staged 文件）"
    echo "   ⚠ dashboard/node_modules 缺失——先 cd dashboard && bun install（其依赖不再来自仓库根）"
  fi

  DASH_TSC_RC=0
  ( cd "$TOP/dashboard" && "$BUN" run typecheck ) > "$DASH_TSC_LOG" 2>&1 || DASH_TSC_RC=$?
  if [ "$DASH_TSC_RC" -ne 0 ]; then
    cat "$DASH_TSC_LOG"
    DASH_TSC_TOTAL=$(grep -cE ': error TS[0-9]+:' "$DASH_TSC_LOG" || true)
    if [ "$DASH_TSC_TOTAL" -eq 0 ]; then
      echo "✗ dashboard typecheck 失败但无 TS 错误行（无法归因，保守拦截）"
      exit 1
    fi
    DASH_TS_FILES=$(attrib_tsc "$DASH_TSC_LOG" | sed 's|^|dashboard/|' | sort -u)
    DASH_TSC_BLOCK=$(printf '%s\n' "$DASH_TS_FILES" | attrib_staged_hits "$STAGED_LIST")
    if [ -n "$DASH_TSC_BLOCK" ]; then
      echo "✗ dashboard tsc 错误落在 staged 文件（提交被拦）:"
      printf '    %s\n' $DASH_TSC_BLOCK
      exit 1
    fi
    echo "⚠ dashboard tsc 错误全部落在未暂存/未跟踪文件（他人改动，本次不拦；对方后继自理）:"
    printf '    %s\n' $DASH_TS_FILES
  fi

  if ! ( cd "$TOP/dashboard" && "$BUN" run test ); then
    echo "✗ dashboard bun test 红——按多 agent 协作语义判定归因后重试："
    echo "   · 失败由你 staged 的改动造成 → 修复后重新 commit；"
    echo "   · 失败源自他人未暂存改动 → 汇报对方，并以 SKIP_DASHBOARD_GATE=1 重试本次 commit。"
    exit 1
  fi
fi

# ---------- typecheck（tsc 全量；报错按文件归因；无根 TS 时跳过） ----------
if [ -z "$ROOT_TS_STAGED" ]; then
  echo " ▸ typecheck skipped（staged 无根项目 TS/JS——dashboard/ 与纯 md/nn-training 不触发）"
elif [ -n "$SKIP_TSC" ]; then
  echo "▸ skip typecheck (SKIP_TSC set)"
else
  echo " ▸ typecheck (tsc --noEmit) — 报错按文件归因，staged 才拦"
  TSC_RC=0
  "$BUN" run typecheck > "$TSC_LOG" 2>&1 || TSC_RC=$?
  cat "$TSC_LOG"
  if [ "$TSC_RC" -ne 0 ]; then
    TSC_TOTAL=$(grep -cE ': error TS[0-9]+:' "$TSC_LOG" || true)
    if [ "$TSC_TOTAL" -eq 0 ]; then
      echo "✗ typecheck 失败但无 TS 错误行（无法归因，保守拦截）——见上方日志"
      exit 1
    fi
    TSC_FILES=$(attrib_tsc "$TSC_LOG")
    TSC_BLOCK=$(printf '%s\n' "$TSC_FILES" | attrib_staged_hits "$STAGED_LIST")
    if [ -n "$TSC_BLOCK" ]; then
      echo "✗ tsc 错误落在 staged 文件（提交被拦）:"
      printf '    %s\n' $TSC_BLOCK
      exit 1
    fi
    echo "⚠ tsc 错误全部落在未暂存/未跟踪文件（他人改动，本次不拦；对方后继自理）:"
    printf '    %s\n' $TSC_FILES
  fi
fi

# ---------- tests（bun scoped；红走因果判定；无根 TS 时跳过） ----------
if [ -z "$ROOT_TS_STAGED" ]; then
  echo " ▸ tests skipped（staged 无根项目 TS/JS——不触发根 bun test）"
elif [ -n "$SKIP_BUN_TEST" ]; then
  echo "▸ skip bun test (SKIP_BUN_TEST set——请确保失败已归因并汇报)"
else
  echo " ▸ tests (bun run test — scoped to local changes)"
  if ! "$BUN" run test; then
    echo "✗ bun test 红——按多 agent 协作语义判定归因后重试："
    echo "   · 失败由你 staged 的改动造成 → 修复后重新 commit；"
    echo "   · 失败源自他人未暂存改动 → 汇报对方，并以 SKIP_BUN_TEST=1 重试本次 commit。"
    exit 1
  fi
fi

# ---------- format（oxfmt 逐 staged 文件；MM 文件跳过防折叠） ----------
STAGED_TS=$(grep -E '\.(ts|js|mjs|cjs|tsx|jsx)$' "$STAGED_LIST" || true)
if [ -n "$STAGED_TS" ]; then
  echo " ▸ format (oxfmt, staged 逐文件；另有未暂存改动的文件跳过)"
  for f in $STAGED_TS; do
    if [ ! -f "$f" ]; then
      echo "   ⚠ 跳过 $f（staged 删除/改名源——oxfmt/git add 对不存在的工作树文件会 fatal）"
      continue
    fi
    if grep -Fxq "$f" "$DIRTY_LIST"; then
      echo "   ⚠ 跳过 $f（MM：另有未暂存改动——格式化工作树内容会把未暂存编辑折进提交）；请自行格式化后 git add"
    else
      "$BUN" x oxfmt "$f" >/dev/null 2>&1 || true
      git add -- "$f"
    fi
  done
fi

# ---------- lint（oxlint，staged 文件——红即拦） ----------
# 只喂 oxlint 真正会解析的扩展名（TS/JS 系）。早期版本把 .json 也列进 grep，
# 而 oxlint 不 lint json → 传进去得到 "No files found to lint" + exit 1，
# 于是「只改 md/jsonc/json/ipynb 的提交」被这个假红拦下（2026-09-08 实测）。
STAGED_LINT=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|mjs|cjs|tsx|jsx)$' || true)
if [ -n "$STAGED_LINT" ]; then
  echo " ▸ lint (oxlint, staged TS/JS)"
  if ! echo "$STAGED_LINT" | tr '\n' '\0' | xargs -0 -r "$BUN" x oxlint; then
    echo "✗ oxlint 红——修复后重新 commit"
    exit 1
  fi
fi

# ---------- freeze gate（det signature vs golden — DECISIONS §272） ----------
# FREEZE_STAGED 已排除 dashboard/（见上）：dashboard TS 与纯 md/nn-training
# 改不动 det 签名。成本实测 ~3.7s（21 组合，16 核 Linux，2026-09-15），下面自报 elapsed
# ——不要在任何注释/文档里写死这个数字，它已经错过一次（~100s，差 27×）。
if [ -z "$FREEZE_STAGED" ]; then
  echo " ▸ freeze gate skipped（staged 无根项目 TS/游戏代码——det 签名不可能受本次提交影响）"
else
  echo " ▸ freeze gate (det signature vs golden — DECISIONS §272)"
  _FZ0=$(date +%s%N 2>/dev/null || true)
  case "$_FZ0" in '' | *N*) _FZ0='' ;; esac
  bash tools/probe-det-baseline.sh --golden </dev/null
  if [ -n "$_FZ0" ]; then
    echo "   ✔ freeze gate $(( ($(date +%s%N) - _FZ0) / 1000000 ))ms"
  fi
fi

# ---------- 并发提示：门禁期间暂存区是否被他人追加 ----------
if [ "$STAGED_N" -gt 0 ]; then
  NEW_STAGED=$(git diff --cached --name-only | grep -Fvx -f "$STAGED_LIST" || true)
  if [ -n "$NEW_STAGED" ]; then
    echo "⚠ 门禁期间暂存区新增文件（将随本次提交入库但未经本次门禁判定）——建议立即重新 commit:"
    printf '    %s\n' $NEW_STAGED
  fi
fi

echo "✓ All pre-commit checks passed."
