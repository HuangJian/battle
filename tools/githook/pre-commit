#!/bin/sh
# Pre-commit hook: enforce typecheck, tests, formatting, and linting before a commit lands.
#
# Activated by:  git config core.hooksPath .githooks   (see `bun run setup`)
#
# Runs under Git's bundled `sh` on every platform (Linux shell, Windows Git Bash, and
# Windows PowerShell 7 / pwsh), so it is shell-agnostic. The only external dependency is `bun`,
# which we locate robustly below so the hook works no matter which shell triggered the commit.

# Abort on the first failing command.
set -e

# --- Locate `bun` even if it is not yet on PATH ---------------------------------
# Coding agents may commit from a Linux shell, Windows Git Bash, or Windows PowerShell 7 (pwsh),
# each with a slightly different PATH. Augment PATH with the common bun install dirs so
# the hook resolves `bun` regardless of the calling environment.
add_to_path() {
  [ -z "$1" ] && return 0
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

if ! command -v bun >/dev/null 2>&1; then
  # npm global bin (where `npm i -g bun` installs)
  if command -v npm >/dev/null 2>&1; then
    NPM_GLOBAL=$(npm bin -g 2>/dev/null) || NPM_GLOBAL=$(npm prefix -g 2>/dev/null)
    add_to_path "$NPM_GLOBAL"
    add_to_path "$NPM_GLOBAL/bin"
  fi
  # bun's own installer location (all platforms)
  add_to_path "$HOME/.bun/bin"
  # Windows npm global lives under %APPDATA%\Roaming\npm
  if [ -n "$APPDATA" ]; then
    APPDIR=$(printf '%s' "$APPDATA" | tr '\\' '/' | tr '[:upper:]' '[:lower:]')
    APPDIR=$(printf '%s' "$APPDIR" | sed -E 's|^([a-z]):/|/\1/|')
    add_to_path "$APPDIR/Roaming/npm"
  fi
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "✗ 'bun' was not found on PATH and could not be located in common install dirs."
  echo "  Install bun (https://bun.sh) or add it to PATH, then retry the commit."
  exit 1
fi

BUN=$(command -v bun)

echo "▶ Running pre-commit checks (bun: $BUN)..."

# --- 未暂存改动隔离（2026-09-06 用户指令）：门禁只判 staged 快照 --------------
# 门禁（tsc/bun test/nn-gate/freeze）天然针对工作树运行——工作树里未暂存的在途
# 改动（如改到一半的 TS）会把门禁打成红，而那些改动并不在本次提交里。此段在
# 门禁前把未暂存 diff 摘除（工作树 := 索引），门禁结束或失败后原样恢复：
#   - 禁用 git stash（AGENTS §5.8 沙箱事故）——等价机制用 diff/apply 文件级
#     操作实现，不触碰对象库；
#   - 恢复失败时补丁文件保留并响亮报错，绝不静默吞用户的在途改动；
#   - 未暂存改动不存在时零开销（不产生补丁、不做 apply）。
UNSTAGED_PATCH=""
hook_restore_unstaged() {
  if [ -n "$UNSTAGED_PATCH" ]; then
    if git apply --whitespace=nowarn "$UNSTAGED_PATCH" 2>/dev/null; then
      rm -f "$UNSTAGED_PATCH"
      UNSTAGED_PATCH=""
      echo " ▸ 未暂存改动已原样恢复（工作树回到门禁前状态）"
    else
      echo "!! 未暂存改动自动恢复失败——完整补丁保留在 $UNSTAGED_PATCH"
      echo "!! 请手动恢复: git apply \"$UNSTAGED_PATCH\"（恢复前先确认编辑器里没有会覆盖它的未保存修改）"
      exit 1
    fi
  fi
}
if [ -n "$(git diff --name-only)" ]; then
  mkdir -p tmp
  UNSTAGED_PATCH="tmp/pre-commit-unstaged-$$.patch"
  if git diff --binary > "$UNSTAGED_PATCH" && git apply --reverse --whitespace=nowarn "$UNSTAGED_PATCH"; then
    echo " ▸ 未暂存改动已临时摘除——门禁只判 staged 快照；提交结束自动恢复"
  else
    echo "!! 未暂存改动摘除失败——本次门禁按工作树现状运行（不做隔离）"
    rm -f "$UNSTAGED_PATCH"
    UNSTAGED_PATCH=""
  fi
fi
trap 'hook_restore_unstaged' EXIT

# --- nn-training Python gate (2026-09-02) --------------------------------------
# When the staged changes touch nn-training/, run the FULL Python quality gate
# (ruff + mypy + pytest 4-shard, all parallel — 实现见 nn-python-gate.sh，与日常
# 开发共用同一入口，避免 hook/日常门禁漂移)。跳过方式：
#   SKIP_NN_TRAINING_GATE=1 git commit ...   # 仅跳过 Python 门禁
#   git commit --no-verify ...               # 跳过全部门禁
NN_STAGED=$(git diff --cached --name-only | grep '^nn-training/' || true)
if [ -n "$NN_STAGED" ]; then
  if [ -n "$SKIP_NN_TRAINING_GATE" ]; then
    echo "▸ skip nn-training python gate (SKIP_NN_TRAINING_GATE set)"
  else
    echo "▶ nn-training python gate ($(printf '%s\n' "$NN_STAGED" | wc -l | tr -d ' ') staged file(s))..."
    sh "$(git rev-parse --show-toplevel)/tools/githook/nn-python-gate.sh" 4 || exit 1
  fi
fi

echo " ▸ typecheck (tsc --noEmit)"
"$BUN" run typecheck

echo " ▸ tests (bun run test — scoped to local changes)"
# Uses `bun run test`, which is aliased to the scoped silent runner
# (tools/test-silent.ts). It runs only the tests related to the staged/working
# changes (and prints only failure logs) for a fast commit gate. Falls back to
# the fast suite when nothing maps (excluding heavy gate/integration sims such as
# the God-AI gates and calibration — those still run via `bun test` / `--heavy`).
# Re-run `bun test` before committing a God-AI change to validate the gate floors.
"$BUN" run test

echo " ▸ format (oxfmt, staged only)"
# 只 format 已 staged 的文件，不改动未 stage 的修改。
# 从 git diff --cached --name-only 获取 staged 文件列表，筛选 .ts/.js/.mjs 等
# oxfmt 可处理的类型，逐个 format 后重新 stage。
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|mjs|cjs|tsx|jsx|json)$' || true)
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | tr '\n' '\0' | xargs -0 "$BUN" x oxfmt
  git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|mjs|cjs|tsx|jsx|json)$' | tr '\n' '\0' | xargs -0 git add
fi

echo " ▸ lint (oxlint, staged only)"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|mjs|cjs|tsx|jsx|json)$' || true)
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | tr '\n' '\0' | xargs -0 "$BUN" x oxlint
fi

echo " ▸ freeze gate (det signature vs golden — DECISIONS §272)"
# God AI v1 frozen-signature gate (~100s). A red gate is NOT an error per se:
# it means current behavior ≠ the frozen baseline. Either roll back, or run
# the new-era triple (new DECISIONS entry + 60-seed baseline re-run + golden
# update). See plan/God-AI-Organization.md §7 / docs/god-ai-tuning.progress.md Part 0.
bash tools/probe-det-baseline.sh --golden

echo "✓ All pre-commit checks passed."
