import uuid
import zipfile
from collections.abc import Callable, Iterator
from pathlib import Path
from typing import Any

# ── 交付面（S5 第十四刀）住兄弟文件 `remote/offline_deliverable.py` ────────────────────
# notebook 把它与 `offline_boot.py` / `tailscale_boot.py` 一起从 GitHub raw 拉进同一目录
# （名单见 `ipynb/battle.offline.ipynb` 引导格）；仓库/包内形态回落到
# `remote.offline_deliverable`。本模块顶层不得 import `remote.*`（standalone 守卫），
# 也不能在顶层 import 兄弟文件（仓库形态下没有那个顶层模块名）⇒ **延迟装载 + 门面转发**。
_DELIVERABLE_NAMES = (
    "requested_courses",
    "courses_of",
    "_split_course_names",
    "course_work_dir",
    # ★ 2026-10-14（`plan/offline-local-disk-first` §3.2）：两个根 + 恢复腿的原语住交付面模块
    # （standalone：产物根的判据与包名/三件名同源，不跨文件各写一份）。
    "net_root",
    "net_artifacts_dir",
    "local_root_path",
    "resolve_local_root",
    "artifact_need_bytes",
    "ARTIFACT_BYTES_PER_ROUND",
    "SEGMENT_ROUNDS_DEFAULT",
    "ARTIFACT_MIN_FREE_RATIO",
    "backup_ready",
    "install_backup",
    "WEIGHTS_NAME",
    "OPT_TAR_NAME",
    "LOCAL_ROOT_ENV",
    "DEFAULT_LOCAL_PARENT",
    "LOCAL_ROOT_NAME",
    "BACKUP_DIR_NAME",
    "download_dir",
    "package_deliverable",
    "_partial_last_it",
    "package_partial",
    # ★ 2026-10-17（`plan/offline-backfeed-resilience` §5 / 期望 4）：一键打包待回传产物
    # （两态判据表）+ 包内元信息 `IMPORT_META.json`。notebook 底部那格从 `package_partial`
    # （只有一个包）改走它（整段 + 读数）。
    "package_pending",
    "deliver_meta",
    "deliver_pack_name",
    "write_deliver_zip",
    "ALL_ZIP",
    "LATEST_ZIP",
    "PARTIAL_CANDIDATES",
    "LATEST_ROW_NAME",
    "IT_PREFIX",
    "METRICS_NAME",
    "EVAL_LOG_NAME",
    "WEIGHTS_ALT_NAME",
    "IMPORT_META_NAME",
    "IMPORT_META_MAGIC",
    "_COURSE_NAME_RE",
)


def _load_deliverable() -> Any:
    """交付面模块：引导目录里的兄弟文件优先（与会话刚刷新的本模块同源），包内兜底。"""
    for _name in ("offline_deliverable", "remote.offline_deliverable"):
        try:
            return importlib.import_module(_name)
        except ImportError:
            continue
    raise ImportError(
        "找不到 offline_deliverable（notebook 拉取名单缺它？重新打开最新 notebook；"
        "或用任务包里的代码引导）"
    )


def _load_land_provider() -> Any:
    """整份供者模块（`remote/land_provider`）：引导目录里的兄弟文件优先，包内兜底。

    单独一个 loader（不复用 `_load_deliverable`）：它是**可选**依赖——老 notebook 的引导格
    没拉 `land_provider.py`，那时包装照打、权重是原件，只多一行响亮说明（绝不 ImportError）。
    """
    for _name in ("land_provider", "remote.land_provider"):
        try:
            return importlib.import_module(_name)
        except ImportError:
            continue
    raise ImportError(
        "找不到 land_provider（notebook 引导格没拉它？）—— 包内权重将是回传件"
    )


def package_pending_full(
    cfg: dict,
    log: Callable[[str], None],
    *,
    courses: list[str] | None = None,
    full_for: Callable[[Path, int], dict[str, Path]] | None = None,
) -> list[Path]:
    """一键打包待回传产物（**门面 + 整份注入**；真正的打包逻辑在交付面模块）。

    名字里的 `_full` 不是装饰：`package_pending` 本体（及其唯一定义）住在
    `offline_deliverable`（`test_offline_deliverable_split` 钉住「定义唯一」），本函数只把
    **整份提供者**绑上去，再调它。

    为什么注入放在这里（2026-10-22，`plan/offline-full-weights-backup` §7-Q5）：落地器
    `remote/land_provider` 是 L2（它要 import L1 的 `weights_standard`/`opt_standard`），而交付面
    `offline_deliverable` 是 L0（被 `hub.store_offline` L1 直接 import）——在 L0 里 import 它
    就是向上边（`tests/test_remote_dag.py`）。本模块是 standalone 引导文件，**延迟 import 允许**。

    代价：这个 cell 是人点一下坐着等的 ⇒ 落地失败**连续 3 轮就停试**（`land_provider.MAX_FAILURES`），
    断链不会变成 O(n²) 的扫读等待；包照出、原件不丢。
    """
    if full_for is None:
        full_for = _landing_provider(cfg, log)
    packs: list[Path] = _load_deliverable().package_pending(
        cfg, log, courses=courses, full_for=full_for
    )
    return packs


def _landing_provider(cfg: dict, log: Callable[[str], None]) -> Any:
    """`cfg` → 整份提供者（blob 根从 `work_dir` 推；拿不到模块 ⇒ `None` = 旧行为）。"""
    try:
        land = _load_land_provider()
    except ImportError as e:
        log(f"[pack] {e}（包内权重是回传件：本机可解，换机需要基准）")
        return None
    work_dir = str(cfg.get("work_dir") or "").strip()
    return land.provider(
        blob_roots=land.blob_roots_of(work_dir) if work_dir else [], log=log
    )


def __getattr__(name: str) -> Any:
    """门面（PEP 562）：交付面的名字转发到 `_load_deliverable()`——名字是契约，位置不是。

    只转发 `_DELIVERABLE_NAMES` 闭集（其余名字照常 `AttributeError`，别把打错的属性喂给
    交付面）；要 patch 交付面的行为请打 `offline_deliverable.<名>`——门面只改副本（本仓纪律）。
    """
    if name in _DELIVERABLE_NAMES:
        return getattr(_load_deliverable(), name)
    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
