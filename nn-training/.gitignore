# ---- training artifacts (never committed) ----
shards/
checkpoints/
runs/
wandb/
*.npy
*.npz
*.json.bak

# ---- trained weights: versioned archives + active pointer (inside weights/, backed up to netdisk) ----
# WEIGHTS.md (the committed registry) lives in weights/ and is intentionally NOT ignored.
weights/weights.json
weights/weights.*.json

# ---- python ----
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# ---- distributed rollout（plan/distributed-rollout.md v3.3，含密钥严禁入库）----
rl-config.json
agent.auth
dist-agent-meta.jsonl

# ---- runtime / training artifacts ----
*.log
*.out.log
*.err.log
.train_loop.lock

# ---- python version pinning ----
# 反例必须提交：uv 靠它选默认解释器档（3.10），冷机器可复现（2026-09-04）
!.python-version

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
