  // ── 起点与缰绳（三档相同）────────────────────────────────────────────────
  "dodge": "",
  "bc": "nn-training/weights/g11-ringkill/g11-ringkill.it580.20261123-065722.json",
  // 缰绳**保持 true**（与 g7-def 同形）：ref = it120 本身。与 g9-demo 的唯一差别是
  // `decay 0.5 → 0.99`（0.5 = 每轮减半，头 5 轮就形同没有；见 g9-demo 结课报告 ④）。
  // 运行期判据：第一轮到最后一轮 `kickstart` 都应非 0；中途掉到 0 = 缰绳又断了。
  "kickstart_ref": true,
  "kickstart_init": 0.1,
  "kickstart_decay": 0.99,
  "warmup_iters": 0,
  "value_anchor": 0.001,

  // ── 本课**没有 demo 项**（纯 RL）────────────────────────────────────────
  //   `demo_bank` / `demo_bc_coef` / `demo_per_mb` 三键**整块删除**：g9-demo 已证
  //   逐帧 move-CE 在这个状态集上**不含胜负信息**（守住 60.2% vs 被拆 60.5%，§160 补二），
  //   而它唯一的可测效应是把 move 头整体拉偏（前场 down +46%，§160 补一）。
  //   所以本课**不碰策略形状**，只加结果量的罚（见 reward 第 2 行）。
  //   ⚠ 若以后要复检 demo 项，必须新开课（同课改这三键 = 换实验，账本会串）。

  // ── 预算与优化器（与 g9-demo / g7-def **同形状**：1.2e-4 / 4 epoch / mb 1024）──
  //   ⚠ 这是**新腿**（起点 = `g7-def.it120` 的权重副本，自己的账本从 it1 开始），
  //     不是续跑 ⇒ 没有"改大 iters 续跑"那套历史，iters 500 就是本课的全部预算。
  //     （要延长只能停→开改 iters，且 `out`/`traj` 一个都不许动，否则从 it1 重跑。）
  //   ⚠ 与 g7 系列另一课**必须同步**：两课靠轮替 rollout/PPO 填满算力（MEMORY.md 硬规则），
  //     预算/形状不一致 ⇒ 相位错开、轮替失效。
  "iters": 300,
  "max_hours": 48.0,
  "lr": 0.00012,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  // ★ 本课**唯一**的处理变量（2026-11-23，立课依据见文件头）：
  //   GAE λ 0.95 → 0.999 ⇒ 演员的有效视界 1/(1-γλ) 从 **19 拍** 拉到 **334 拍**；
  //   而 critic 的视界一直由 γ 决定（1/(1-0.998) = 500 拍）⇒ 本次修的是**演员/评论家的
  //   视界缺口**，不是奖励。要 A/B 就把这行改回 0.95 重开一课，别在本课里改。
  "lam": 0.999,
  "ppo_schedule": [{ "kl_coef": 0.02, "lr": 0.00012, "kl_cap": 0.1 }],

  // ── 采样量 ───────────────────────────────────────────────────────────────
  // 24576 = 与在跑课同形状（双课并行要相位互补，见 MEMORY.md「多课并行的算力经济学」）。
  // ⚠ **`autonomous_cloud_overrides` 已删**（2026-11-19 21:1x 用户口径）⇒ GPU / TPU 云机上
  //   **不再自动放大采样量**（原来 gpu 档 49152 / tpu 档 215040），全档一律按本行 24576 跑。
  //   要恢复分档必须**两课同改**，否则形状不一致、轮替失效。
  "target_transitions": 24576,
  "paired_rotate_seed": 20261118,

  // ── 决策门 ───────────────────────────────────────────────────────────────
  "decision_events": false,
  "decision_k": 10,

  // ── 开局接管（撤回早前的"空操作"结论）────────────────────────────────────
  // 2026-11-19 21:3x 实测纠正：
  //   ① **它不是空操作**。`evaluateCorridor` 判定 classic35 有 **13/35 关是口袋阵**
  //      （2001/2003/2004/2007/2012/2014/**2020 Checkers**/2021/2024/2025/2028/2029/2033），
  //      这些关 `connected=false` ⇒ 按设计**会**触发 OpeningController 接管。另 22 关是 hug/lower 连通，
  //      那 22 关确实不接管（条件接管臂）—— 这是"逐关看才准"的事，不是全局开关。
  //   ② 单局直调（`export-eval-game.ts --opening-connect`）在 S2020 上差异巨大：
  //      seed 2000000001 首杀 2069→**965** 拍、ticks 4287→**3473**、cellsVisited 104→127。
  //   ③ **但 `eval-course-ckpt` 分布式路径实测无差异**：S2020 单关 20 种子 0/20 不同，
  //      全盘 700 局 0/700 不同。**根因两条（2026-11-19 21:5x 定位并已修）**：
  //        · 本机长驻池：`serve_pool` 的 worker 旗标在**启动时**固定，后续任务的
  //          `--opening-connect` 被吞 ⇒ 同批串味（17/20 不同、3 局一模一样）。
  //          修：`worker/eval_local.py` 在 `opening_connect` 或 `EVAL_POOL_DISABLE=1` 时绕过池。
  //        · 远端 agent **无条件**套 controller（源码看着正确，疑似节点跑旧构建）。
  //          修：`tools/sim/eval-course-ckpt.ts` 对带 flag 的批次**禁派远端**（noNodes、
  //          不给 localSlots），并对"不带 flag 却用远端"发显式告警。
  //      ⇒ 修复后本机双臂 **20/20 逐局不同**（bare 4287 / oc 3473，与单局直调吻合）。
  //   ④ ⚠ 训练 rollout **是**带这个 flag 的（`trainer/dispatch.py:776` 透传、
  //      课程 `opening_connect` 在 `flat_overrides` 里）⇒ **训练与我这套评估口径不一致**。
  //      含义：本课的历史基线（37.00%）是在 13 个口袋关上"无辅助"跑出来的，偏悲观。
  //   本课两侧同口径（都带 true），所以**两课之间的比较不受影响**；受影响的是与部署口径的绝对对比。
  "opening_connect": true,

  // ── 产物路径（新实验 ⇒ 新目录，禁与 g5 系续跑）──────────────────────────
  "out": "tmp/g11b-horizon/weights.json",
  "traj": "tmp/g11b-horizon",
  "backup_dir": "nn-training/weights/g11b-horizon",
  "backup_prefix": "g11b-horizon",

  // ── 过程熔断 ─────────────────────────────────────────────────────────────
  "breakers_off": true,
  "ent_break": 0.25,
  "ent_break_consec": 8,
  "ent_break_max_winrate": 0.0,

  // ── 评估网格（与 g5 系同 seed ⇒ 可逐局配对）──────────────────────────────
  "eval_stages": "2000-2034",
  "eval_games_per_stage": 20,
  "eval_every": 10,
}

// ═══════════════════════════════════════════════════════════════════════════
// 结课报告（2026-11-23 17:0x；跑到 it147，**判负**——λ 视界假设被证伪）
// ═══════════════════════════════════════════════════════════════════════════
// ① 训练账：`run_start` 09:2x → it1 → **it147 14:34:44**（147 条 `iteration`）。
//    15 个 eval 点（it0 + it10..140，每点 700 局 = 10,500 局）。
//    PPO 更新量 = **24,576 steps/轮**（24 chunks × mb 1024）；`samples` 均值 **39,114/轮**
//    （补波过冲，不是 batch；横比训练量用 steps）。
//    停因**不是门限**：14:34 之后 it148 的 PPO job 无人认领（零 worker）；控制台现
//    `paused`（rounds_done 147 / next_it 148）。**没跑满 300，也没到 it150 决策点。**
//    ⚠ it0 是 **reuse**：`reusedFrom=g11-ringkill`、700/700，wver `0b58484a…`，
//    即 `g11-ringkill.it580` 的 eval 行（06:59 生成；本课 09:36:45 复制）。
//    语义上就是起点权重，但**不是本课新跑**；it140 的 wver 是 `193a25a5…`。
//    两腿同源 ⇒ 配对不受影响；绝对水平（39.71%）按"旧行起点"读，别写成"新包复测"。
//
// ② 判据逐条（同池逐局配对；起点 it0 = 39.71%）
//    主判 it150 Δwin ≥ +3pp      ⇒ **未到 it150**；it140 只有 **+1.86pp**
//                                   （配对 SE 2.45pp、t=0.76）；全段池化 **−0.30±0.61pp**
//    主判 A 任一点 ≥44.4%        ⇒ 最高 **41.6%（it60）**；ctrl 最高 43.6%（it10）
//    主判 B it150 ≥43.7%         ⇒ it140 **37.4%**（−2.3pp vs 起点）
//    行为① 0 死丢家 <30%         ⇒ **42.9% → 45.2%**（分母=全部败局）
//                                   （分母=基地被拆：47.5% → 50.5%；两个口径都更差）
//    行为② 败局 kills 中位 ≥11    ⇒ **9 → 8**（末段；ctrl 9）
//    行为③ DA 中位 ≤12           ⇒ **16 → 17**（`thCostDirectAimed`，毁局中位）
//    ⇒ **全灭**；没有一条行为判据朝目标动。
//
// ③ 病灶没被碰到，反而略恶化
//    0 死丢家局（it0，分母=基地被拆，n=180）：承伤均值 116.4、被弹命中中位 **0**、
//    击杀中位 **5**、首杀中位 **945.5**、访问格 63.5 ⇒ "不交战、基地被磨穿"。
//    末段（it100-140，n=952）：承伤 108.9、命中中位 0、击杀中位 **4**、首杀 940、
//    访问格 66 —— 击杀还少了一个；环拦截 21.9% → 20.6%。
//    胜局拍 6443 → 6256（−2.9%）；k/千 2.41（护栏 ≥2.4，贴线过）。
//
// ④ 胜率：唯一"相对正"的读数，但只是斜率，不是水平
//    面板斜率：本课 **+0.50pp/100it（全段）/ +0.72（it10+）**；
//    ctrl **−1.37 / −1.68** ⇒ λ 把"续跑下坡"扳成了"微升"。
//    但水平没赢：全段均值 **39.4%**（ctrl 39.7%）、末 5 点 39.6%（ctrl 38.8%）、
//    it140 37.4%；max 41.6（it60）距 44.4 还差 2.8pp。
//    配对池化 −0.30pp（t=−0.48）⇒ **不能写"λ 提升了胜率"**，只能写"λ 改变了斜率"。
//
// ⑤ 训练侧：机制确实生效，但没有转成行为
//    窗口（1-20 / 21-60 / 61-100 / 101-147）：
//      kl 中位 0.0087 / 0.0102 / 0.0106 / 0.0091（ctrl 0.0052 / 0.0053 / 0.0049 / 0.0047）
//      ent      0.518 / 0.516 / 0.511 / 0.521（ctrl 0.512 / 0.516 / 0.521 / 0.515）
//      value    0.75 / 0.73 / 0.71 / 0.70（ctrl 0.47 / 0.47 / 0.48 / 0.49）
//      KLtoRef  0.033 / 0.066 / 0.104 / 0.130（ctrl 0.017 / 0.028 / 0.033 / 0.041）
//      rollout 胜率 24.7 / 25.1 / 24.9 / 24.3（ctrl 24.9 / 25.8 / 26.3 / 26.1）
//      halted 0；kl≤0.02、ent≥0.35 全过。
//    ⇒ 演员确实离参考更远（KLtoRef 3.2×）、价值头更难拟合（0.70 vs 0.49），
//      但 eval 行为没动。"视界缺口"不是 40% 天花板的约束。
//
// ⑥ 护栏与分关
//    k/千 2.41 ✓（ctrl 2.34 ✗，贴线破）；胜拍 6256（−2.9%）✓；kl / entropy ✓。
//    分关（it100-140 池化）17 正 / 14 负 / 4 零：
//      S2008 +16pp、S2015 +10pp、S2028 −10pp、S2016 −11pp ⇒ 不是单关事故，
//      但也不是全盘抬升（正负几乎对半）。
//
// ⑦ 程序问题（比读数值钱）
//    1. **it80 判死条款两份文件措辞不一致**：本课写"0 死与 DA 都没动"，ctrl 写
//       "|Δwin|<1pp 且三项行为差全<5%"。it80 实际 Δwin **−4.86pp**、0 死差 −7.9pp
//       ⇒ 按 ctrl 版本**没有触发**；按本课版本可判"没动"（0 死 −3.8pp、DA +1，
//       都在单点噪声内）。两腿继续跑到 147/146，停因是零 worker，不是门限。
//       **下一课把判死写成可执行谓词**（机器可判、控制台一行检查），别再靠措辞。
//    2. **it150 决策点没到**：结论建立在 it0-140（15 点 × 700 局）。好在 it140 的
//       Δ 只有 +1.86pp（t=0.76）、44.4% 从未接近，判负不受"没到 it150"影响。
//    3. **0 死占比两个分母**：预注册写 42.9%（全部败局 181/422）；按"丢家"=基地被拆
//       算是 47.5%（180/379）。本报告两个都列；下一课必须在课程文件里写死分母。
//    4. **DA 字段陷阱**：eval 行的 `thDirectAimed` 是瞬时值（中位 1），累计量是
//       `thCostDirectAimed`（起点 16）。`tmp/g11b-analyze2.mjs` 用错字段会打出 DA=1；
//       复跑请用 `tmp/g11b-close.mjs`。
//    5. **it0 跨 wver reuse**：见 ①；与 `g11-ringkill` 结课报告 ⑤-1 是同一类问题。
//
// ⑧ 判语：**判负**。λ 0.999 确实把演员视界从 19 拍拉到 334 拍（训练侧 KLtoRef 0.130
//    vs 0.041、kl 翻倍），但**没有换来任何目标指标**：胜率水平未过起点（39.4% vs
//    39.7%）、0 死占比更差（45.2% vs 42.9%）、DA 17（目标 ≤12）、败局击杀 8（目标
//    ≥11）。视界不是约束；**不要再加 λ、不要再加价**。
//    ⚠ 本报告只改注释、无键变化 ⇒ 训练参数一个字节没动，但 `course_fp`（文件 sha256）
//    仍变。本课已停、不再 resume；要重开同形腿请新建 `g12-*`。
//
// ⑨ 后继（按证据排序）
//    1. **停课、不补 300**：it140 的 Δ 与三项行为全部指向"没学到"；再跑 160 轮
//       没有预注册理由。
//    2. **不要再抬 λ**（0.9995/1.0）：本次已把 KL 拉到 2×、value 0.70；再抬只会
//       让优势变成 MC、方差更大。机制不是瓶颈。
//    3. **下一课 = `plan/g12-corpus-weight.plan.md`**：按状态谓词给
//       "t≥1200 且 0 死 0 伤 0 杀"的决策步行权；不改起点、不按结局筛、不加价。
//       它治的是"该状态在梯度里太稀"，与本次证伪的"信用视界"正交。
//    4. 若行权也无效 ⇒ 才上**自产快照银行**（从中局起跑），仍不动任务侧。
// 产物：`tmp/g11b-horizon/`（training_log 147 轮 / eval_log 15 点 × 700 局 /
//   weights.json）；分析脚本 `tmp/g11b-close.mjs`（DA 用 `thCostDirectAimed`）。
