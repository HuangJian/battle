// 课程 h5-stop —— **新纪元第 5 课：x5 rung（ladder-c05，单关），STOP-only**（plan §7）
//
// 状态：**草稿，待用户手工开训**（agent 不得启动训练）。
//
// 立项：梯子第五 rung（单关 20 敌，见 transfer 探针：h4-it60 零射 56.5%/162/零伤13.5%）。
//   B 案 STOP 语义沿用；**均匀 K=10**（事件 rung 另开 h5e，待接线落地；本文件不掺变量）；
//   flat critic（解耦 rung 条件未到）。
//
// 配方（= x1-a2 v4 包逐字）：
//   wKill 3.0 / wHit 0.6 / wWin 2.0 / wDmg 0.03 / wShot 0.05 / **wExplore 0.2**
//   + terminal lives_exhausted −5.0 / timeout −2.0。
//   （wExplore 衰减表：x20 rung 归零；h5 保留，h4b 结论是"无增益非必须杀"，不是"必须杀"。）
// 位移包：lr 0.0005 / epochs 6 / mb 512 / kl 0.02（25 轮）→0.01（x4-rebirth 同形）。
//
// 起点：h4 冠军 warm start，`kickstart_ref=true`（梯子链 kk=true 绿过 h1→h4；C 事故是同任务续命，另案）。
//   ⚠ `bc` 下面的占位必须在开课前换成 h4 冠军实际文件名，否则拒启。
//   comparator = 本 rung 绝对门 + 自身趋势（跨 rung/跨纪元不配对）。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据（x5 rung 绝对数门，2026-09-27 已 pin；脚注：h4-it60 零射 56.5%/162/零伤13.5%，
//   门要求 +24pp win、dmg 腰斩、零伤×2.5；200 局分母 SE≈3.5pp，留余量。不达标按横盘停，不判死。）
// ══════════════════════════════════════════════════════════════════════════
// **门**：日常段（860001，单关 200 局）`pass ≥ 80%` 且 `dmg/局 ≤ 80` 且 `零伤通关 ≥ 35%`。
// **机制链**：① stopPickRate（侧车计数）② threat/clean ③ pass/dmg 跟随。
// **约束**：超时 >5% ⇒ 人工决策停；kl 连续 3 轮 ≥0.075 ⇒ 记录 + 人工盯盘；
//   ent 跌破 0.25 ⇒ break；掉队不适用（单关）。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行）
// ══════════════════════════════════════════════════════════════════════════
//   · **专属死刑**：stopPickRate 连续 3 个 eval 点 < 10/千tick（前置：探针链通；梯子豁免——
//     只观测不执行，见 h3 实证）⇒ 记录，不停腿（rung 豁免；c20 rung 重开此条）。
//   · **对称死刑**：stopPickRate 连续 3 点高于人类基线上四分位 ⇒ 停腿 ⇒ B0。
//   · **机械横盘**：pass/dmg 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮，不得二次宽限。
//   · B1/B3/B4 按 plan §8。

{
  "version": 5,
  "name": "h5-stop",
  "mode": "per-tick",
  // 环境：ladder-c05（单关 20 敌）。任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c05",

  // ── 奖励：x1-a2 v4 包逐字 ──────────────────────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits + wWin*where(clearTick>=0, 1, 0) - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wWin": 2.0,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.2
    },
    "terminal": {
      "lives_exhausted": -5.0,
      "timeout": -2.0
    },
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：h4 冠军 warm start（占位，开课前必换真实文件，否则拒启）─────────
  "bc": "nn-training/weights/h4-stop-best/h4-stop.it60.best.json",
  "kickstart_ref": true,
  "warmup_iters": 0,

  // ── 预算（x4 同形：150 轮 / 12h， artifact 化）────────────────────────────
  "iters": 150,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包 ─────────────────────────────────────────────────────────────
  "lr": 0.0005,
  "epochs": 6,
  "mb": 512,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "until_iter": 25, "kl_coef": 0.02, "lr": 0.0005, "kl_cap": 0.2 },
    { "kl_coef": 0.01, "lr": 0.00025 }
  ],

  // ── 采集 ───────────────────────────────────────────────────────────────
  "target_transitions": 24000,
  "est_samples_per_game": 180,
  "seed_rotate": 600,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/h5-stop/weights.json",
  "traj": "tmp/h5-stop",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/h5-stop",
  "backup_prefix": "h5-stop",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2000",
  "eval_games_per_stage": 200,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① h4 冠军已归档（h4-stop.it60.best.json，存在性已验，见下验证行）。
// ② 公式编译验证（validate_reward；与 v4 逐字同是正确原因）。
// ③ 新 out/traj 目录（禁续跑）。④ 节点心跳（self/mac/a96；远端全灭则本机慢 10x）。
// ⑤ paired-kill 默认关（opt-in）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台开课）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it0/it5…（860001 段，单关 200 局）pass/dmg/stopPickRate（侧车）/cells。
// · transfer 探针：`tmp/h4xfer/h5.jsonl`（h4-it60 零射 56.5%/162/13.5%，200 局）。
// · 事件 rung（h5e）：待接线落地后另开课程，不进本文件。
//
// ── 结算节（跑完回填）──────────────────────────────────────────────────────
// 必填：① pass/dmg it0 → 终点 ② stopPickRate ③ 超时/换血
//   ④ 实际轮数与耗时 ⑤ 判语（过门⇒ h6/c20 rung；idle 平＋门远 ⇒ B2（事件 rung 届时应已就绪）；
//   停太多 ⇒ B0；横盘 ⇒ 停）。
