// 课程 x24-stack —— 三方向叠加腿：fore 价 + 近敌税 + 距离加压 + 被挡税，一起上争胜率。
//   起点 fore-it195（冻结最强点）。
//
// 状态：草稿（2026-10-09 冻结；未开课）。本腿今日可跑（全用既有日常列）。
//   开课 = 人在控制台点（agent 不开训）。
//   立项 → 用户 2026-10-09 直接指定：fore 继续跑 + fore 最优点做 bc +
//   在 fore 基础上叠 face 和 move 的机制，三方向一起上争胜率，不拆归因。
//   bc 选点依据（冻结 800 对，同批配对 vs KR10-it150）：414400 段 it80 +6.38pp /
//   it120 +6.12pp / it195 +9.12pp（p≈0.0002，kills +1.5）；414600 段 it105 +6.62pp /
//   it125 +7.50pp（p≈0.002）/ it150 +5.75pp / it180 +1.38pp（ns，晚段衰减）。
//   七点六胜，bc 取最强 fore-it195（sha 见下）。
//   纪律声明（冻死，用户原话“不需要说清谁占大头”）：本腿放弃项内归因；face 门没过
//   （near4 −6.5%）、move 出过替代行为（corner +37%）两条前科一并记入，赢了是包的功劳，
//   输了先查 move 式绕路（adv2-max bundle 无 verdict 前例）。单变量纪律在本腿 waive。
//   基线 → 双基线：bc fore-it195（冻结 0.4525/13.454，414400 段）为主判；KR10-it150
//   （0.3738/12.239，1600 对）为参照。日常 killEV 按 fore-it195 实测 kills≈13.45 计 ≈40.4。
//   起点 fore-it195 + 下述加价（下）。
//
// ── 定价（f 以 killEV≈40.4 计；在 fore 价 threatening-60/corner-40 之上再加三项）─
//   fore 底价（继承）：wThreat=60（threat −16% 已验证）· wCorner=40（corner −30% 已验证）。
//   近敌 -wNear×nearEnemy4Ticks/(ticks+1)（face 项；fore-it195 率 0.4997，人类 0.245，2 倍 gap），
//   wNear=8.0 → −4.0/局（10%）。
//   距离 wDist 0.738 → 1.3（face 项；fore-it195 打中均值 3.014，人类 Edhit 4.3995），
//   inflow +1.7/局（+4%；合计 f 14%）。
//   被挡 -wBlock×(idleTicks−stopTicks)/(ticks+1)（move 项；fore-it195 率 0.0358，
//   人类 0.0071，5 倍 gap——全场相对 gap 最大），wBlock=110.0 → −3.9/局（10%）。
//   订正（起草同日）：初稿 wBlock=150 是拿 panel 率（0.026）算的账——错口径；日常行率 0.0358
//   下 150 给出 −5.4/局（14%，超标），按 f=10% 初衷改回 110（frozen 的是 f 不是数）。
//   新增合计（相对 fore 价）≈ −6.2/局净（−15%）。degeneracy 旗：move 前科（蹲角替代）+
//   face 前科（近战杀伤区误伤）+ 远射 camp 三风险——全由人工盯盘覆盖（下）。
//
// ── 人类语料核对（2026-10-09；fore-it195 日常 n=400 vs 人类 panel n=160，同批重核）─
//   近敌率 0.4997 vs 0.245（2x，保）；距离均值 3.014 vs 4.3995（保）；corner 0.04875 vs
//   0.01982（2.5x，保）；被挡 0.0358 vs 0.0071（5x，保）；threat 日常 0.1069 vs panel
//   0.087（跨口径，只看方向，已验证 −16%，保）。五项全保，无一退场——复合成立。
//
// ── 检查点（it40，只报不杀；看因也看果）──────────────────────────────────────
//   普查五项方向：threat↓ corner↓ near4↓ dist↑ blocked↓ + 胜率/kills。
//   用户裁定争胜率、不设杀腿线——本腿无机制门，停不停人看盘定（无自动熔断，见下）。
//
// ── 人工盯盘（无自动熔断）───────────────────────────────────────────────────
//   本腿不设任何自动停规则（课程内 ent_break=0、kickstart 熔断全关；开课时控制台也别挂
//   kl/ent 自动 halt）。人看：日常胜率 vs fore-it195 基线、kills、五项方向。
//   重点盯 move 前科（corner↑/hurt↑）与 face 前科（kills↓）。停不停人说了算，不设触发线。
//
// ── yardstick ─────────────────────────────────────────────────────────────
//   终判：冻结 1600 对 vs bc fore-it195（主判）+ vs KR10-it150（参照）；单批 800 对只算提示，
//   必须复测拼池。方向诊断：五项必报（归因 waive，只记数）。
//
// ── 训练设置 ─────────────────────────────────────────────────────────────
//   起点 fore-it195 warm start + kickstart 锚（ref=true, init=0.1）；iters 0 无上限，手工停课；
//   进 x23 流 paired_rotate_seed=20261015（与 fore 线/x23-cm0 同流同 seed_rotate，rollout 可比）。
//   机器与 KR10 同配方（只改价，见 params）。max_hours 24 保留。
//
// ── §15.5 ─────────────────────────────────────────────────────────────────
//   新实验（新 out/traj；opt fresh；backup 新目录）。
{
  "version": 5,
  "name": "x24-stack",
  "mode": "per-tick",
  "level": "ladder-c20-lives1",

  "reward": {
    "formula": "wKill*kills + wHit*aimHits - wDmg*playerDamageTaken - wMiss*aimMisses + wPickup*powerUpsCollected - wApproach*where(pickupDist<0, 0, pickupDist) + wAcc*aimHits/(playerShots+1) + wDist*aimHitDistSum/(aimHits+1) - wHurt*hurtWeight/(ticks+1) - wEncl*enclWeightTicks/(ticks+1) - wCorner*cornerWeightTicks/(ticks+1) - wThreat*threatTicks/(ticks+1) - wNear*nearEnemy4Ticks/(ticks+1) - wBlock*(idleTicks-stopTicks)/(ticks+1)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wMiss": 0.158,
      "wPickup": 3.0,
      "wApproach": 0.008,
      "wAcc": 15.3,
      "wDist": 1.3,
      "wHurt": 110.0,
      "wEncl": 8.6,
      "wCorner": 40.0,
      "wThreat": 60.0,
      "wNear": 8.0,
      "wBlock": 110.0
    },
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：fore-it195 副本（sha `175f19d61fd419bb`，与 x24-fore.it195 同字节）─
  "bc": "nn-training/weights/x24-stack/x24-stack.it0.json",
  "kickstart_ref": true,
  "kickstart_init": 0.1,
  // 熔断全关（用户指令）：margin_pp 100 = 等效关。
  "kickstart_burn": { "mode": "baseline", "margin_pp": 100 },
  "warmup_iters": 0,

  "iters": 0,
  "max_hours": 24,
  "workers": 8,

  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  "target_transitions": 24576,
  "est_samples_per_game": 147,
  "seed_rotate": 150,
  // 进 x23 流（与 fore 线/x23-cm0 同流同 seed_rotate，rollout 可比）。
  "paired_rotate_seed": 20261015,

  "decision_events": false,
  // K=10（K=1 探针已证 cadence 无罪，不动）。
  "decision_k": 10,

  "out": "tmp/x24-stack/weights.json",
  "traj": "tmp/x24-stack",
  "ent_break": 0,
  "backup_dir": "nn-training/weights/x24-stack",
  "backup_prefix": "x24-stack",

  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 确认结算（2026-10-10 回填：stack-it125 拼池确认有效）─────────────────────
// it125 拼池 1600 对：0.4344 vs KR10 0.3531（+8.12pp，p≈0.000003），kills ~12.8–13.5；
// 对 bc fore-it195 单块 +4.25pp（ns，增量未证、总量显著）。叠加成立（方向包），
// face 门不过 + move 替代前科照记（头注纪律声明）。全文 §83 · 同上决策条目。
