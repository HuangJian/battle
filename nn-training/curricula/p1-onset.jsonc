    { "until_iter": 35, "kl_coef": 0.3, "lr": 0.00015, "kl_cap": 0.2 },
    { "kl_coef": 0.05, "lr": 0.00005 }
  ],
  "out": "tmp/p1-onset/weights.json",
  "traj": "tmp/p1-onset",
  "backup_dir": "nn-training/weights/p1-onset",
  "backup_prefix": "p1-onset",
  // 课程的自定义关 stage ID 从 2000 开始编号，p1-onset 有 4 关，ID 就是 2000-2003
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 20,
  "eval_every": 5
}
