  "difficulty": "hard",
  "max_ticks": 6000,
  "seed_rotate": 50,
  "player": {
    "lives": 1,
    "level": 0
  },
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerHits + wTick*ticks - wStuck*max(0, stuckTicks-300) - wShot*playerShots",
    "params": {
      "wKill": 3.0,
      "wHit": 0.3,
      "wDmg": 1.0,
      "wTick": 0.0005,
      "wStuck": 0.02,
      "wShot": 0.005
    },
