// 课程 x20-dodge-l3 —— **收集行为腿：wPickup + wStar 收入侧并集**（dodge-avoidance §4 L3）
//
// 状态：**已起草，待用户手工开训**（agent 不得启动训练）。
//   **并行臂**：与 x20-dodge-l1 并行开工（L3 收集行为与闪避正交，audit 已论证无叠加
//   保守风险；L2a/L2b 有顺序锁不得并行）。并行配对条件：paired_rotate_seed、
//   target_transitions、est_samples_per_game、seed_rotate、workers、eval 配置与 L1
//   **逐字相同**（否则配对退化，plan 顺序锁注记）。
//
// 立项（audit §6.2 R-c）：人类 7.03 拾取/局（拾取率 98%）、42/62 升星；NN 1.84/局
//   （76%）、15/62 升星。现状 wPickup=3.0（=1 杀）严重低估：回血/护盾类道具 = 半个血池
//   = 一次免死；星是永久升级（血池 263→315 + 双发），与一次性道具同价不合理。
//   拾取↔kills r=+0.902 有反向因果（活得久才捡得到），故本腿判据以**拾取率**（行为）
//   为先，不以 kills 为先。
//
// **并集声明（plan 立法原话）**：L3 是唯一允许的打包腿（wPickup + wStar 同向收入侧，
//   不会推向保守），**放弃项内归因**——结算只报整腿效应，不拆两项各贡献多少。
//   因此剂量梯按**整腿典型增量**给（NN 拾取均值 2.22、星均值 0.235，firstkill it30 实测）：
//   起点（3.5, 2.0）≈ +1.6单位 ≈ 0.5杀（量纲锚上沿）/ 中档（4.0, 4.0）/ 上限
//   （5.0, 6.0 audit 剂量）。单次只升一档重试（§4 剂量重试）。
//
// 单变量纯度（leg 内）：除收入侧两项外，其余与 x20-noexplore **逐字相同**
//   （wExplore=0、lam 0.95、mb 1024、lr/epochs/gamma/schedule 全同；reward 进血缘正确）。
//   采样 49152（mb 对齐）/ seed_rotate 全同 L1。
//
// 起点：noexplore 最优 it105（`x20-noexplore.it105`），纯 warm start，`kickstart_ref=false`。
//   comparator = noexplore 同绝对 it 点历史（run 内 itN = 绝对 it105+N；历史臂已封存）。
//   配对：`paired_rotate_seed` 与 noexplore 同值（1789876303，无 demo 参与，414000 无污染，
//   判决主段 = 414000）。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据
// ══════════════════════════════════════════════════════════════════════════
// **主读数顺序写死：机制先行**：① 拾取率是否→90%、升星率是否向人类（42/62）靠拢
//   （日常 eval 自带 puGot 明细，无需 resim）② low% 是否跟随下移。
//   拾取率口径冻结为顶层 `powerUpsCollected/powerUpsSpawned`（分子分母都含 star，
//   自洽；禁用 ΣpuGot/ΣpuSpawn——TS 无 `puGotStar`，该算式恒漏 star 分子约 7pp）。
//   升星判据降级为监测（2026-09-25 评审处置：star 收集率实测 93~105% 已饱和，
//   瓶颈在 spawn ~0.2/局（杀驱动）不在收集行为；wStar 的 payoff 只能经“多杀→
//   多 spawn”来；105% 证明该比值有 ±5pp 计数噪声，小幅移动不读）。
//   it40 只记录、不停腿（it40 误杀门已废）。
// **门**：414000 段 `low% 相对 noexplore 同 it 点改善 ≥3pp` 且 `p10 ≥ 2`
//   （noexplore it105 段值 33.0/8.33/p2）。
// **约束（只记录 + 人工盯盘决策，不自动停）**：日常 mean < 6.19；超时 >5%；
//   kl 连续 3 轮 ≥0.075；保守陷阱（cells/move/pass 任一显著下降——收入侧理论上不触发，
//   触发即反常，加倍重视）。
// **回测门**：终点候选 415000 不劣于 noexplore 同 it 点（同段同种子配对）。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行）
// ══════════════════════════════════════════════════════════════════════════
//   · **专属死刑**：拾取率连续 3 个 eval 点不动 ⇒ 停腿（见不到就捡不会，问题在别处）。
//   · **上/下限**：mean < 6.19 或 timeout >5% ⇒ 人工决策停。
//   · **机械横盘**：low% 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮。

{
  "version": 5,
  "name": "x20-dodge-l3",
  "mode": "per-tick",
  // 环境不变：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：noexplore 原公式 + ★收入侧并集（起点档）──────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected + wStar*starsCollected - wApproach * where(pickupDist < 0, 0, pickupDist)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.0,
      "wPickup": 3.5,
      "wStar": 2.0,
      "wApproach": 0.008
    },
    // dense-only（与父腿一致）：terminal 空表合法。
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：noexplore 最优 it105，纯 warm start ──────────────────────────────
  "bc": "nn-training/weights/x20-noexplore/x20-noexplore.it105.20260922-053620.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  // ── 配对：续 noexplore 的种子流（1789876303，与 L1 逐字同批）─────────────────
  // run 内 itN 吃 noexplore 绝对 it105+N 的种子 ⇒ 与历史臂逐轮同 batch。⚠ 改它 = 非配对。
  "paired_rotate_seed": 1789876303,

  // ── 预算（与 L1 同格，并行两臂各领各的 PPO 活，云 GPU 花销 ×2）───────────────
  "iters": 300,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：回基线（与 noexplore 一致）────────────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：与 L1 逐字相同（并行配对条件）────────────────────────────────────
  "target_transitions": 49152,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/x20-dodge-l3/weights.json",
  "traj": "tmp/x20-dodge-l3",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-dodge-l3",
  "backup_prefix": "x20-dodge-l3",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① bc 文件存在（noexplore it105）。
// ② 公式编译验证（validate_reward 零错误零警告；开训后首轮 PPO 日志确认 reward
//    指纹已变——wPickup/wStar 进血缘是正确的）。
// ③ metrics v8 代码已部署到训练/评估全链路（与 L1 同前置；云节点 pre-v8 之日不开）。
// ④ 新 out/traj 目录（禁续跑，§15.5）。
// ⑤ remote_hubs 登记 + slot 容量 + worker 心跳（开训前确认；并行两臂同时领活，
//    确认云 GPU 容量 ≥2 路 PPO）。
// ⑥ L1 已开（并行臂；L1 未开则本腿可先行，不互相阻塞——正交无顺序锁）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台；L1+L3 同一批开）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it0/it5…（860001 段 400 局）拾取率/升星率/low%/mean/p10 +
//   与 noexplore 同绝对 it 点配对对照表（机制读数永远先于 low% 看）。
//
// ── 结算节（跑完回填）────────────────────────────────────────────────────
// 必填：① 拾取率/升星率 it0 → 终点 + 配对对照 ② low% 是否跟随 ③ 414000 主段 +
//   415000 回测（800 局）④ 分关表 ⑤ 超时/换血读数 ⑥ 实际轮数与耗时
//
// ── 结算（2026-09-25 回填：用户手工停腿，it1–94 ~1.6h，eval 到 it90；门控未跑）──
// ① 机制（拾取率 frozen 口径 powerUpsCollected/powerUpsSpawned；历史臂/CAL 均有值，可配对）：
//    真基线 it0bc 76.3%（pu 2.06/sp 2.70/星 0.19，n=200；eval_log it0 另 200局系 it51 权重
//    误标 f8ab，已剔除——与 L1 结算⑦同源 infra bug：重启时 it0 重评估读了 live 权重）
//    → it90 81.4%（+5.1pp），峰值 it85 83.8%；爬升 it0–55（+0.13pp/轮）后 it55–90 横盘
//    回落（−0.06pp/轮，35 轮无进展）。距 90% 门槛还差 ~7–9pp。vs noex 同绝对 it：前半程
//    逐点 ±2pp（无差），后半程 it80+ 高 +3~5pp（L1 同期回落至 78–79，L3 维持 83）——弱效应。
//    星星 0.19→0.23（监测项；spawn/局 2.70→2.65 没涨：kills 不动→spawn 不动→wStar 的
//    payoff 链“多杀→多 spawn”第二环即断）。
// ② low%：it0bc 40.0/7.64 → it90 38.8/7.48（Δ−1.2pp，噪声）；配对 noex 除 spike 点外全 ±2pp 内；
//    vs L1 同 run-it：L1 全程略优（0~+7pp），收入侧在 low 上不优于开局税。最佳 it40 29.2 为单点
//    且蹭对照臂 abs145 spike，不认。
// ③④ 门控/回测：未跑（早停）。日常 low −1.2pp＋机制未达标 ⇒ 门过先验低，不补测。
// ⑤ 超时/换血：超时全 0；PPO 健康（kl≤0.016、ent 0.52–0.75、rollout 10–22%）；
//    约束全绿（mean≥7.3、cells 75–84 无塌——收入侧无保守陷阱，符合理论预期）。
// ⑥ 实际：it1–94（预算 300，31%），14:40→16:18；5 次 run_start（09:40–15:45 事故切换期）
//    后离线跑稳，无 gate 熔断、无 KL/ent break。
// 判语：**判负倾向，早停合理**。剂量 (3.5, 2.0) 只换来 +5pp 拾取率且 35 轮停滞，300 轮内摸到
//    90% 的外推不成立；且星星链条第二环已断。下一步二选一：升中档 (4.0, 4.0) 重开，或先做拾取
//    行为探针（见得到不捡 vs 见不到）再定剂量。数据：`tmp/x20-dodge-l3/eval_log.jsonl`。
