// 课程 z4-nav —— E2-A 观测距离场：v7 **单通道** ch16 distEnemy（2026-11-01）
//
// 原名 `z2-r5nav`，2026-11-01 随 v7 纪元改名为 `z4-nav`（配置逐字未动；起点文件同批改名）。
// 状态：**未开课**（本文件只做预注册；开课由人在控制台走 W4 会话）。
//
// ══ 唯一变量 ═══════════════════════════════════════════════════════════
//   观测 v7（全局代码）：`OBS_CHANNELS 16→17`，ch16 = 单位成本多源 BFS 到最近激活敌。
//   **不做** ch17 distPickup / s46 bestPickupValue（E0b′ 判 ch17 冗余；单变量纪律）。
//   本课配置与对照 `z3-p2002ctl` **逐字相同**（reward / 关卡 / 预算 / eval / seed），
//   只有 name / out / traj / backup_* 与 `bc` 不同 ⇒ A vs C 的差分只归因观测。
//
// ── 起点 ───────────────────────────────────────────────────────────────
//   guard it500（wver 0c8795f767f161e1）→ `worker/scripts/migrate_obs_channel.py`
//   三段式迁移（旧 obs | 新列 0 | coord 后移）：
//   `nn-training/weights/z4-nav/z4-nav.it0.20261101-230656.json`
//   迁移自检：旧 schema 输入下四头 logits **逐位相等**（新列权重 = 0）
//   ⇒ it0 与 guard it500 行为相同（TS 侧 inCh 由 stem 形状反推；卷积内核已 19ch）。
//
// ── 对照臂 ─────────────────────────────────────────────────────────────
//   `z3-p2002ctl` it150（200 局/关 × 4 = 800 局，`tmp/_z3an/fresh-p2002ctl`）：
//   2002 基毁 **90.0%** / clear **6.0%**（与起点同值 ⇒ 干净对照）。
//   主判决 = it150 的 2002 **基毁率配对**（灰区规则见 plan/r5-next.plan.md §5.2），
//   clear 降为副读数。
//
// ── 预注册判据（开课前冻结，不要事后改）───────────────────────────────
//   1) 主：it150 vs C 的 2002 基毁率配对（净降 ≥8 局且 p<0.05 = 过；
//      净降 4–7 且 p∈(0.05,0.25) = 未定；其余 = 不过）。
//   2) 机制：it150 `wallPress/千` ≤ 本课 **it0** 的 75%（−25%）。
//      ⚠ C 的 800 行产在机制两列落地之前，没有 wallPressTicks/aliveTicks
//      ⇒ 基线一律取本课 it0（drop0 起点 = guard it500 行为），不拿旧行硬算。
//   3) 接线：it150 `--ablate-ch 16` 的翻转率 ≥ 同批 `--ablate-ch 0`（地形砖，阳性对照）
//      的 1/3；并同报 `stem.weight` 第 16 列（新通道）的 L2。
//   4) 止损：entropy <0.7×起点连续 5 点；共同反签名（`lives_exhausted` >20% /
//      `aimHits` 掉 >15% / `cellsVisited` 掉 >10% / `aimBricks` 涨 >30%）任一即停。
//   5) 逐关：2000 / 2001 / 2003 各 −3pp 内；OOD 70 局掉 >5pp ⇒ 专化/记忆化。
//
// ── 并行臂 ─────────────────────────────────────────────────────────────
//   同一起点/任务/预算并行的 `z4-polish`（奖励四轴加压：击杀/命中/拾取/胜率/节奏）——
//   它不是本课的对照（奖励变 = 新 corpus identity，shard 不可复用），只作**打磨臂**与
//   机制读数旁证；本课的主判决仍只对 `z3-p2002ctl` 的 it150。
//
// ── 运行约束 ───────────────────────────────────────────────────────────
//   · W4 独立会话（`OBS_SCHEMA_MAJOR 7`）；不与任何旧 schema 腿并发（代码快照会话锚定）；
//   · 节点先换到本次 v7 代码快照（`src/nn/*`、`tools/sim/export-*`、19ch prebuilt）；
//   · `iters 320 / eval_every 10` ⇒ **唯一主判仍是 it150**（与 C 的 800 局配对）；
//     it0–140 与 it160–320 的其余 32 个点只作**走势/止损**（熵坍缩、反签名、机制闸），
//     不得「挑最好的点」晋级（多点选优的假阳性 ≈ 1−0.95^N，见 plan §5.1）；
//     eval 成本 ≈ 33 点 × 800 局/臂（plan 的测算是 30 点 ≈75 min/臂）；
//   · 开课后不要编辑本文件（课程字节变 = 新实验版本，热加载会按 A 类拒收）。
//
// ── 语义护栏 ───────────────────────────────────────────────────────────
//   ch16 是「到最近敌的路距」：E0b′ 实测最近敌 ≠ 距基地最近敌占 29.0%（2002 关 36.2%）
//   ⇒ 它是**导航/交战**通道，**不是**回防通道；读数不得按「保护基地」解释。

{
  "version": 5,
  "name": "z4-nav",
  "mode": "per-tick",
  "level": "classic35",
  "stage_select": "16,22,3,6",
  "enemies": 20,
  "lives": 3,
  "max_ticks": 20000,
  "reward": {
    "formula": [
      // 收入
      "wKill*kills",
      "+ wHit*aimHits",
      "+ wWin*where(clearTick>=0, 1, 0)",
      // 机制
      "+ wBase*baseWallIntact",
      // 价格
      "- wDmg*playerDamageTaken",
      "- wDeath*playerDeaths",
      "- min(paceCap, wPace*max(0, ticks - kills*paceTicks)/paceWindow)",
      // 塑形
      "+ wBrick*min(aimBricks, brickCap)",
      "+ wWalk*where(cellsVisited>walkCap, walkCap, cellsVisited)",
      // 收入
      "+ wPickup*min(powerUpsCollected, pickupCap)",
      // 机制
      "- wThreat*min(threatTicks, threatCap)",
      "- wDef*min(capDef, max(0, basePressureSum - pDef*basePressureSamples))",
    ],
    "params": {
      "wKill": 15.0,
      "wHit": 1.5,
      "wWin": 60.0,
      "wBase": 3.0,
      "wDmg": 0.12,
      "wDeath": 18.0,
      "wPace": 6.0,
      "paceTicks": 1200.0,
      "paceWindow": 1000.0,
      "paceCap": 36.0,
      "wBrick": 0.25,
      "brickCap": 12.0,
      "wWalk": 1.0,
      "walkCap": 20.0,
      "wPickup": 4.0,
      "pickupCap": 6.0,
      "wThreat": 0.01,
      "threatCap": 500.0,
      "wDef": 2.5,
      "pDef": 0.15,
      "capDef": 80.0,
    },
    "terminal": {
      "timeout": -50.0,
      "lives_exhausted": -35.0,
      "base_destroyed": -35.0,
      "stage_clear": 0.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "nn-training/weights/z4-nav/z4-nav.it0.20261101-230656.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 500,
  "max_hours": 24,
  "lr": 0.00012,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": false,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "kl_coef": 0.05,
      "lr": 0.00012,
      "kl_cap": 0.1,
    },
  ],
  "target_transitions": 24576,
  "paired_rotate_seed": 20261028,
  "decision_events": false,
  "decision_k": 10,
  "out": "tmp/z4-nav/weights.json",
  "traj": "tmp/z4-nav",
  "ent_break": 0.0,
  "ent_break_max_winrate": 0.0,
  "backup_dir": "nn-training/weights/z4-nav",
  "backup_prefix": "z4-nav",
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 200,
  "eval_every": 5,
}

// ══════════════════════════════════════════════════════════════════════════
// 结算节（2026-11-02 结课回填；人工停课 at it200）
// ══════════════════════════════════════════════════════════════════════════
//
// **判决：主判据不过（方向为负）· 机制闸不过 · 观测通道 ch16 判负（权重仅 0.55%）。**
//
// ① 主判（预注册 it150，2002 基毁率配对，200 局同 (stage,seed)）：
//      91.5% vs it0 88.5% —— 转好 13 / 转坏 19，**净 −6**，exact p=0.377
//      判据要求「净降 ≥8 局且 p<0.05」⇒ **不过，且方向相反**。
//      2002 clear 5.5% vs 6.0%（净 −1，p=1.000）亦不过。
//    ⚠ 对照臂 C（`z3-p2002ctl` it150）= 2002 88.5%/6.0%，与本课 it0 逐字相同
//      （`z3-p2002ctl.jsonc:21-24`）⇒ 起点干净，差分只归因观测。
//
// ② 全池（it0→it200，800 局）：
//      clear 32.0% → 33.5%（净 +12/800，p=0.532）· 基毁 54.1% → 52.2%（净 −15，p=0.432）
//      均不显著。it150 的峰值 35.8%（净 +30，p=0.088）在 it170 已回落到 32.0%，不是趋势。
//
// ③ 分关（it0→it200，clear 配对）：
//      2000 −6（p=0.63）· 2001 **+23（p=0.028）** · 2002 ±0（p=1.00）· 2003 −5（p=0.66）
//      2001 是唯一显著项，但逐点曲线 `30/34.5/44/46/30/41.5/43/37.5`
//      （it0/25/50/75/100/125/150/175）抖 16pp、it100 回落 30% ⇒ 不可当能力。
//
// ④ 机制：
//      wallPress/千 286.9 → 252.2 (it150) → **239.3 (it200)** = −16.6%；
//        判据要 ≤ 75%（215）⇒ **不过**（最低单点 210 在 it75，非主判点）。
//      stem ch16 L2 = 0.093 (it150) / 0.101 (it177)，对比 ch0 16.96 / ch15 8.28
//        ⇒ 新通道只到在用通道的 **0.55%**。`--ablate-ch16` 未跑（`tools/e2a_readout.py`
//          只在 it0 做过 4 局 smoke：ch0 翻转 2.56% / ch16 0）。
//      拾取率（同口径含 star）63.2% → 65.0% (it150) → 63.6% (it200)：**不动**。
//      kills/局 11.68 → 12.24 · dmg/局 430 → 449 · 余量 0.297 → 0.298（三读数全平）。
//      **idleTicks 234 → 272（+16%）：卡墙没缓解，反而更多「停住」。**
//      止损闸：entropy 0.707 → 0.808（**反向升**，未触发 <0.7×）；四条反签名全未触发。
//
// ⑤ 给下一腿的输入：
//      a) **ch16 `distEnemy` 判负**：主判方向为负 + 权重 0.55% ⇒ 「单通道 + 无 warmup +
//         lr 1.2e-4」这个配方买不到导航。再试观测必须换机制（分层 lr / 新通道 BC 预热 /
//         或换成「清墙可行性」而非「敌人在哪」）。
//      b) **卡墙不是这条奖励能量到的**：wallPress −16.6% 来自 wWalk/wBase 的间接压力，
//         但 idleTicks 反升 16% ⇒ 顶墙减少的同时停住增加，两者不是同一件事
//         （后续 `z4-pick-wall` 把这条判断做成了显式 idle 项）。
//      c) 2002 失效模式已量化：ticks 3410（max 的 17%）· deaths 0.81 · wallPress 426/千 ·
//         kills 6.1/20；基毁局 kills 5.03 / deaths 0.63 ⇒ **玩家没死、基地先爆、四成时间顶墙**。
//         对上 §12.1 的三条执行器缺陷（不清墙 / 不并入目标车道 / 目标摇摆），
//         不是「找不到敌人」——这也解释了为什么加「敌人在哪」的通道没用。
//
// 数据出处：`tmp/z4-nav/{eval_log,training_log}.jsonl`（39 个 eval 点 × 800 局）·
//   `nn-training/weights/z4-nav/`（201 个权重 it0..it200）·
//   `reports/z4-nav-polish-20261102.md` · `tmp/z4-final.py` / `tmp/z4-final2.py`。
//   墙钟 11-01 23:59 → 11-02 11:28（11.5h），eval 占 ~3.1h（176s/点 × 39）。
//   停课理由：主判已结，且本课预注册写明「it160–320 只作走势、不得挑点晋级」⇒ 继续无新信息。
