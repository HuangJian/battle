// 课程 z2-r5 —— 第 5 级：同一组 4 图 · **20 敌 · 3 命**（2026-10-28）
//
// ── 本级只改一件事 ─────────────────────────────────────────────────────
//   敌数 8 → 20 = 经典单关的完整兵力（`forces` 全串上场）。任务侧与 classic35 **完全同构**，
//   唯一差 = 只有 4 张图 ⇒ 这一级与 r6 的差是**纯泛化**（同样 20 敌 3 命，4 图 → 35 图）。
//
// ── 起点：r4 的 **it150 冻结归档**（2026-10-29 19:48）────────────────────
//   `bc` = `nn-training/weights/z2-r4/z2-r4.it150.20261029-194823.json`
//   （sha256 前 16 位 = `81449bc95872cb69`，与 eval_log it150 的 `wver` 逐字相同 ⇒ 评估的就是它）。
//   规则：**只用末次有评估支撑的归档**（滚动 out = 盲启，r3 的 it105 教训）。
//   ⚠ **r4 与 r4threat 都还在跑**（19:50：r4 it151 / r4threat it149）⇒ 上面这份只在「此刻」成立；
//     开 r5 之前按同一规则换成 r4 停课点的最后一个评估归档（wver 对账），**两臂必须同一份**。
//
// ── 晋级 ───────────────────────────────────────────────────────────────
//   clearRate ≥50% ×2、zero_kill ≤0.10 ⇒ 开 z2-r6（35 关原题）。
//   ⚠ 本级 20 敌的局长远大于前四级：`target_transitions 24576` 下 4 关各 ~6144 samples，
//     约 15–25 局/关/轮；读数看分关，不看四关平均（AGENTS §15.2）。
//
// ── 并行臂：`z2-r5base`（同起点、formula 逐字相同，只把 **wBase 3.0 → 8.0**）──
//   本级主腿**不改价格表**：v2 在 8 敌上仍然有效，能拿数据支撑的唯一杠杆是「基地价」。
//   依据（r4 it135–it150 合并 320 局）：输 132 局里 **128 局 = 基地被毁（97%）**、命尽 4 局；
//   rollout it120–149 基毁 35.7%。
//   基毁局 2550 拍 / 3.03 杀 / 承伤 217 / cells 59 vs 清关 3672 / 8.00 / 354 / 90
//   ⇒ 是**被动、低交战**的输法，不是打不过。
//   r4threat（威胁税 ×2）实测**没降基毁**（同 it 窗口 35.4% vs 35.7%）⇒ 暴露价不是这个瓶颈。
//   满墙时基墙项势差为 0 ⇒ 抬它不会额外奖励守家；价格排序实算见 `z2-r5base.jsonc` 头。
//   ⚠ 两臂**必须同起点**（都从 r4 的同一个冻结归档起）否则 A/B 不成立；判据与止损见 `z2-r5base.jsonc` 头。

// ── 奖励：价格表 **v2**（r3–r6 逐字相同；r2 及以下仍是 v1）──────────────
//   +15*kills +1.5*命中 +60*clear +3*墙块(0–8) -0.12*dmg -18*death
//   -min(36, 6*未支付千拍) +0.25*min(bricks,12) +1.0*min(cells,20)
//   +4.0*min(powerUps,6) -0.01*min(threatTicks,500)
//   反苟：墙价（丢一圈 -24）+ 按拍 pace（每杀赠 1200 拍，超出每千拍 -6、封顶 -36）
//         + 移动项封顶 20 格 + **威胁税封顶 500 拍**（满额 −5 = 1/3 个击杀）。
//         超时 -50 = 唯一「没打完」的结局，比任何输法都贵。
//   反莽：命价 18 > 一杀 15、血价 0.12/HP、墙价让「冲出去丢基地」也亏；命尽/基毁 -35。
//   v2 两项的剂量与量纲见 `z2-r3.jsonc` §价格表 v2；全表见 `docs/nn/training-stack.md` §50.3 修订④。
//
// ── 晋级 / 停腿 ─────────────────────────────────────────────────────────
//   · 晋级下一级：in-loop eval **连续 2 个评估点** clearRate ≥ 50% 且 zero_kill_frac ≤ 0.10。
//   · 停腿：40 轮内 clearRate 始终 0 ⇒ 停，**先查任务侧再谈奖励**（§50.4 的 commander floor）。
//   · it0 的 greedy 是恒定动作（近均匀初始化的正常形态），判据从 it20+ 读。

{
  "version": 5,
  "name": "z2-r5",
  "mode": "per-tick",
  "level": "classic35",
  "stage_select": "16,22,3,6",
  "enemies": 20,
  "lives": 3,
  "max_ticks": 20000,
  "reward": {
    "formula": "wKill*kills + wHit*aimHits + wWin*where(clearTick>=0, 1, 0) + wBase*baseWallIntact - wDmg*playerDamageTaken - wDeath*playerDeaths - min(paceCap, wPace*max(0, ticks - kills*paceTicks)/paceWindow) + wBrick*min(aimBricks, brickCap) + wWalk*where(cellsVisited>walkCap, walkCap, cellsVisited) + wPickup*min(powerUpsCollected, pickupCap) - wThreat*min(threatTicks, threatCap)",
    "params": {
      "wKill": 15.0,
      "wHit": 1.5,
      "wWin": 60.0,
      "wBase": 3.0,
      "wDmg": 0.12,
      "wDeath": 18.0,
      "wPace": 6.0,
      "paceTicks": 1200.0,
      "paceWindow": 1000.0,
      "paceCap": 36.0,
      "wBrick": 0.25,
      "brickCap": 12.0,
      "wWalk": 1.0,
      "walkCap": 20.0,
      "wPickup": 4.0,
      "pickupCap": 6.0,
      "wThreat": 0.01,
      "threatCap": 500.0,
    },
    "terminal": {
      "timeout": -50.0,
      "lives_exhausted": -35.0,
      "base_destroyed": -35.0,
      "stage_clear": 0.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "nn-training/weights/z2-r4/z2-r4.it150.20261029-194823.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 500,
  "max_hours": 40.0,
  "lr": 0.00012,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": false,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "kl_coef": 0.05,
      "lr": 0.00012,
      "kl_cap": 0.1,
    },
  ],
  "target_transitions": 24576,
  "paired_rotate_seed": 20261028,
  "decision_events": false,
  "decision_k": 10,
  "out": "tmp/z2-r5/weights.json",
  "traj": "tmp/z2-r5",
  "ent_break": 0.0,
  "ent_break_max_winrate": 0.0,
  "backup_dir": "nn-training/weights/z2-r5",
  "backup_prefix": "z2-r5",
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 20,
  "eval_every": 5,
}
