// ─────────────────────────────────────────────────────────────────────────────
// replay-dose2-lr2.jsonc — 组合腿：D2 的池 + lr 2e-4
//
// ⚠ 本文件由 `tmp/gen-replay-batch2.py` 从 **`replay-dose2.jsonc`** 派生，只改：lr、ppo_schedule
//    其余（奖励/架构/其余超参/关卡/执行档 replay+lazy）与 D2 逐字节相同，生成器带 diff 断言。
//
// 1. 问什么
//    lr2 单腿 +3.1pp（落在 4pp 散布内）但前期明显更快；D2 单腿 +7.0pp。两条机制独立，
//    本腿看叠加是加成还是互相抵消。
//
// 2. 判据（先写死）
//    终点 ≥ D2 +1pp 且 kl<0.02 ⇒ 采纳；kl>0.05 或 ent 连续下降 ⇒ 停腿。
//
// 3. 开跑前置
//    · 起点权重已由生成器预置到 `tmp/replay-dose2-lr2/weights.json`；缺失时 it1 直接 FileNotFoundError。
//    · 与本批其它腿**同一个 trainer 进程**（runId 随进程变，跨进程不能互相配对）。
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 5,
  "name": "replay-dose2-lr2",
  "mode": "per-tick",
  "level": "classic35-safe-base",
  "rotation_mode": "even",
  "rotation_per_it": 7,
  "reward": {
    "formula": [
      "wKill*kills",
      "+ wHit*aimHits",
      "+ wAcc*aimHits/(playerShots+1)",
      "+ wWinHit*min(hitsInFreezeShieldWindow, winHitCap)",
      "+ wBrick*min(aimBricks, brickCap)",
      "+ wPickup*min(powerUpsCollected, pickupCap)",
      "+ wWin*where(clearTick>=0, 1, 0)",
      "+ wSpeed*where(clearTick>=0, max(0, min(1, (13000-clearTick)/1400)), 0)",
      "- wDmg*playerDamageTaken",
      "- wDeath*playerDeaths",
      "- wIdle*idleTicks/(ticks+1)",
      "- wStuck*min(max(0, stuckTicks - stuckFree), stuckCap)",
      "- wWall*min(max(0, wallPressTicks - wallFree), wallCap)",
      "- wThreat*min(threatRateCap, threatTicks/(ticks+1))",
      "- wHurt*min(hurtWeight, hurtCap)",
      "- wPostHit*min(postHitRateCap, postHitLaneTicks/(ticks+1))",
      "- wEncl*min(enclRateCap, enclWeightTicks/(ticks+1))",
      "- min(missCap2, wMiss2*max(0, aimMisses - missFree)**2)",
      "+ wAccGood*min(accCap, max(0, aimHits/(playerShots+1) - accFree))",
      "- wBurst*min(damageBursts, burstCap)",
      "- wMaxDmg*min(max(0, maxDamage120 - maxDmgFree), maxDmgCap)",
      "- wLowDmg*min(damageWhileLow, lowDmgCap)",
    ],
    "params": {
      "wKill": 15.0,
      "wHit": 1.5,
      "wAcc": 5.0,
      "wWinHit": 1.2,
      "winHitCap": 12.0,
      "wBrick": 1.0,
      "brickCap": 12.0,
      "wPickup": 4.0,
      "pickupCap": 6.0,
      "wWin": 80.0,
      "wSpeed": 8.0,
      "wDmg": 0.12,
      "wDeath": 24.0,
      "wIdle": 100.0,
      "wStuck": 0.04,
      "stuckFree": 300.0,
      "stuckCap": 900.0,
      "wWall": 0.08,
      "wallFree": 350.0,
      "wallCap": 300.0,
      "wThreat": 130.0,
      "threatRateCap": 0.25,
      "wHurt": 0.09,
      "hurtCap": 500.0,
      "wPostHit": 800.0,
      "postHitRateCap": 0.035,
      "wEncl": 40.0,
      "enclRateCap": 0.4,
      "wMiss2": 0.0015,
      "missFree": 40.0,
      "missCap2": 12.0,
      "wAccGood": 200.0,
      "accFree": 0.45,
      "accCap": 0.15,
      "wBurst": 4.0,
      "burstCap": 8.0,
      "wMaxDmg": 0.1,
      "maxDmgFree": 120.0,
      "maxDmgCap": 300.0,
      "wLowDmg": 0.03,
      "lowDmgCap": 600.0,
    },
    "terminal": {
      "timeout": -50.0,
      "lives_exhausted": -45.0,
      "base_destroyed": -35.0,
      "stage_clear": 0.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "nn-training/weights/replay-verify/replay-verify-s5.json",
  "kickstart_ref": false,
  "kickstart_init": 0.0,
  "kickstart_decay": 0.5,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 40,
  "max_hours": 6.0,
  "lr": 0.0002,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "kl_coef": 0.05,
      "lr": 0.0002,
      "kl_cap": 0.1,
    },
  ],
  "target_transitions": 12288,
  "paired_rotate_seed": 20261115,
  "decision_events": false,
  "decision_k": 10,
  "opening_connect": true,
  "breakers_off": true,
  "ent_break": 0.25,
  "ent_break_consec": 8,
  "ent_break_max_winrate": 0.0,
  "eval_stages": "2000-2034",
  "eval_games_per_stage": 20,
  "eval_every": 10,
  "corpus_fmt": "replay",
  "ppo_loader": "lazy",
  "out": "tmp/replay-dose2-lr2/weights.json",
  "traj": "tmp/replay-dose2-lr2",
  "backup_dir": "nn-training/weights/replay-dose2-lr2",
  "backup_prefix": "replay-dose2-lr2",
}
