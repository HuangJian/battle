  "difficulty": "hard",
  "max_ticks": 12000,
  "seed_rotate": 8,
  "player": {
    "lives": 1,
    "level": 0,
  },
  "reward": {
    "formula": "wKill*(kills+1)**p + wFirst*where(firstKillTick>=0, 1.0, 0.0) + wHit*enemyHits - wDmg*playerHits - wDmg2*playerDamageTaken + wLoot*powerUpsCollected + wStar*starsCollected - wStuck*max(0, stuckTicks-120) - wShot*playerShots",
    "params": {
      "wKill": 1.0,
