// 课程 x20-steady-cont —— **B 续跑：把唯一的阳性斜率烧到门**（H1 vs H2 判决实验）
//
// 状态：**草稿，待用户手工开训**（agent 不得启动训练）。
//
// 立项（2026-09-26）：noexplore it105 之后八条腿七死一停——floor/firstkill/terminal/
//   demo-mix 判负；dodge L1 两档判死、L3 两档判负、L2a 信号没进去、L2b B2 未开；
//   state-init 154 轮日常 40.0→47.2（比起点还差）。**唯一阳性是 B**：判决 35.5 vs 门 35
//   （差 4 局/0.5pp，噪声内），停时终点区日常已摸门（it165 33.8 / it170 34.0 / p10=2）。
//   本腿回答 B 结算④的遗留问题（"每轮更稳还是总量更多"）：过了门 = H1（量不够，继续加），
//   横盘 = H2（方向到顶，停烧转蒸馏评审）。两枪都哑火才认 H2。
//
// 单变量纯度（诚实版）：与 B **逐字相同**（奖励/位移/采集全同），唯一的差是"续时间"
//   （从 it175 起再跑 200 轮）。检验的正是总量混杂 —— 这是本腿的目的，不是污染。
//
// 起点：B 终点 it175（`x20-steady.it175.20260920-215502.json`），纯 warm start，
//   `kickstart_ref=false`（C 腿教训：continuation 从收敛权重起跑 kickstart 必须 kk≈0，
//   否则前 30 轮全是回锚；dodge 四腿同规）。
//   comparator = B 自身历史趋势 + 终点门控（下述"门"为绝对门，不动）。
//
// 种子流（必须先读）：B 先于 rotate-seed pinning 机制（C 腿才落地），B 的流无存档值可续 ⇒
//   本腿**不设 paired_rotate_seed**（新流；§15.1 轮换由 seed_rotate=150 + 回路 runSeed
//   抖动保证）。日常段 seed0=860001 固定 ⇒ 日常趋势与 B 终点区可比；门是绝对门
//   （vs B-it0），不受训练流影响。代价写清：训练曲线与 B 历史只可比趋势，不可逐点配对。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据（B 原门，一字不动 —— 不许移动球门）
// ══════════════════════════════════════════════════════════════════════════
// **门**：414000 段 `low% ≤ 35%`（vs B-it0 42.9，即 −7.9pp）且 `p10 ≥ 2`。
//   it175 参考值：35.5/7.84/p2（差 4 局）。
// **回测门**：终点 415000 不劣于 B-it0（42.0/6.34）；同时记录 vs it175（38.9/7.76）。
// **约束（熔断优先级最高，B 原样 + kl 记录）**：日常 mean < 6.19 ⇒ 立即停；
//   超时 >5% ⇒ 立即停；kl 连续 3 轮 ≥0.075 ⇒ 只记录 + 人工盯盘；分关任一退步 >5pp ⇒ 掉队。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行）
// ══════════════════════════════════════════════════════════════════════════
//   · **机械横盘**：low% 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮
//     （B 原样；B 的 it40 误杀教训：前 40 轮不设主检点，只看熔断）。
//   · **预算止损**：200 轮 / 14h 烧完而门未过 ⇒ 判"量也不行"（H2 确认），
//     停烧转蒸馏评审，不再续第三段。
//   · **分支预注册**：横盘 ⇒ H2 确认，**不转 state-init**（state-init 已 154 轮阴性，
//     日常更差，转它是重挖旧坑）；过门 ⇒ 按 dodge-avoidance Phase 4 回接 c20 verdict。
//   · **被否决备选**（本轮不再议）：新价格腿（六条全死）/ 现在接受平台（B 斜率未死）。
//     DaggeR/搜索蒸馏排队等本腿结论（BC-ref 已死，凭什么活还没答，先烧便宜的这枪）。

{
  "version": 5,
  "name": "x20-steady-cont",
  "mode": "per-tick",
  // 环境不变：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：与 B 逐字同（validate_reward 零错误零警告，2026-09-26 实测）──────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected - wApproach * where(pickupDist < 0, 0, pickupDist)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.2,
      "wPickup": 3.0,
      "wApproach": 0.008
    },
    // dense-only（与 B 一致）：terminal 空表合法。
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：B 终点 it175，纯 warm start（C 教训 kk≈0）────────────────────────
  "bc": "nn-training/weights/x20-steady/x20-steady.it175.20260920-215502.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  // ★ Adam 状态不跨课（2026-09-26 问答纪要）：opt 工件只活在 transient blob（opt.pt），
  //   backup_dir 只有权重 JSON，B 的 live opt 随 tmp 已消失；且 CourseConfig 无跨课搬运
  //   opt 的字段（全库无 opt_init）。⇒ 新课只能 fresh Adam，这是唯一选项，不是疏漏。
  //   跳变量级：dodge 六条腿全是同形态起跑（bc 权重 + fresh opt），it1 kl 0.008~0.013
  //   全在正常带（L1d2 it1 0.0104 vs 全程 0.0088~0.0130 不可区分）；C 事故 kl=0.90 是
  //   kk=1 kickstart anchor 拽回去的，两码事。Adam bias correction + kl_cap 0.2 兜底，
  //   瞬态 1~3 轮。开训后盯 it1–3 kl（>0.03 即不正常），it5 首点才对照趋势。

  // ── 预算（B 实测 3.6min/轮 ⇒ 200 轮 ≈ 12h；L3d2 并跑，留余量到 14h）────────
  "iters": 200,
  "max_hours": 14,
  "workers": 8,

  // ── 位移包：与 B 逐字同 ──────────────────────────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：与 B 逐字同 ────────────────────────────────────────────────────
  "target_transitions": 48000,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5；continuation = 新实验）────────────────────
  "out": "tmp/x20-steady-cont/weights.json",
  "traj": "tmp/x20-steady-cont",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-steady-cont",
  "backup_prefix": "x20-steady-cont",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① bc 文件存在（it175，2026-09-26 已验）。
// ② 公式编译验证（validate_reward 零错误零警告；与 B 逐字同是正确原因）。
// ③ 新 out/traj 目录（禁续跑，§15.5；工具开训时建，570前确认无残留 `tmp/x20-steady-cont`）。
// ④ remote_hubs 登记 + slot 容量 + worker 心跳（L3d2 并跑中，确认云 GPU 容量 ≥2 路 PPO）。
// ⑤ metrics 无变更（v8 全链路已是现状，无需重推；日常 eval 自带 clean600/dmg600，
//    开局机制读数白送——B 当年没有，cont 附带看，不作门）。
// ⑥ it0 基线：tmp/x20-steady 已清 ⇒ 以 B 结算节终点区为准（日常 it170 8.04/low 34.0；
//    门控 35.5/7.84/p2；回测 38.9/7.76）。cont-it5 首点对照趋势，不判读。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台开课）。
//   L3d2 继续跑（算力足），两腿并行各领各的 PPO 活。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it5/it10…（860001 段 400 局）low%/mean/p10 + B 终点区对照（趋势可比，
//   非配对）+ 附带 clean600/dmg600（B 没有的机制读数）。
// · value 首行均值每 eval 点记录（dodge 教训：workdir sweep 吃基线；从 it0 起 pin）。
//
// ── 结算节（跑完回填）──────────────────────────────────────────────────────
// 必填：① low% it-B终点区 → cont终点 + 趋势 ② 414000 主段（800 局，绝对门 ≤35%/p10≥2）
//   ③ 415000 回测（vs B-it0 + vs it175 双对照）④ 分关表（s2000/s2001 硬骨头盯死）
//   ⑤ 超时/换血 ⑥ 实际轮数与耗时 ⑦ H1/H2 判语（二选一写死：过门=H1 量不够继续加；
//   横盘=H2 到顶停烧转蒸馏评审；不许"再等等"）。
//
// ── 结算（2026-09-26 回填：it1–25，用户手工停腿，新纪元取代）──
// 本腿仅跑出 it1–25（日常到 it25）即被用户叫停：第一性原理审计确认旧表示缺"停"动作，
// 设计错误的网络继续训练没有意义。H1/H2 未决（25 轮无趋势可读），不判； verdict 移交新纪元
// （`plan/new-era-stop.plan.md`）。it1–9 起步核查：kl 正常带、kickstart=0、起点正确
// （见 memory 2026-09-26）。数据：`tmp/x20-steady-cont/`（封存备查，不复用——新纪元从零）。
