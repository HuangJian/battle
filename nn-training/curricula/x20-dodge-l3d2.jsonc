// 课程 x20-dodge-l3d2 —— **收入侧剂量重试：(wPickup, wStar) (3.5,2.0)→(4.0,4.0)**
//   （dodge-avoidance L3 二轮；plan §4 剂量重试）
//
// 状态：**草稿，待用户手工开训**（agent 不得启动训练）。
//
// 立项（L3 首轮结算 2026-09-25 判负倾向、it94 早停后的预注册二选一之一起点档）：
//   (3.5,2.0) 只换来 +5pp 拾取率且 35 轮停滞，300 轮摸到 90% 的外推不成立；星星链条
//   第二环已断（spawn ~0.2/局杀驱动，收集率 93~105% 饱和）。判语二选一：① 升中档
//   (4.0,4.0) 重开，或 ② 先做拾取行为探针（见得到不捡 vs 见不到）再定剂量。
//   本腿是选项 ①。**并集声明不变**（见下）：L3 是唯一允许的打包腿，放弃项内归因。
//   ⚠ 若本轮拾取率仍停滞，判语已写死：不再升上限档 (5.0,6.0)，先做探针（选项 ② 仍在桌上）。
//
// 单变量纯度（leg 内）：与 L3 首轮文件**逐字相同**，只改 `wPickup: 3.5 → 4.0`、
//   `wStar: 2.0 → 4.0`（reward 进血缘正确）。其余与 noexplore 逐字相同
//   （wExplore=0、lam 0.95、mb 1024、lr/epochs/gamma/schedule 全同）。
//   采样 49152 / seed_rotate 150 全同。
//
// 起点：noexplore 最优 it105（`x20-noexplore.it105`），纯 warm start，`kickstart_ref=false`。
//   comparator = noexplore 同绝对 it 点历史（run 内 itN = 绝对 it105+N；abs>180 后无对照裸奔，
//   与 L1/L3 首轮同口径）。配对：`paired_rotate_seed` 与 L3 首轮**同值 1789876303**
//   ⇒ 训练语料逐轮同 batch：剂量是唯一的差。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据
// ══════════════════════════════════════════════════════════════════════════
// **并集声明（plan 立法原话，首轮逐字继承）**：L3 是唯一允许的打包腿（wPickup + wStar
//   同向收入侧，不会推向保守），**放弃项内归因**——结算只报整腿效应，不拆两项各贡献多少。
// **主读数顺序写死：机制先行**：① 拾取率是否→90%（日常 eval 自带 puGot 明细；口径冻结为
//   顶层 `powerUpsCollected/powerUpsSpawned`，禁用 ΣpuGot/ΣpuSpawn——TS 无 `puGotStar`，
//   该算式恒漏 star 分子约 7pp；首轮 it0 基线见 L3 结算）② 升星率监测降级（star 收集率
//   93~105% 饱和，瓶颈在 spawn 不在收集；小幅移动不读）③ low% 是否跟随。
//   it40 只记录、不停腿（it40 误杀门已废）。
// **门**：414000 段 `low% 相对 noexplore 同 it 点改善 ≥3pp` 且 `p10 ≥ 2`
//   （noexplore it105 段值 33.0/8.33/p2）。
// **约束（只记录 + 人工盯盘决策，不自动停）**：日常 mean < 6.19；超时 >5%；
//   kl 连续 3 轮 ≥0.075；收入侧无保守陷阱（首轮已证 cells 无塌，符合理论预期）。
// **回测门**：终点候选 415000 不劣于 noexplore 同 it 点（同段同种子配对）。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行）
// ══════════════════════════════════════════════════════════════════════════
//   · **专属死刑**：拾取率连续 3 个 eval 点不动 ⇒ 停腿（首轮 35 轮停滞已证"见不到"的
//     可能大；再不动就是见得到也不捡或见不到，转探针，不加量）。
//   · **上/下限**：mean < 6.19 或 timeout >5% ⇒ 人工决策停。
//   · **机械横盘**：low% 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮。
//   · 本轮再负 ⇒ 收入侧判死（不再升 (5.0,6.0) 上限档；下一步是拾取行为探针，不是加量）。

{
  "version": 5,
  "name": "x20-dodge-l3d2",
  "mode": "per-tick",
  // 环境不变：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：L3 首轮公式 + ★收入剂量升中档 ──────────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected + wStar*starsCollected - wApproach * where(pickupDist < 0, 0, pickupDist)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.0,
      "wPickup": 4.0,
      "wStar": 4.0,
      "wApproach": 0.008
    },
    // dense-only（与父腿一致）：terminal 空表合法。
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：noexplore 最优 it105，纯 warm start ──────────────────────────────
  "bc": "nn-training/weights/x20-noexplore/x20-noexplore.it105.20260922-053620.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  // ── 配对：与 L3 首轮同 V（1789876303）──────────────────────────────────────
  // ⚠ 改它 = 非配对（且与首轮不可比）。
  // 本腿不开 paired-kill（默认关；单腿绝对门，无配对杀臂——2026-09-26 opt-in 教训）。
  "paired_rotate_seed": 1789876303,

  // ── 预算 ───────────────────────────────────────────────────────────────
  "iters": 300,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：回基线（与 noexplore / L3 首轮一致）────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：mb 对齐 ────────────────────────────────────────────────────────
  // 49152 = 48 × mb(1024)；per-stage quota = 12288 = 12 × mb ⇒ 无 ragged tail。
  "target_transitions": 49152,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5；剂量语义变更 = 新实验）────────────────────
  "out": "tmp/x20-dodge-l3d2/weights.json",
  "traj": "tmp/x20-dodge-l3d2",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-dodge-l3d2",
  "backup_prefix": "x20-dodge-l3d2",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① bc 文件存在（noexplore it105）。② 公式编译验证（validate_reward 零错误零警告）。
// ③ metrics v8 全链路（首轮已部署，复用）。④ 新 out/traj 目录（禁续跑，§15.5）。
// ⑤ remote_hubs 登记 + slot 容量 + worker 心跳。
// ⑥ it0 基线现跑：开训后先用 bc 跑 400 局日常段（860001，同种子），单 wver 校验通过
//    才算数——C-0 教训（200 局 it0 分母太小，+2.65pp 都判不了）+ L1 事故（it0 混入 it43
//    权重误标）：400 行同 wver 否则重跑，判读以 400 局为准。
//    已跑（2026-09-26，开训前）：n=400 win 15.50%（62/400）kills 7.71 low% 37.50 p10 1
//    p50 5，单权重源（spec 锁定 noex-it105；与 C-0 那次 bc 现跑逐局一致，确定性旁证）。
//    数据：`tmp/dodge-it0-baseline-860001.jsonl`（四腿共用，同 bc 同段）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it0/it5…（860001 段 400 局）拾取率/升星率/low%/mean/p10 +
//   与 L3 首轮同 run-it 对照（同 V 同 batch，剂量差的直接读数）。
// · 首轮数据：`tmp/x20-dodge-l3/eval_log.jsonl`。
// · value 首行均值每 eval 点记录（state-init 教训：V 的 it0 基线被 workdir sweep 吃掉；
//   本腿从 it0 起每点 pin 一份，workdir 清理不得删该记录）。
//
// ── 结算节（跑完回填；结论与首轮合并，plan §4）──────────────────────────────
// 必填：① 拾取率/升星率 it0 → 终点 + 首轮同 it 对照 ② low% 是否跟随 ③ 414000 主段 +
//   415000 回测（800 局）④ 分关表 ⑤ 超时/换血读数 ⑥ 实际轮数与耗时
//   ⑦ 合并判语：两轮剂量 ((3.5,2.0),(4.0,4.0)) 联合结论（若本轮亦负 ⇒ 收入侧判死，转探针）。
//
// ── 结算（2026-09-26 回填：it1–173，用户手工停腿，~08:02→17:48 ≈9.8h；门控 414000 同日）──
// ① 机制（拾取率 frozen 口径；历史臂/CAL 均有值，可配对）：it0 真基线 76.5%（pu 377/sp 493，
//    星 0.20/局，n=184）→ it170 86.0%（+9.5pp），峰值 it150 86.9%；it0–70 爬升（+9pp）后
//    it70–170 百轮横盘（85.7→86.0，±1.5pp 震荡），距 90% 还差 ~4pp。星星 0.20→0.26/局
//    （监测项；收集率饱和，spawn 杀驱动，payoff 第二环仍断——与首轮同构）。
//    首轮同 it 对照：首轮 it90 81.4%，本轮 it90 84.7%（+3.3pp）——剂量加倍只换来 +3pp 拾取。
// ② low%：it0 40.2/7.65 → it170 37.2/7.75（Δ−3.0pp，噪声）；区间 31.5（it165 spike）~45.0
//    （it90 全程最差），方差淹没趋势；it165 spike 按 L1 教训不追（spike 不送门）。
//    p10 34 个点仅 8 个 ≥2。拾取涨 9.5pp、low 不跟 = B4 指纹（过程改善≠结果改善）。
// ③ 414000 主段（800局/权重，用户点名 it25/100/130 + noex-it105 同命令同 seed0 四权重配对；
//    noex-it105 复测 33.0/8.33/p2/win18.1，与档案逐字吻合）：it25 31.6/8.34/p2（−1.4pp，
//    p=0.57 噪声打平）· it100 40.5/7.53/p1（+7.5pp，McNemar 138/198 p=0.0013 显著更差——
//    日常 mean 最优 8.49/win19% 在池外崩盘，日常选优反向标本）· it130 35.2/8.22/p2
//    （+2.2pp，p=0.36）。**门（−3pp 且 p10≥2）三候选全灭**。分关无亮点（it100 s2000/s2001
//    双崩 43.5/46.0）。门控机时注记：首跑 self 通道全失败 + distLocal=0 ⇒ ~15局/分；
//    定点清除后 --dist-local 8 重开 ⇒ ~400局/分，7 分钟 3200 局（partial 现场保留 .run.partial1）。
// ④ 415000 回测：未跑（最好 −1.4pp 噪声，门过先验低；L3 首轮先例，不补测）。
// ⑤ 超时/换血：超时全 0；约束全绿（kl≤0.0164、ent 0.54~0.75 无塌、cells 74~84 无塌）；
//    PPO 健康。dmg/局终点 ~250（换血不动；收入侧本就不动开局，符合预期）。
// ⑥ 实际：it1–173（预算 300/12h 的 58%）；用户控制台手工停（loop-control paused）。
//    judge 3200 局（4权重×800，含基线同命令配对）。
// 判语：**判负**。⑦ 合并：两轮剂量 ((3.5,2.0),(4.0,4.0)) 拾取 +5/+9.5pp、low −1.2/−3.0pp
//    双双噪声、门控三候选最好打平且有一个显著更差 ⇒ **收入侧判死，不再升 (5.0,6.0) 上限档**；
//    下一步拾取行为探针（见得到不捡 vs 见不到），不是加量。
// 数据：`tmp/x20-dodge-l3d2/settle/judge-414000.jsonl`（3200行；门控段配对键 stageId，L1d2 勘误适用）。
