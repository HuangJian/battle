// 课程 x23-cm3 —— commitment 整形臂之三：−wStuck（罚原地发呆），单项单臂。
//
// 立项 → bundle 拆分（见 cm1 头注）。本臂唯一改动（相对 cm0）：
//   公式 −wStuck*stuckTicks/(ticks+1)，wStuck=5.0（stuck=原地+未命中 streak，col9 稀有 ⇒ 权重大）。
// 与 wStop 分工：stop 奖"有用静止"（瞄准），stuck 罚"无用静止"（发呆），定义正交。
// 量级声明：初值，无最优性主张；stuck 稀有，项量级小，预期效应最弱（哨兵项）。
// 其余：起点 KR10-it150（sha `a683e5da…`，本课 it0 + in-use 备份同源）/ iters 0（手工停课，
//   终判四臂停齐同一 iter）/ 新流 20261015 / K=10 / 守卫全关 + 人盯盘 / target 24576/est 147。
// 终判沿用 §5 表（N=1600，同种子四臂全配对；方向诊断 stuck 率）。
{
  "version": 5,
  "name": "x23-cm3",
  "mode": "per-tick",
  "level": "ladder-c20-lives1",

  "reward": {
    "formula": "wKill*kills + wHit*aimHits - wDmg*playerDamageTaken - wMiss*aimMisses + wPickup*powerUpsCollected - wApproach*where(pickupDist<0, 0, pickupDist) + wAcc*aimHits/(playerShots+1) + wDist*aimHitDistSum/(aimHits+1) - wHurt*hurtWeight/(ticks+1) - wEncl*enclWeightTicks/(ticks+1) - wCorner*cornerWeightTicks/(ticks+1) - wStuck*stuckTicks/(ticks+1)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wMiss": 0.158,
      "wPickup": 3.0,
      "wApproach": 0.008,
      "wAcc": 15.3,
      "wDist": 0.738,
      "wHurt": 110.0,
      "wEncl": 8.6,
      "wCorner": 25.0,
      "wStuck": 5.0
    },
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  "bc": "nn-training/weights/x23-cm3/x23-cm3.it0.json",
  "kickstart_ref": true,
  "kickstart_init": 0.1,
  "kickstart_burn": { "mode": "baseline", "margin_pp": 100 },
  "warmup_iters": 0,

  "iters": 0,
  "max_hours": 24,
  "workers": 8,

  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  "target_transitions": 24576,
  "est_samples_per_game": 147,
  "seed_rotate": 150,
  "paired_rotate_seed": 20261015,

  "decision_events": false,
  "decision_k": 10,

  "out": "tmp/x23-cm3/weights.json",
  "traj": "tmp/x23-cm3",
  "ent_break": 0,
  "backup_dir": "nn-training/weights/x23-cm3",
  "backup_prefix": "x23-cm3",

  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 结算（2026-10-09 回填：it150 终判点；本课实际跑到 it460，本次只判 it150）──
// it150 日常 400 局对 cm0 同种子配对：0.345 vs 0.280（+6.5pp，χ²cc 3.68，p≈0.055；
// 几乎全由 2003 单关 +18pp 驱动，pool 1200 局缩水 +2.17pp ns）。方向：stuck 6.97% vs
// 7.42%（Δ−0.45pp，sd 10pp 噪声）——有胜率无机制，不认功。
// 判语：否决（哨兵如预期最弱），归档不续跑。数据：`tmp/x23-cm3/eval_log.jsonl` ·
// 全文 `docs/nn/experiments.md` §81 · 决策 `DECISIONS.md` §2026-10-09-goalnn-x23cm-verdict。
