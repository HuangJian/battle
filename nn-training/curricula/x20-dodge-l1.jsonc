// 课程 x20-dodge-l1 —— **开局闪避腿：dmgFirst600 单变量**（dodge-avoidance §4 L1）
//
// 状态：**已起草，待用户手工开训**（agent 不得启动训练）。
//
// 立项（Phase 2 §36 验证通过）：dmgFirst600 均值人类 17 vs NN 72~97（4~6×），
//   clean600 85% vs 36~52%，600t 固定窗无存活时长混杂（NN 早死局窗口更短还更差，
//   反向偏置下依然显著）。开局零承伤不需要少打，只需要别站在弹道上——与全局保守不混淆。
//
// 单变量纯度：与 x20-noexplore **逐字相同**，只加公式尾项 `- wOpen*dmgFirst600` +
//   `wOpen` 参数（reward 进血缘是正确的）。注意 base 已有 `-wDmg*playerDamageTaken`
//  （含开局窗承伤），本项是**开局窗双倍定价**（wOpen 与 wDmg 同量纲：开局每滴血 2×），
//   不是新维度——单变量成立。采样 49152（mb 对齐）/ mb 1024 / lr / epochs /
//   gamma / lam / schedule / seed_rotate 全同。
//
// 剂量梯（plan §3 输出#2规则：没有剂量梯不开腿；单次只升一档重试，§4 剂量重试）：
//   wOpen=0.01 起（典型局 −0.85 ≈ 0.3杀，量纲锚内）/ 中档 0.02 / 上限 0.03。
//   人类锚点：前 300t 62/62 零承伤，前 1000t p90=128。
//
// 起点：noexplore 最优 it105（`x20-noexplore.it105`），纯 warm start，`kickstart_ref=false`
//   （noexplore 到 it105 时 kk≈0；绕开事故 §5 kk=1 复活禁令）。
//   comparator = noexplore 同绝对 it 点历史（run 内 itN = 绝对 it105+N；历史臂已封存）。
//   配对：`paired_rotate_seed` 与 noexplore 同值 ⇒ 续跑种子流逐轮相同（无 demo 参与，
//   414000 无污染，判决主段 = 414000）。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据
// ══════════════════════════════════════════════════════════════════════════
// **主读数顺序写死：机制先行**（plan §8 链条）：① clean600% + dmgFirst600 分布是否上移
//   （日常 eval 自带，无需 resim）② low% 是否跟随下移 ③ 顶部死亡占比
//   （`tmp/topdeath/deathpos.ts`，基线 26.5%）。
//   it40 只记录、不停腿（it40 误杀门已废）。
// **门**：414000 段 `low% 相对 noexplore 同 it 点改善 ≥3pp` 且 `p10 ≥ 2`
//   （noexplore it105 段值 33.0/8.33/p2）。
// **约束（只记录 + 人工盯盘决策，不自动停）**：日常 mean < 6.19；超时 >5%；
//   kl 连续 3 轮 ≥0.075；保守陷阱（cells/move/pass 任一显著下降）。
// **回测门**：终点候选 415000 不劣于 noexplore 同 it 点（同段同种子配对）。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行）
// ══════════════════════════════════════════════════════════════════════════
//   · **专属死刑（比横盘更早）**：clean600% + dmgFirst600 分布连续 3 个 eval 点不动
//     ⇒ 停腿（信号没进去，后面免谈）。
//   · **上/下限**：mean < 6.19 或 timeout >5% ⇒ 人工决策停。
//   · **机械横盘**：low% 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮。
//   · B1 分支预注册：T2/T3（clean600/dmg600）动 + low% 不动 ⇒ 下一腿 state-init，
//     本腿按达标归档（过程改善≠失败）。

{
  "version": 5,
  "name": "x20-dodge-l1",
  "mode": "per-tick",
  // 环境不变：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：noexplore 原公式 + ★开局窗双倍定价 ─────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected - wApproach * where(pickupDist < 0, 0, pickupDist) - wOpen * dmgFirst600",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.0,
      "wPickup": 3.0,
      "wApproach": 0.008,
      "wOpen": 0.01
    },
    // dense-only（与父腿一致）：terminal 空表合法。
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：noexplore 最优 it105，纯 warm start ──────────────────────────────
  "bc": "nn-training/weights/x20-noexplore/x20-noexplore.it105.20260922-053620.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  // ── 配对：续 noexplore 的种子流（1789876303）────────────────────────────────
  // run 内 itN 吃 noexplore 绝对 it105+N 的种子 ⇒ 与历史臂逐轮同 batch。⚠ 改它 = 非配对。
  "paired_rotate_seed": 1789876303,

  // ── 预算 ───────────────────────────────────────────────────────────────
  "iters": 300,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：回基线（与 noexplore 一致）────────────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：mb 对齐（与 firstkill/terminal 同标准）────────────────────────────
  // 49152 = 48 × mb(1024)；per-stage quota = 12288 = 12 × mb ⇒ 无 ragged tail。
  "target_transitions": 49152,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/x20-dodge-l1/weights.json",
  "traj": "tmp/x20-dodge-l1",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-dodge-l1",
  "backup_prefix": "x20-dodge-l1",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① bc 文件存在（noexplore it105）。
// ② 公式编译验证（validate_reward 零错误零警告；开训后首轮 PPO 日志确认 reward
//    指纹已变——wOpen 进血缘是正确的）。
// ③ metrics v8 代码已部署到训练/评估全链路（本地 + 云节点重推；旧节点产 41 列会
//    被行宽断言响亮拒绝——开训前确认 worker 心跳 + metrics_version=8 首包）。
//    ⚠ 云节点仍跑 pre-v8 代码之日，本腿不开（Phase 2 已证云 eval v8 字段全 0）。
// ④ 新 out/traj 目录（禁续跑，§15.5）。
// ⑤ remote_hubs 登记 + slot 容量 + worker 心跳（开训前确认）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it0/it5…（860001 段 400 局）clean600%/dmg600 分布/low%/mean/p10 +
//   与 noexplore 同绝对 it 点配对对照表（机制读数永远先于 low% 看）。
// · 机制读数：`tmp/topdeath/deathpos.ts`（顶部死亡占比，基线 27.0% 实测）。
//
// ── 结算节（跑完回填）────────────────────────────────────────────────────
// 必填：① clean600%/dmg600 it0 → 终点 + 配对对照 ② low% 是否跟随 ③ 414000 主段 +
//   415000 回测（800 局）④ 分关表 ⑤ 顶部死亡占比 ⑥ 超时/换血读数 ⑦ 实际轮数与耗时
//
// ── 结算（2026-09-25 回填：it1–300 跑满 08:56→14:39 ~5.7h，门控补测同日）──
// ① 机制（日常，历史臂 pre-v8 无 dmg 字段、无配对基线，只能看腿内）：it0 真基线 52.5%/71.0
//    （n=200 bc；此前误用被污染的 53.0%/68.5，见⑦）→ it300 51.0%/68.9（Δ−1.5pp/−2.1，
//    噪声），零进展；唯一亮带 it55~65（clean 58~62% /
//    dmg 58~61），未维持；it275 全程最差（42.2%/85.5）。judge 行无 v8 列，门控段机制不可测。
// ② 日常 low：it0 真基线 40.0/7.64（n=200 bc；此前误用被污染的 34.0/8.16，见⑦）
//    → it300 33.8/8.09（Δ−6.2pp 日常；门控段全灭，判负不变）；配对段（≤run75/abs180）
//    仅 it55/60/65 显著（−10.0/−7.3/−9.2pp），且恰与机制亮带同窗；run80 后无对照裸奔，
//    it255 low 28.5%（全程最低）但机制脱钩（55.0%/63.5）不认。
// ③ 414000 主段（800局/权重，单命令 4 权重同 seed0 ⇒ 跨权重同种子配对；noex-it105 复测
//    33.0/8.33/p2/win18.1，与档案逐字吻合）：it60 32.9/8.52/p2（−0.1pp）·
//    it105 37.8/7.54/p2（+4.8pp，McNemar 177/139 p≈0.04 显著更差）· it255 34.2/8.21/p2
//    （+1.2pp）· it285 32.8/8.55/p2（−0.2pp）。**门（−3pp 且 p10≥2）四候选全灭**，最好与对照打平。
// ④ 415000 回测（同口径；noex-it105 36.9/7.44/p1）：it60 31.2/8.05/p2（−5.6pp p=0.015）·
//    it255 31.1/8.66/p2（−5.7pp p=0.016）· it285 36.1/7.93/p2（−0.8pp）·
//    it105 37.4/7.26/p1（+0.5pp）。回测门 it60/it255 过，其余边缘不劣。
// ⑤ 分关：门控段无单关亮点（it60/it285 与对照逐关打平；日常 it300 s2002 偏好 25% 其余 34~38%）。
// ⑥ 超时/换血：两段超时全 0；playerDamageTaken/局 it0 249 → it300 243（全局换血亦不动）。
// ⑦ 实际：it1–300；09:39 在线 kind=iter 两次 ABORT（节点缺 bun，ProtocolError）后转离线跑满
//    （offline_result it_end=300）；约束全绿（mean≥7.35、kl≤0.016、ent 无塌、cells 无塌）。
//    judge+backtest 各 3200 局，脚本内部分布式（self/mac/a95/a97）+本地池并行，两段串行避抢 CPU。
//    infra bug（2026-09-25 追查）：eval_log it0 400局 = 200局 bc真基线（11ac，40.0/7.64）+
//    200局 it43 权重误标 it0（bf27，28.0/8.69；10:42 重启时 it0 重评估读了 live 权重文件）。
//    L3 同源（混入 it51 f8ab）。污染仅 it0，其余 iter 单 wver 干净；门控 verdict 不受影响。
// 判语：**判负**。回测段改善＋主段零改善＝跨段不稳定，开局闪避未习得；B1 不触发（短暂联动后
//    双双回落 ≠ T2/T3动+low不动）；下一步按剂量梯升 wOpen=0.02（§4 剂量重试）。
// 数据：`tmp/x20-dodge-l1/settle/judge-414000.jsonl` + `backtest-415000.jsonl`（.run/spec 同目录）。
