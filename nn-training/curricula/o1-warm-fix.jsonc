    {
      "kl_coef": 0.02,
      "lr": 0.0005,
      "kl_cap": 0.2,
      "ent_coef": 0.03,
    },
  ],
  "target_transitions": 24576,
  "paired_rotate_seed": 20261108,
  "decision_events": false,
  "decision_k": 10,
  "out": "tmp/o1-warm-fix/weights.json",
