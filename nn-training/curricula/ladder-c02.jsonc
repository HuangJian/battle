{
  "version": 5,
  "name": "ladder-c02",
  "mode": "per-tick",
  "level": "ladder-c02",
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits + wWin*where(clearTick>=0, 1, 0)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.3,
      "wWin": 2.0,
    },
    "terminal": {
      "lives_exhausted": -1.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "nn-training/weights/ladder-c02-bc/bc-latest.json",
  "iters": 60,
  "max_hours": 12,
  "workers": 8,
  "kickstart_ref": true,
  "warmup_iters": 0,
  "lr": 0.00015,
  "epochs": 4,
  "mb": 512,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "until_iter": 40,
      "kl_coef": 0.2,
      "lr": 0.00015,
      "kl_cap": 0.2,
    },
    {
      "kl_coef": 0.03,
      "lr": 5e-5,
    },
  ],
  "out": "tmp/ladder-c02/weights.json",
  "traj": "tmp/ladder-c02",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/ladder-c02",
  "backup_prefix": "ladder-c02",
  "eval_stages": "2000-2005",
  "eval_games_per_stage": 200,
  "eval_every": 5,
  "seed_rotate": 600,
}
