// 课程 x23-cm2 —— commitment 整形臂之二：+wStop（停着瞄准，人类仿生项），单项单臂。
//
// 立项 → bundle 拆分（见 cm1 头注）。本臂唯一改动（相对 cm0）：
//   公式 +wStop*stopTicks/(ticks+1)，wStop=2.0（stopTicks=无移动输出拍累计 col54；
//   人类"停着打" 33% tick 的仿生项——停着瞄准开火，不是发呆；想动被挡计 idle 不计 stop，正交）。
// 先验最看好的一项（人类对齐证据 experiments §71：停/射术双缺口）；风险：蹲坑挨打 ⇒ hurtR 方向诊断盯。
// 其余：起点 KR10-it150（sha `a683e5da…`，本课 it0 + in-use 备份同源）/ iters 0（手工停课，
//   终判四臂停齐同一 iter）/ 新流 20261015 / K=10 / 守卫全关 + 人盯盘 / target 24576/est 147。
// 终判沿用 §5 表（N=1600，同种子四臂全配对；方向诊断 acc + stop 率）。
{
  "version": 5,
  "name": "x23-cm2",
  "mode": "per-tick",
  "level": "ladder-c20-lives1",

  "reward": {
    "formula": "wKill*kills + wHit*aimHits - wDmg*playerDamageTaken - wMiss*aimMisses + wPickup*powerUpsCollected - wApproach*where(pickupDist<0, 0, pickupDist) + wAcc*aimHits/(playerShots+1) + wDist*aimHitDistSum/(aimHits+1) - wHurt*hurtWeight/(ticks+1) - wEncl*enclWeightTicks/(ticks+1) - wCorner*cornerWeightTicks/(ticks+1) + wStop*stopTicks/(ticks+1)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wMiss": 0.158,
      "wPickup": 3.0,
      "wApproach": 0.008,
      "wAcc": 15.3,
      "wDist": 0.738,
      "wHurt": 110.0,
      "wEncl": 8.6,
      "wCorner": 25.0,
      "wStop": 2.0
    },
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  "bc": "nn-training/weights/x23-cm2/x23-cm2.it0.json",
  "kickstart_ref": true,
  "kickstart_init": 0.1,
  "kickstart_burn": { "mode": "baseline", "margin_pp": 100 },
  "warmup_iters": 0,

  "iters": 0,
  "max_hours": 24,
  "workers": 8,

  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  "target_transitions": 24576,
  "est_samples_per_game": 147,
  "seed_rotate": 150,
  "paired_rotate_seed": 20261015,

  "decision_events": false,
  "decision_k": 10,

  "out": "tmp/x23-cm2/weights.json",
  "traj": "tmp/x23-cm2",
  "ent_break": 0,
  "backup_dir": "nn-training/weights/x23-cm2",
  "backup_prefix": "x23-cm2",

  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 结算（2026-10-09 回填：it150 终判点；本课停 it158）──
// it150 日常 400 局对 cm0 同种子配对：0.300 vs 0.280（+2.0pp，χ²cc 0.32，ns；
// pool 1200 局 −4.0pp 负向；it145 出过 −11.75pp 深坑后收回）。方向：stop 0.21% vs 0.006%
// （Δ+0.2pp ≈ 一局 6 tick，行为学零），acc/dmg 全平（蹲坑挨打风险未现）。
// 判语：否决（先验最看好落空；stop 定义或剂量至少其一错），归档不续跑。
// 数据：`tmp/x23-cm2/eval_log.jsonl` · 全文 `docs/nn/experiments.md` §81 ·
// 决策 `DECISIONS.md` §2026-10-09-goalnn-x23cm-verdict。
