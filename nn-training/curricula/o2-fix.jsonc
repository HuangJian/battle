// 课程 o2-fix —— o2 系列第 4 轮（与 `o2-gq` 并行）：截断全歼补偿臂（2026-11-10）
//
// 状态：**已结课 · 已停课**（2026-11-10 16:24，it94）· 结课报告（2026-11-10）
//   A 层最终：275/400 = 68.8%（91/75/51/58）；it80 B/C 800 = **566 = 70.8%**
//   （vs it0 598/800 −4.0pp，p=.065 ns；vs null 518/800 +6.0pp，p=.0066）。
//   判词：**语义修正、非胜率杠杆**。㉓ 只咬 cleared 但 outcome≠stage_clear 的局，暴露面
//   0.5–2.3%（it80 训练侧 0/14），结构上最多值 ~2pp；±6pp 是单跑轨迹差，不归因。
//   ㉓ 保留进后续课程基线（`o2-gqfix` → `o2-gq100`），本课不再续跑。
//   结课档案：`docs/nn/experiments.md §139`；立项/判据见 `plan/o2-gq-and-truncated-clear.plan.md`。
//
// ══════════════════════════════════════════════════════════════════════════
// 0. 一句话
// ══════════════════════════════════════════════════════════════════════════
//   任务侧、22 行奖励、PPO 缰绳、eval 面板**逐字同 o2-fast**；唯一改动 = 公式追加
//   1 行「截断全歼补偿」+ 1 个参数 `wTrunc 40`。o2-fast 是本课的 null。
//
// ══════════════════════════════════════════════════════════════════════════
// 1. 立项依据（本仓实测；细节见 plan §1.1 / §3）
// ══════════════════════════════════════════════════════════════════════════
//   · 语义：全歼后若地上还有存活道具，`checkStageClear` 进 600 tick BONUS TIME；
//     `max_ticks=3000` 可能先截断 ⇒ `outcome=timeout` 但敌人已全灭
//     （`src/game/SimulationEffects.ts:42-51` 原文写明）。
//   · 判决侧：`cleared=1` 算赢（o2-fast eval it90：299 赢 = 292 stage_clear + 7 截断全歼）。
//   · 奖励侧：`terminal[outcome]` 按 timeout 付 **−40**（biz/reward_library.py:972）。
//   · 实测规模（最新语料）：
//       o2-fast it91 rollout：28 个 timeout 里 **7 个 clearTick≥0**（占全部 4.9%），
//         clearTick 中位 2775、击杀 2.00；
//       o2-def it81 rollout：28 里 **7 个**（4.2%），clearTick 中位 2541。
//   · 真式回放（课程 formula + params 逐局实算）：
//       正常 clear **+122.1 / +122.2**；截断全歼 **+61.5 / +57.5**；真拖局 −25.6 / −29.5
//       ⇒ 截断局比正常清关少 60.6 / 64.7 分，其中 **40 分是纯 terminal 误判**，
//         其余是 `wFast=0`（clearTick>2000）与 `pace`（2 杀 × 3000 拍，−21）。
//   · **先例（零新语义）**：`c6-bonus.jsonc:143` 就是同一行
//       `+ wClear*(1.0 if (is_timeout and clearTick >= 0) else 0.0)`，
//     其中 `wClear = 4.0 = terminal[stage_clear] − terminal[timeout]`。本课只是把常数
//     换成 `0 − (−40) = 40`。`is_timeout` 是虚拟 outcome 符号、`clearTick` 是 metrics 列，
//     两者都已在 ⇒ **零代码改动**。
//
// ── 1.1 为什么是 40，不是「补到和正常 clear 一样」──────────────────────────
//   40 = `terminal[stage_clear] − terminal[timeout]`，只把 terminal 归零。
//   修后截断局 ≈ **+101.5 / +97.5**，仍比正常 clear 低 20.6 / 24.7 —— 那部分是
//   `wFast=0` + `pace −21` 的真实速度代价，应该保留（不是白送拖延）。
//
// ── 1.2 为什么不动 max_ticks / 不动全局 terminal ───────────────────────────
//   · `max_ticks` 是终局标准 = 任务侧（AGENTS §0.2 禁动）；抬到 3600 会改掉所有面板口径。
//   · 全局改 `reward_library` 会作废所有历史账本的奖励可比性；虚拟符号就是为
//     「清场但被 max_ticks 截断 ⇒ 按过关补偿」这个用例加的（reward_library.py:286-289）
//     ⇒ 逐课 opt-in。
//
// ── 1.3 身份 ───────────────────────────────────────────────────────────────
//   reward 进 `corpus_identity_fp` ⇒ 与 o2-fast（ecbd26f1…）自动异血缘；
//   `paired_rotate_seed` 20261113（新语料）；**不得跨课续跑**（§15.5）。
//
// ══════════════════════════════════════════════════════════════════════════
// 2. 判据与止损（预注册）
// ══════════════════════════════════════════════════════════════════════════
//   | 主 0 开课前 | 重放三条断言全过（plan §3.1）：7 个截断局各 +40；其余局逐局奖励
//   |             | 逐位不变；clear/gameover 两桶均值移动 <0.1 分 |
//   | 主 1 面板 | it80 B/C：clear ≥ it0（不允许用「多 7 局」当成绩）+ 其余五门同口径不退化 |
//   | 主 2 机制 | timeout 桶里 `clearTick≥0` 的局，其 advantage 不再系统性为负（抽查 per-game）|
//   | 反签名 | clear < it0 −2pp / timeout 上涨 >20% ⇒ 停腿（补偿被当成「拖满也行」）|
//   ✅ 2026-11-10 开课前重放已过（`tmp/o2-fix-assert.mjs` + Python 引擎实算）：
//     o2-fast it91 rollout（144 局）：7 局各 +40，未变局 max|Δ|=0；timeout 桶 −3.86 → +6.14
//     o2-def  it81 rollout（168 局）：7 局各 +40，未变局 max|Δ|=0；timeout 桶 −4.78 → +5.22
//     eval 两份（各 400 局）：0 局变化（eval 导出的 clearTick 只在 stage_clear 写值，符合预期）
//     Python 引擎（生产路径）：同一 3 行矩阵下 timeout 末两样本 [58.0, 16.0] vs wTrunc=0
//       [58.0, −24.0] ⇒ +40 精确落在 clearTick 翻正那一拍；stage_clear 与真拖局逐位不变。
//   ⚠ **面板读数会变**：修后 timeout 桶均值（o2-fast 奖励口径）从 −3.9 抬到 ≈ +6.1
//     （7/28 是截断全歼）⇒ 审计时必须把 timeout 桶拆成 trunc-clear / true-stall 再读
//     （训练 rollout 按 `clearTick≥0`，eval 侧按 `cleared=1`——eval 导出的 clearTick 只在
//     stage_clear 时写值），否则会被误读成「拖局有利」。
//
// ══════════════════════════════════════════════════════════════════════════
// 3. 已知局限 / 风险
// ══════════════════════════════════════════════════════════════════════════
//   ① 只补偿 `is_timeout`，**不补偿** `lives_exhausted && cleared`（清场后在 BONUS 里
//      被打死）：那是真死，不该免罚。实测 it0 800 局 4 局（0.5%）、it90 为 0
//      （`cleared` 非 stage_clear 共 6：2 个 max_ticks + 4 个 gameover）⇒ 只记读数。
//   ② 本课不修「贪心侧墙/卡死的罚分看不见」——那是并行腿 o2-gq 的靶子。
//   ③ 单改奖励不改变优化温度（o2-fast 90 轮方向效率 16%）；若判平，下一腿做加量/降 lr。
//   ④ 4 关定集记忆化（§15.1）：B/C 只用于判决，跨课只用于晋级。
//   ⑤ 与 o1 系列 6000 拍面板不可相减（同 o2-fast §5⑤）。
//
// ══════════════════════════════════════════════════════════════════════════
// 4. 预算 / 开工前置
// ══════════════════════════════════════════════════════════════════════════
//   `target_transitions 24576` / `iters 300` / `max_hours 18` / `eval_every 5` /
//   `eval_games_per_stage 50`（与 null 同预算）。
//   ① bc 冻结归档已存在（it256，见配置段）。
//   ② it0 锚点复用 o2-fast §4.1（面板与奖励无关）：clear .7475 / gameover 158 /
//      timeout 50 / wallMed 17.0 / stuck≥800 35 / clearTicksMed 1804 / dmg/千拍 56.00。
//   ③ 开课前跑 plan §3.1 的三条重放断言，把读数贴回本头注。
//   ④ 控制台 :8900 开课；零 worker 就等，不就地降级；开训 30s 自检 hub URL。
//
// ══════════════════════════════════════════════════════════════════════════
// 以下为配置段：任务侧 / 22 行奖励 / PPO 缰绳 / eval / 预算**逐字继承 o2-fast**；
//   改动点 = 6 个身份键 + 公式追加 ㉓ + 参数 `wTrunc`。判词以本立项说明与 plan 为准。
// ══════════════════════════════════════════════════════════════════════════
//
{
  "version": 5,
  "name": "o2-fix",
  "mode": "per-tick",
  "level": "classic35-safe-base",
  "stage_select": "16,22,3,6",
  "enemies": 2,
  "lives": 1,
  "max_ticks": 3000,
  "reward": {
    "formula": [
      // ① 击杀：每只 18 分（o2-fast §4.3 调参后）
      "wKill*kills",
      // ② 命中：每发 3；空射不单独定价（aimMisses 是 hit 镜像，会重复计价）
      "+ wHit*aimHits",
      // ③ 清关奖：无条件 60 分，但按走过格子打折（runCap 30 打满）
      "+ wWin*where(clearTick>=0, 1, 0)*min(cellsVisited/runCap, 1)",
      // ④ 快清关：清场越早一次性越多（fastCap 2000 拍内线性，>2000 拍为 0）
      "+ wFast*where(clearTick>=0, 1, 0)*max(0, fastCap - clearTick)/fastCap",
      // ⑤ 移动拍：稠密走位奖；顶墙拍计入 idleTicks，所以 ticks-idleTicks 自动排除蹭墙拍
      "+ wMove*min(ticks - idleTicks, moveCap)",
      // ⑥ 开火成本：每发 0.02（几乎免费以鼓励开枪）
      "- wShot*min(playerShots, shotCap)",
      // ⑦ 撞墙（0–40 拍）：有前进意图 + 零位移，1.0/拍
      "- wWall*min(wallPressTicks, wallCap)",
      // ⑧ 撞墙（40–120 拍）：第二段 0.2/拍
      "- wWall2*min(max(0, wallPressTicks - wallCap), wallCap2)",
      // ⑨ 卡死（≤2000 拍）：最长连续「没换格且没打中」，0.01 每拍
      "- wStuck*min(stuckTicks, stuckCap)",
      // ⑩ 卡死（2000 拍以后）：第二段 0.002/拍
      "- wStuck2*min(max(0, stuckTicks - stuckCap), stuckCap2)",
      // ⑪ 不动（超出免费额度的前 1000 拍）：免费额度 = 35% × min(ticks, 1000)
      "- wIdle*min(max(0, idleTicks - idleFree*min(ticks, ticksShouldWin)), idleCap)",
      // ⑫ 不动（继续超出）：第二段 0.005/拍
      "- wIdle2*min(max(0, idleTicks - idleFree*min(ticks, ticksShouldWin) - idleCap), idleCap2)",
      // ⑬ 承伤：每点 0.08；dmgCap 200 = 1 命上限，不会截断
      "- wDmg*min(playerDamageTaken, dmgCap)",
      // ⑭ 掉命：每人头 12；terminal 另有 −30
      "- wDeath*playerDeaths",
      // ⑮ 待在敌方射界（0–120 拍）：每拍 0.02 —— 满血时允许激进
      "- wThreat*min(threatTicks, threatCap)",
      // ⑯ 待在敌方射界（120–500 拍）：第二段 0.005 每拍
      "- wThreat2*min(max(0, threatTicks - threatCap), threatCap2)",
      // ⑰ 射界里仍在移动：每拍 0.05 —— 躲弹动作的正奖，与 ⑮⑯ 配对
      "+ wLaneMove*min(onLaneMoveTicks, laneCap)",
      // ⑱ 残血别浪（0–100 拍）：低血量拍 0.3/拍
      "- wDanger*min(dangerTicks, dangerCap)",
      // ⑲ 残血别浪（100–600 拍）：第二段 0.05/拍
      "- wDanger2*min(max(0, dangerTicks - dangerCap), dangerCap2)",
      // ⑳ 基地威胁税（0–200 压力点）
      "- wBasePressure*min(basePressureSum, basePressureCap)",
      // ㉑ 基地威胁税（200–500）：第二段 0.03/点
      "- wBasePressure2*min(max(0, basePressureSum - basePressureCap), basePressureCap2)",
      // ㉒ 反苟：按拍计费（每杀赠 1000 拍，窗口 800）
      "- min(paceCap, wPace*max(0, ticks - kills*paceTicks)/paceWindow)",
      // ㉓ 截断全歼补偿（本课唯一改动）：全歼后因 600 tick BONUS TIME 被 max_ticks 截断的局，
      //    判决侧已算赢（cleared=1），terminal 却付 timeout −40 ⇒ 在此对冲。
      //    Φ 差分下只在 clearTick 翻正那一拍产生 +40（不是每拍），等价于把 terminal 归零；
      //    速度仍由 wFast / pace 定价（wTrunc 不是「补到和正常清关一样」，见 §1.1）。
      //    与 c6-bonus.jsonc:143 的 `(1.0 if (is_timeout and clearTick >= 0) else 0.0)` 逐值等价；
      //    这里用 `where` 形式是为了让只读审计脚本（JS）也能实算同一份公式。
      "+ wTrunc*where(clearTick>=0, 1, 0)*is_timeout",
    ],
    "params": {
      "wKill": 18.0,
      "wHit": 3.0,
      "wWin": 60.0,
      "runCap": 30.0,
      "wFast": 24.0,
      "fastCap": 2000.0,
      "wMove": 0.03,
      "moveCap": 1600.0,
      "wShot": 0.02,
      "shotCap": 120.0,
      "wWall": 1.0,
      "wallCap": 40.0,
      "wWall2": 0.2,
      "wallCap2": 80.0,
      "wStuck": 0.01,
      "stuckCap": 2000.0,
      "wStuck2": 0.002,
      "stuckCap2": 4000.0,
      "wIdle": 0.01,
      "idleCap": 1000.0,
      "idleFree": 0.35,
      "ticksShouldWin": 1000.0,
      "wIdle2": 0.005,
      "idleCap2": 5000.0,
      "wDmg": 0.08,
      "dmgCap": 200.0,
      "wDeath": 12.0,
      "wThreat": 0.02,
      "threatCap": 120.0,
      "wThreat2": 0.005,
      "threatCap2": 380.0,
      "wDanger": 0.3,
      "dangerCap": 100.0,
      "wDanger2": 0.05,
      "dangerCap2": 500.0,
      "wBasePressure": 0.15,
      "basePressureCap": 200.0,
      "wBasePressure2": 0.03,
      "basePressureCap2": 300.0,
      "wLaneMove": 0.05,
      "laneCap": 200.0,
      "wPace": 8.0,
      "paceTicks": 1000.0,
      "paceWindow": 800.0,
      "paceCap": 46.0,
      // 截断全歼补偿：= terminal[stage_clear] − terminal[timeout] = 0 − (−40)
      "wTrunc": 40.0,
    },
    "terminal": {
      "stage_clear": 0.0,
      "lives_exhausted": -30.0,
      "base_destroyed": -35.0,
      "timeout": -40.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "nn-training/weights/o1-gq-fast/o1-gq-fast.it256.20261110-073346.json",
  "kickstart_ref": true,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 300,
  "max_hours": 18,
  "lr": 0.0005,
  "epochs": 6,
  "mb": 1024,
  "normalize_ret": false,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "kl_coef": 0.02,
      "lr": 0.0005,
      "kl_cap": 0.2,
      "ent_coef": 0.03,
    },
  ],
  "target_transitions": 24576,
  "paired_rotate_seed": 20261113,
  "decision_events": false,
  "decision_k": 10,
  "out": "tmp/o2-fix/weights.json",
  "traj": "tmp/o2-fix",
  "breakers_off": false,
  "ent_break": 0.25,
  "ent_break_max_winrate": 0.0,
  "backup_dir": "nn-training/weights/o2-fix",
  "backup_prefix": "o2-fix",
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5,
}

// ── 诊断工具 / 复现 ────────────────────────────────────────────────────────
//  重放三条断言（开课前，plan §3.1；不训练）：
//    扩 `tmp/o2-reward-decomp.mjs` 支持 wTrunc 后，对
//    `tmp/o2-analysis/o2-fast-it91-rollout.json` / `o2-def-it81-rollout.json` /
//    两份 `*-eval-it*.jsonl` 跑；断言见 head §2「主 0」。
//  B/C 判决面板（3000 拍，默认 dist；null 同 panels 都要跑）：
//    `bun tools/sim/eval-course-ckpt.ts --course tmp/o1-probe/o2-env-course.json
//     --weights o2-fast.it80=<...> o2-fix.it80=<...> --games 800 --seed0 860001 --out <jsonl>`
//  取数：`tmp/o2-verdict.mjs --file <jsonl> --labels <...> --weights <...>`
