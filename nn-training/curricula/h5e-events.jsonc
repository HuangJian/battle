// 课程 h5e-events —— **新纪元事件 rung：x5 关 + threat-ONSET 事件门**（plan §6 R2）
//
// 状态：**草稿，待用户手工开训**（agent 不得启动训练）。
//
// 立项：R2 包落地的第一条事件腿。与 h5-stop（均匀 K）**同起点、同配方、同预算**并行，
//   唯一变量 = 决策门（均匀 K ∪ threat-ONSET 沿 + Δt≥3）。回答"事件驱动在 x5 有没有边际"。
//   若事件无边际（avg-Δt≈10 且 low% 与 h5 同带），defer 事件到 c20 再议，不在 x5 加量。
//
// 配方（= x1-a2 v4 包逐字，与 h5-stop 一致）：
//   wKill 3.0 / wHit 0.6 / wWin 2.0 / wDmg 0.03 / wShot 0.05 / wExplore 0.2
//   + terminal lives_exhausted −5.0 / timeout −2.0。
// 位移包：lr 0.0005 / epochs 6 / mb 512 / kl 0.02（25 轮）→0.01（x4 同形）。
//
// 起点：h4 冠军 warm start（与 h5-stop **同一起点**，对照干净），`kickstart_ref=true`。
//   comparator = h5-stop 同 it 趋势 + 本 rung 绝对门（跨 rung/跨纪元不配对）。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据（x5 rung 绝对数门，与 h5-stop 同门 + 事件读数）
// ══════════════════════════════════════════════════════════════════════════
// **门**：日常段（860001，单关 200 局）`pass ≥ 80%` 且 `dmg/局 ≤ 80` 且 `零伤通关 ≥ 30%`。
// **机制链**：① stopPickRate ② threat 带占比 ③ **事件读数**（avg-Δt 显著 <10 且 events>0；
//   若 avg-Δt≈10 全程 ⇒ 事件从未进场，等于白跑均匀腿，直接判"事件无边际"停腿）
//   ④ pass/dmg 跟随。
// **约束**：超时 >5% ⇒ 人工决策停；kl 连续 3 轮 ≥0.075 ⇒ 记录 + 人工盯盘；
//   ent 跌破 0.25 ⇒ break；Δt<3 出现 ⇒ 实现 bug（最小间隔闸不变式，停腿修实现）。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行）
// ══════════════════════════════════════════════════════════════════════════
//   · **专属死刑**：stopPickRate 连续 3 个 eval 点 < 10/千tick（前置：探针链通；梯子豁免——
//     只观测不执行）⇒ 记录，不停腿。
//   · **机械横盘**：pass/dmg 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮，不得二次宽限。
//   · **事件无边际死刑**：连续 3 个 eval 点 avg-Δt ≥ 9.9 且 events≈0 ⇒ 停腿（事件没进场，
//     等于白跑均匀腿；转回 h5 主臂，不另开对照）。
//   · B0/B1/B3/B4 按 plan §8（B2 不适用本腿——本腿就是事件腿）。

{
  "version": 5,
  "name": "h5e-events",
  "mode": "per-tick",
  // 环境：ladder-c05（单关 20 敌）。任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c05",

  // ── 奖励：x1-a2 v4 包逐字（与 h5-stop 一致）─────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits + wWin*where(clearTick>=0, 1, 0) - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wWin": 2.0,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.2
    },
    "terminal": {
      "lives_exhausted": -5.0,
      "timeout": -2.0
    },
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：h4 冠军 warm start（与 h5-stop 同一起点）────────────────────────
  "bc": "nn-training/weights/h4-stop-best/h4-stop.it60.best.json",
  "kickstart_ref": true,
  "warmup_iters": 0,

  // ── 事件门（§6 R2）：本腿唯一变量 ────────────────────────────────────────
  "decision_events": true,

  // ── 预算（h5 主臂同形；事件问题回答得早，100 轮封顶）─────────────────────
  "iters": 100,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包 ─────────────────────────────────────────────────────────────
  "lr": 0.0005,
  "epochs": 6,
  "mb": 512,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "until_iter": 25, "kl_coef": 0.02, "lr": 0.0005, "kl_cap": 0.2 },
    { "kl_coef": 0.01, "lr": 0.00025 }
  ],

  // ── 采集 ───────────────────────────────────────────────────────────────
  "target_transitions": 24000,
  "est_samples_per_game": 180,
  "seed_rotate": 600,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/h5e-events/weights.json",
  "traj": "tmp/h5e-events",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/h5e-events",
  "backup_prefix": "h5e-events",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2000",
  "eval_games_per_stage": 200,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① h4 冠军存在（h4-stop.it60.best.json，已验，见下验证行）。
// ② 公式编译验证（validate_reward；与 v4 逐字同是正确原因）。
// ③ 接线验证：课程 decision_events=True ⇒ args 含键 ⇒ rollout 命令带旗 ⇒
//    节点门（无位拒派）⇒ eval 两条腿（in-loop + 手动）同语义（本轮接线工作已做，见下）。
// ④ 新 out/traj 目录（禁续跑）。⑤ 节点心跳（事件任务只派新 bundle 节点；旧节点响亮拒派）。
// ⑥ paired-kill 默认关（opt-in）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台开课；与 h5-stop 并行，GPU 双课程）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：同 h5-stop 口径 + avg-Δt/events（事件读数，flag 开才有）。
// · transfer 探针：`tmp/h4xfer/h5.jsonl`（h4-it60 零射 56.5%/162/13.5%，200 局）。
//
// ── 结算节（跑完回填）──────────────────────────────────────────────────────
// 必填：① pass/dmg it0 → 终点 ② stopPickRate ③ avg-Δt/events 是否进场
//   ④ 超时/换血 ⑤ 实际轮数与耗时 ⑥ 判语（过门⇒ h6（事件保留与否按本腿结论定）；
//   事件无边际 ⇒ 停，转回 h5 主臂；idle 平 ⇒ B2 已在本腿，无处可去，记结论）。
//
// ── 结算（2026-09-28 回填：it1–81，用户手工停腿；日常到 it80）──
// ① 日常（860001，单关 200 局）：it0 66.5%/150.9/零伤16.5% → it30 69.0%/136.5/23.5%（峰）
//    → it80 65.0%/144.9/17.0%。门（80/80/30%）全灭。趋势 it35→80 斜率 −0.14pp/iter，
//    −2pp（z=−0.42）→ 横盘成立。
// ② STOP 全程 0。③ 事件（it78–81 shard manifest 直读）：0.84/0.82/0.79/0.75 次/局，
//    加权 avgDt 9.96 vs 均匀 10，minDt≥3 恒成立（实现无 bug），处理量 ~0.5%。
//    事件无边际死刑按字面成立。
// ④ 超时仅 it65 一局（0.5%）；cells 63.2→63.9；PPO 健康（kl_max 0.025、ent_min 0.46）。
// ⑤ 实际：it1–81（09-27 22:20 → 09-28 上午，~10h；预算 100/12h）。
// 判语：判负＋事件无边际（结构性）。名义终点 it30。转回 h5 主臂无意义（主臂同判负）→
//    合并判「事件/价格在 c05 无效」。c20 同样没资格（R2 基线 1~4 次/局）。
//    数据：`tmp/h5e-events/eval_log.jsonl`（it0/5/…/80）。
