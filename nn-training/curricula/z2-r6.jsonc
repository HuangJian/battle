// 课程 z2-r6 —— 第 6 级（终点）：**经典 35 关原题**（2026-10-28）
//
// ── 本级不做任何覆盖 ───────────────────────────────────────────────────
//   `level: classic35` 原样：35 关 · 20 敌 · 3 命 · hard · max_ticks 36000。
//   `stage_select` / `enemies` / `lives` 一个都不写 ⇒ 这一级就是「任务侧」本身，
//   与浏览器里玩到的经典 35 关逐格同源（level 文件头有 sha 校验说明）。
//   起点 = `tmp/z2-r5/weights.json`。
//
// ── 与 r5 的差 = 纯泛化 ────────────────────────────────────────────────
//   r5 已经在 4 图上跑完整兵力；本级只把关集换成 35 张。若 r5 能清关而本级清关率塌，
//   结论是「背地图」而不是「没学会打」——这正是 z0 单关臂与四关臂当年想回答的问题。
//
// ── 判据 ───────────────────────────────────────────────────────────────
//   · 主：`eval_stages 2000-2034`（35 关 × 20 局）clearRate 与 zero_kill_frac；
//   · 副：分关 clearRate（`eval_log` 的 per-game `eval` 行可按 stage 聚合）——四关平均会掩盖单关崩；
//   · 停腿：100 轮内 clearRate 始终 0 ⇒ 停，回到 r5 查分关读数。

// ── 奖励：全阶梯逐字相同 ────────────────────────────────────────────────
//   +15*kills +60*clear +3*wallIntact -0.12*dmg -18*death -8*pace +0.25*min(bricks,12)
//   反苟：墙价（丢一圈 -24）+ pace（没击杀按拍计费，封顶 8）+ **无移动/探索项**。
//   反莽：命价 18 > 一杀 15、血价 0.12/HP、墙价让「冲出去丢基地」也亏；三输 -35。
//   汇率账与算例（完胜 +76 / 苟 -63 / 莽 -59）→ docs/nn/training-stack.md §50.3。
//
// ── 晋级 / 停腿 ─────────────────────────────────────────────────────────
//   · 晋级下一级：in-loop eval **连续 2 个评估点** clearRate ≥ 50% 且 zero_kill_frac ≤ 0.10。
//   · 停腿：40 轮内 clearRate 始终 0 ⇒ 停，**先查任务侧再谈奖励**（§50.4 的 commander floor）。
//   · it0 的 greedy 是恒定动作（近均匀初始化的正常形态），判据从 it20+ 读。

{
  "version": 5,
  "name": "z2-r6",
  "mode": "per-tick",
  "level": "classic35",
  "reward": {
    "formula": "wKill*kills + wWin*where(clearTick>=0, 1, 0) + wBase*baseWallIntact - wDmg*playerDamageTaken - wDeath*playerDeaths - wPace*max(0, 1 - kills*paceTicks/(ticks+paceTicks)) + wBrick*min(aimBricks, brickCap)",
    "params": {
      "wKill": 15.0,
      "wWin": 60.0,
      "wBase": 3.0,
      "wDmg": 0.12,
      "wDeath": 18.0,
      "wPace": 8.0,
      "paceTicks": 350.0,
      "wBrick": 0.25,
      "brickCap": 12.0,
    },
    "terminal": {
      "timeout": -35.0,
      "lives_exhausted": -35.0,
      "base_destroyed": -35.0,
      "stage_clear": 0.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "tmp/z2-r5/weights.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 300,
  "max_hours": 60.0,
  "lr": 0.00012,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": false,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "kl_coef": 0.05,
      "lr": 0.00012,
      "kl_cap": 0.1,
    },
  ],
  "target_transitions": 49152,
  "paired_rotate_seed": 20261028,
  "decision_events": false,
  "decision_k": 10,
  "out": "tmp/z2-r6/weights.json",
  "traj": "tmp/z2-r6",
  "ent_break": 0.0,
  "ent_break_max_winrate": 0.0,
  "backup_dir": "nn-training/weights/z2-r6",
  "backup_prefix": "z2-r6",
  "eval_stages": "2000-2034",
  "eval_games_per_stage": 20,
  "eval_every": 10,
}
