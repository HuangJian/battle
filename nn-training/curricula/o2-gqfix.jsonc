// 课程 o2-gqfix —— o2 系列第 5 轮（与 `o2-gq` 并行）：greedy 混采 + 截断全歼补偿的组合臂（2026-11-10）
//
// 状态：**已结课 · 已停课**（2026-11-10 20:41，it113；反签名触发）· 结课报告（2026-11-10）
//   A 层最终：291/400 = 72.8%（81/77/62/71）；it80 B/C 800 = **550 = 68.8%**
//   （vs gq80 691/800 **−17.6pp**，56/197 翻转，p=1.4e-19；vs it0 598/800 −6.0pp，p=.0077）。
//   判词：**FAIL · run 级坏盆地，不归因于 ㉓**。it80 判决局 timeout=0、截断=0 ⇒ ㉓ 惰性；
//   49 个零杀拖局拿不到 +40。同点 A 层：shots 12.0 vs gq 17.4、零杀 14.8% vs 4.8%、
//   gameover 52 vs 29、stop 48% vs 40% ⇒ 与 null 同形的苟盆地（不是墙、不是早死）。
//   ㉓ 保留为公式语义修正；后续由 `o2-gq100`（热启动 + 18% greedy + 三行 shaping）接力。
//   结课档案：`docs/nn/experiments.md §139`；产物 `tmp/o2-analysis/bc-gqfix80.jsonl`。
// 计划：`plan/o2-gq-and-truncated-clear.plan.md`
//
// ══════════════════════════════════════════════════════════════════════════
// 0. 一句话
// ══════════════════════════════════════════════════════════════════════════
//   = o2-gq 的全部 + ㉓（截断全歼补偿）。对 `o2-gq` **只差 ㉓ 一行**；对 `o2-fix`
//   **只差 greedy 混采**。目的：把语义修正并入胜率腿，并用 gq 作为 ㉓ 的对照隔离其增量。
//
// ══════════════════════════════════════════════════════════════════════════
// 1. 立项依据（2026-11-10 16:15，B/C 800 局 / seed0 860001 / 同 seed 配对）
// ══════════════════════════════════════════════════════════════════════════
//   it80 检查点（产物 `tmp/o2-analysis/bc-it80.jsonl`）：
//     | 臂 | clear | vs it0 | vs null |
//     | it0（bc it256） | 598/800 = 74.8% | — | — |
//     | o2-fast（null） | 518/800 = 64.8% | −10.0pp | — |
//     | o2-gq | 691/800 = **86.4%** | +11.6pp | +21.6pp（p<1e-6）|
//     | o2-fix | 566/800 = 70.8% | −4.0pp（ns）| +6.0pp（p=.0066）|
//   · o2-gq 的机制**不是**修顶墙（wall/千拍 14.5 vs null 10.7，反而升）；真正变化 =
//     shots 16.6（null 12.0）、kills 1.80（1.44）、dmg/千拍 50.9（92.2）、零杀局 6.4%（21.3%）。
//   · ㉓ 的直接暴露面只有 0.5–2.3% 的局（it80 B/C 上 gq 4/800、fix 4/800）⇒ 它不可能
//     解释 fix 的 +6pp；结论是「语义修正、非胜率杠杆」，应并入基线而不是单独跑。
//   ⇒ 本课把 ㉓ 并入 gq：既保留正确的终局语义，又不再占一条独立训练腿。
//
// ══════════════════════════════════════════════════════════════════════════
// 2. 判据与止损（预注册；与 `o2-gq` 同 it 配对，B/C 800 局）
// ══════════════════════════════════════════════════════════════════════════
//   | 主 0 非劣 | 同 it 配对 clear ≥ o2-gq − 1pp | ㉓ 是语义修正，不应掉点 |
//   | 主 1 收益 | 若 clear > o2-gq + 2pp（p<0.05）⇒ 记 ㉓ 的独立正贡献 | 允许但不下预期 |
//   | 主 2 不换命 | timeout ≤ o2-gq × 1.1；dmg/千拍 ≤ ×1.1；idle ≤ +5pp | |
//   | 反签名 | clear < it0（74.8）或 timeout > 2× o2-gq ⇒ 停腿复盘 | |
//   ⚠ 机制门不设（o2-gq 的教训：wall 门 FAIL 但胜率 +21.6pp，机制门只能当解释）。
//
// ══════════════════════════════════════════════════════════════════════════
// 3. 已知局限 / 风险
// ══════════════════════════════════════════════════════════════════════════
//   ① 两臂（gq / gqfix）并行会互相挤 worker；一臂饿死则读数作废（同 o2-fast §6④）。
//   ② 单跑归因：㉓ 的增量只在同 it 配对里读；跨课绝对值不做「谁更强」的结论。
//   ③ greedy 数据是确定性的（exploit 不是 explore）；比例仍 12%，不加量以保持与 gq 单变量。
//   ④ 本课**不**修「wall 定价」——那需要另立（o2-gq 显示赢家墙罚更高）。
//   ⑤ 4 关定集记忆化（§15.1）：B/C 只用于判决，跨课只用于晋级。
//
// ══════════════════════════════════════════════════════════════════════════
// 4. 预算 / 开工前置
// ══════════════════════════════════════════════════════════════════════════
//   `target_transitions 24576` / `iters 300` / `max_hours 18` / `eval_every 5` /
//   `eval_games_per_stage 50`（与 gq 同预算）。
//   ① bc 冻结归档已存在（it256）。
//   ② it0 锚点复用 o2-fast §4.1：clear .7475 / gameover 158 / timeout 50 / wallMed 17.0。
//   ③ 控制台 :8900 开课；零 worker 就等，不就地降级。
//   ④ 首轮看 `greedy_quota_stats.prefilter.kept_samples`（应在 2950–4000）与
//      `per_stage_bin_kept`（loss/timeout 档可能被 win 挤掉，属 shard 粒度）。
//
// ══════════════════════════════════════════════════════════════════════════
// 以下为配置段：任务侧 / 23 行奖励（22 + ㉓）/ PPO 缰绳 / eval / 预算继承 o2-gq；
//   改动点 = 6 个身份键 + ㉓ 一行 + `wTrunc`。判词以本立项说明与 plan 为准。
// ══════════════════════════════════════════════════════════════════════════
//
{
  "version": 5,
  "name": "o2-gqfix",
  "mode": "per-tick",
  "level": "classic35-safe-base",
  "stage_select": "16,22,3,6",
  "enemies": 2,
  "lives": 1,
  "max_ticks": 3000,
  "reward": {
    "formula": [
      // ① 击杀：每只 18 分（o2-fast §4.3 调参后）
      "wKill*kills",
      // ② 命中：每发 3；空射不单独定价（aimMisses 是 hit 镜像，会重复计价）
      "+ wHit*aimHits",
      // ③ 清关奖：无条件 60 分，但按走过格子打折（runCap 30 打满）
      "+ wWin*where(clearTick>=0, 1, 0)*min(cellsVisited/runCap, 1)",
      // ④ 快清关：清场越早一次性越多（fastCap 2000 拍内线性，>2000 拍为 0）
      "+ wFast*where(clearTick>=0, 1, 0)*max(0, fastCap - clearTick)/fastCap",
      // ⑤ 移动拍：稠密走位奖；顶墙拍计入 idleTicks，所以 ticks-idleTicks 自动排除蹭墙拍
      "+ wMove*min(ticks - idleTicks, moveCap)",
      // ⑥ 开火成本：每发 0.02（几乎免费以鼓励开枪）
      "- wShot*min(playerShots, shotCap)",
      // ⑦ 撞墙（0–40 拍）：有前进意图 + 零位移，1.0/拍
      "- wWall*min(wallPressTicks, wallCap)",
      // ⑧ 撞墙（40–120 拍）：第二段 0.2/拍
      "- wWall2*min(max(0, wallPressTicks - wallCap), wallCap2)",
      // ⑨ 卡死（≤2000 拍）：最长连续「没换格且没打中」，0.01 每拍
      "- wStuck*min(stuckTicks, stuckCap)",
      // ⑩ 卡死（2000 拍以后）：第二段 0.002/拍
      "- wStuck2*min(max(0, stuckTicks - stuckCap), stuckCap2)",
      // ⑪ 不动（超出免费额度的前 1000 拍）：免费额度 = 35% × min(ticks, 1000)
      "- wIdle*min(max(0, idleTicks - idleFree*min(ticks, ticksShouldWin)), idleCap)",
      // ⑫ 不动（继续超出）：第二段 0.005/拍
      "- wIdle2*min(max(0, idleTicks - idleFree*min(ticks, ticksShouldWin) - idleCap), idleCap2)",
      // ⑬ 承伤：每点 0.08；dmgCap 200 = 1 命上限，不会截断
      "- wDmg*min(playerDamageTaken, dmgCap)",
      // ⑭ 掉命：每人头 12；terminal 另有 −30
      "- wDeath*playerDeaths",
      // ⑮ 待在敌方射界（0–120 拍）：每拍 0.02 —— 满血时允许激进
      "- wThreat*min(threatTicks, threatCap)",
      // ⑯ 待在敌方射界（120–500 拍）：第二段 0.005 每拍
      "- wThreat2*min(max(0, threatTicks - threatCap), threatCap2)",
      // ⑰ 射界里仍在移动：每拍 0.05 —— 躲弹动作的正奖，与 ⑮⑯ 配对
      "+ wLaneMove*min(onLaneMoveTicks, laneCap)",
      // ⑱ 残血别浪（0–100 拍）：低血量拍 0.3/拍
      "- wDanger*min(dangerTicks, dangerCap)",
      // ⑲ 残血别浪（100–600 拍）：第二段 0.05/拍
      "- wDanger2*min(max(0, dangerTicks - dangerCap), dangerCap2)",
      // ⑳ 基地威胁税（0–200 压力点）
      "- wBasePressure*min(basePressureSum, basePressureCap)",
      // ㉑ 基地威胁税（200–500）：第二段 0.03/点
      "- wBasePressure2*min(max(0, basePressureSum - basePressureCap), basePressureCap2)",
      // ㉒ 反苟：按拍计费（每杀赠 1000 拍，窗口 800）
      "- min(paceCap, wPace*max(0, ticks - kills*paceTicks)/paceWindow)",
      // ㉓ 截断全歼补偿（与 o2-fix 同一行、同一常数）：全歼后因 600 tick BONUS TIME 被
      //    max_ticks 截断的局，判决侧已算赢（cleared=1），terminal 却付 timeout −40 ⇒ 对冲。
      //    Φ 差分下只在 clearTick 翻正那一拍产生 +40；速度仍由 wFast / pace 定价。
      "+ wTrunc*where(clearTick>=0, 1, 0)*is_timeout",
    ],
    "params": {
      "wKill": 18.0,
      "wHit": 3.0,
      "wWin": 60.0,
      "runCap": 30.0,
      "wFast": 24.0,
      "fastCap": 2000.0,
      "wMove": 0.03,
      "moveCap": 1600.0,
      "wShot": 0.02,
      "shotCap": 120.0,
      "wWall": 1.0,
      "wallCap": 40.0,
      "wWall2": 0.2,
      "wallCap2": 80.0,
      "wStuck": 0.01,
      "stuckCap": 2000.0,
      "wStuck2": 0.002,
      "stuckCap2": 4000.0,
      "wIdle": 0.01,
      "idleCap": 1000.0,
      "idleFree": 0.35,
      "ticksShouldWin": 1000.0,
      "wIdle2": 0.005,
      "idleCap2": 5000.0,
      "wDmg": 0.08,
      "dmgCap": 200.0,
      "wDeath": 12.0,
      "wThreat": 0.02,
      "threatCap": 120.0,
      "wThreat2": 0.005,
      "threatCap2": 380.0,
      "wDanger": 0.3,
      "dangerCap": 100.0,
      "wDanger2": 0.05,
      "dangerCap2": 500.0,
      "wBasePressure": 0.15,
      "basePressureCap": 200.0,
      "wBasePressure2": 0.03,
      "basePressureCap2": 300.0,
      "wLaneMove": 0.05,
      "laneCap": 200.0,
      "wPace": 8.0,
      "paceTicks": 1000.0,
      "paceWindow": 800.0,
      "paceCap": 46.0,
      // 截断全歼补偿 = terminal[stage_clear] − terminal[timeout] = 0 − (−40)
      "wTrunc": 40.0,
    },
    "terminal": {
      "stage_clear": 0.0,
      "lives_exhausted": -30.0,
      "base_destroyed": -35.0,
      "timeout": -40.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "nn-training/weights/o1-gq-fast/o1-gq-fast.it256.20261110-073346.json",
  "kickstart_ref": true,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 300,
  "max_hours": 18,
  "lr": 0.0005,
  "epochs": 6,
  "mb": 1024,
  "normalize_ret": false,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "kl_coef": 0.02,
      "lr": 0.0005,
      "kl_cap": 0.2,
      "ent_coef": 0.03,
    },
  ],
  "target_transitions": 24576,
  "paired_rotate_seed": 20261114,
  "decision_events": false,
  "decision_k": 10,
  "out": "tmp/o2-gqfix/weights.json",
  "traj": "tmp/o2-gqfix",
  "breakers_off": false,
  "ent_break": 0.25,
  "ent_break_max_winrate": 0.0,
  "backup_dir": "nn-training/weights/o2-gqfix",
  "backup_prefix": "o2-gqfix",
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5,
  // greedy 混采（plan rev4）：三档比例的分母 = 本轮总 transition；和 .12 = 12% 走 argmax。
  // 比例贴近 o2-fast 贪心面板的自然结局分布（.75/.14/.11），不做失败过采（§1.1）。
  "greedy_quota": {
    "win": 0.09,
    "loss": 0.02,
    "timeout": 0.01,
    "oversample_cap": 2.0,
    "soft": true,
  },
}

// ── 诊断工具 / 复现 ────────────────────────────────────────────────────────
//  B/C 判决面板（3000 拍，默认 dist；**null 同 panels 都要跑**）：
//    `bun tools/sim/eval-course-ckpt.ts --course tmp/o1-probe/o2-env-course.json
//     --weights o2-fast.it80=<weights/o2-fast/o2-fast.it80...json>
//               o2-gq.it80=<weights/o2-gq/o2-gq.it80...json>
//     --games 800 --seed0 860001 --out tmp/o2-probe/gq-bc.jsonl`
//  取数：`tmp/o2-verdict.mjs --file <jsonl> --labels <...> --weights <...>`
//  贪心侧过程税：`tmp/o2-reward-decomp.mjs nn-training/curricula/o2-gq.jsonc <eval jsonl>`
