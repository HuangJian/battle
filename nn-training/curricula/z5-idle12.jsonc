// 课程 z5-idle12 —— `z5-safe-base` 的**并行机制腿**：只改 `wIdle 0.05 → 0.12`（2026-11-02）
//
// 状态：**未开课**（预注册；开课由人在控制台走 W4 会话）。
// 与 `z5-safe-base` **逐字相同**（关卡 / 起点 / 采样计划 / eval / 预算 / 其余 22 个奖励参数），
// **唯一差异 = `wIdle` 0.05 → 0.12**（×2.4）。
//
// ══ 为什么挑 idle（数据依据）════════════════════════════════════════════
//   `z4-pick-wall.it205` 在全 35 关安全基地图上的实测（**本课起点**）：
//     墙压 **681/千**（每千拍有 681 拍在顶墙）· idle 中位 **244** · 胜率 39.3% ·
//     kills 14.11 · cellsVisited 103 · 拾取率 44.6%。
//   最差三关：**Checkers 976/千 / Iron Curtain 830 / Brick Maze 679**，
//     Checkers 胜率 **4%**、击杀 **1.68/局** —— 它是**卡在墙里**，不是打不过。
//   `wallPressTicks` **不在 METRICS 列里**（只在 eval 行）⇒ 入不了 formula；
//   唯一可用的代理是 `idleTicks`（`player.moving === false`，想动被地形挡也计）。
//
//   `z4-pick-wall` 已用 `wIdle 0.05` 验证过**方向**（同批对照：idle 196 vs 无此项的 260–272，
//   **−25%**），但剂量不够（当时的判据要 ≤130）。本课就是它的**剂量-反应**：
//   0.05 → 0.12，看 idle 能不能从 244 压到 150 以下、墙压能不能从 681 降到 480 以下。
//
// ══ 代价（Φ 拆账）════════════════════════════════════════════════════
//   idle 项从 −13.90 变 **−33.36**（起点快照），Φ 从 214.5 降到 **195.0（−9%）**。
//   value 头要重拟合，前 20 轮不判。其余所有项不变。
//
// ══ 预注册判据（it100 结；面板 = 全 35 关 × 20 seed = 700 局/点）═══════════
//   起点（= z5-safe-base 的起点，`z4-pick-wall.it205`，700 局实测）：
//     idle 244 · 墙压 681/千 · 胜率 39.3% · kills 14.11 · cellsVisited 103 · 拾取率 44.6%
//   主 1：`idleTicks` 中位 **≤150**（−38%）
//   主 2：`wallPressTicks`/千 **≤480**（−30%）
//   守卫（任一破 ⇒ 停）：kills **≥12.0**（−15%）· clear **≥35%**（−4.3pp）·
//     cellsVisited **≥103**（不许为了少停而变懒）· 拾取率 **≥40%**
//   反签名：`aimMisses` 涨 >40%（起点 3.96）· hitRate 掉 >15%（起点 0.729）
//   中间读点 **it50**：idle ≤200 且 kills ≥13 ⇒ 继续；否则杀腿（0.12 已经比 0.05 贵，没动静就是机制到头）
//
// ══ 与 z5-safe-base 的归因关系 ═══════════════════════════════════════
//   两腿只差一个参数 ⇒ 同面板读数**可以直接差分归因给 idle 剂量**（Φ 差 9% 是唯一杂音，
//   但它对 advantage 的影响是常数级的，不改排序）。这是本课存在的全部理由：
//   **给 z5-safe-base 的 idle 项做一次干净的剂量-反应**，顺带看胜率 / 耗时 / 拾取 / 击杀
//   这几个读数会不会跟着动。
//
// ══ 运行约束 ═══════════════════════════════════════════════════════════
//   · 与 z5-safe-base 同会话（v7 / schema 7），可并行开；**不要共用 backup_prefix**；
//   · `iters 500 / max_hours 48 / eval_every 5 / eval 20 seed×35 关`（与 z5-safe-base 相同）；
//   · 开课后不要编辑本文件（课程字节变 = 新实验版本，热加载 A 类拒收）。

{
  "version": 5,
  "name": "z5-idle12",
  "mode": "per-tick",
  "level": "classic35-safe-base",
  "rotation_mode": "even",
  "rotation_per_it": 7,
  "enemies": 20,
  "lives": 3,
  "max_ticks": 20000,
  "reward": {
    "formula": [
      // 收入
      "wKill*kills",
      "+ wHit*aimHits",
      "+ wWin*where(clearTick>=0, 1, 0)",
      // 机制
      "+ wBase*baseWallIntact",
      // 价格
      "- wDmg*playerDamageTaken",
      "- wDeath*playerDeaths",
      "- min(paceCap, wPace*max(0, ticks - kills*paceTicks)/paceWindow)",
      // 塑形
      "+ wBrick*min(aimBricks, brickCap)",
      "+ wWalk*where(cellsVisited>walkCap, walkCap, cellsVisited)",
      // 收入
      "+ wPickup*min(powerUpsCollected, pickupCap)",
      // 机制
      "- wThreat*min(threatTicks, threatCap)",
      "- wDef*min(capDef, max(0, basePressureSum - pDef*basePressureSamples))",
      // 卡墙（**继承起点的唯一优势**：`z4-pick-wall.it205` 是带这个项训出来的，
      // 去掉它 idle 会反弹回 nav0 的 365 拍。必须保留）
      "- wIdle*min(idleTicks, idleCap)",
    ],
    "params": {
      "wKill": 15.0,
      "wHit": 1.5,
      "wWin": 60.0,
      "wBase": 3.0,
      "wDmg": 0.12,
      "wDeath": 18.0,
      "wPace": 6.0,
      "paceTicks": 1200.0,
      "paceWindow": 1000.0,
      "paceCap": 36.0,
      "wBrick": 0.25,
      "brickCap": 12.0,
      "wWalk": 0.5,
      "walkCap": 200.0,
      "wPickup": 4.0,
      "pickupCap": 6.0,
      "wThreat": 0.01,
      "threatCap": 500.0,
      "wDef": 2.5,
      "pDef": 0.15,
      "capDef": 80.0,
      "wIdle": 0.12,
      "idleCap": 800.0,
    },
    "terminal": {
      "timeout": -50.0,
      "lives_exhausted": -35.0,
      "base_destroyed": -35.0,
      "stage_clear": 0.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "nn-training/weights/z4-pick-wall/z4-pick-wall.it205.20261102-173625.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 500,
  "max_hours": 48,
  "lr": 0.00012,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": false,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "kl_coef": 0.05,
      "lr": 0.00012,
      "kl_cap": 0.1,
    },
  ],
  "target_transitions": 32768,
  "paired_rotate_seed": 20261028,
  "decision_events": false,
  "decision_k": 10,
  "out": "tmp/z5-idle12/weights.json",
  "traj": "tmp/z5-idle12",
  "ent_break": 0.0,
  "ent_break_max_winrate": 0.0,
  "backup_dir": "nn-training/weights/z5-idle12",
  "backup_prefix": "z5-idle12",
  "eval_stages": "2000-2034",
  "eval_games_per_stage": 20,
  "eval_every": 5,
}

// ══════════════════════════════════════════════════════════════════════════
// 结算节（2026-11-03 11:50 人工停课 at it50 / 500）
// ══════════════════════════════════════════════════════════════════════════
//
// **判决：三条挂（idle / 墙压 / clear）· idle 剂量-反应不成立 · 有可指认的副作用。**
//
// ① 主判（预注册，35 关 × 20 seed = 700 局/点，it0..it50 共 10 个完整点）：
//      `idleTicks` 中位 **254 → 242（−4.7%）**，判据要 **≤150（−38%）** ⇒ **差 92 拍**。
//      `wallPress`/千 **642 → 673（+4.8%，反向）**，判据要 ≤480 ⇒ **不过且变差**。
//    ⚠ 课程头注写的起点是 244（来自 max_ticks 36000 的外部测量）；**本课实际 it0 = 254**
//      （max_ticks 20000 口径）。判据未按 254 重算，但 242 距 150 太远，不影响判决。
// ② 守卫：clear **34.0% < 35%** 破 · `cellsVisited` **88 < 103** 破（起点实际 90，也低于 103，
//      这条守卫当初写错）· kills 13.40 ≥12 ✓ · 拾取率 47.5% ≥40 ✓
// ③ 配对（it0→it50，700 局同 (stage,seed)）：clear **变好 103 / 变坏 111，净 −8，p=0.632**
//      ⇒ 不可分。基毁 **0 变**（安全基地图，基地不可摧毁，符合设计）。
// ④ **副作用（本课最值钱的读数）**：分关 clear 互相对冲 ——
//      跌：**2002 Steel Fortress 80% → 45%（−35pp）** · 2003 35→15（−20）· 2013 25→0（−25）
//          · 2021 75→55（−20）· 2000 70→55（−15）
//      涨：2007 20→40（+20）· 2010 45→65（+20）· 2031 30→50（+20）· 2034 25→40（+15）
//      ⇒ 净 −8 是**七跌六涨对冲**的结果，不是"全线持平"。
//      2002 是安全基地图上最强的一关（`reports/safe-base-probe-20261102.md`：wall205 打 84%），
//      在本课掉到 45% ⇒ **`idle` 惩罚在"需要停下来瞄准"的关上是负作用**。
//      根因：`idleTicks` 的定义是 `player.moving === false`，**分不出「卡墙」和「停着打靶」**
//      （本课头注 §已知局限第 2 条已经预判，现被证实）。
//
// ⑤ 与 `z4-pick-wall` 的对比（**同一参数、相反结果**）：
//      那课 `wIdle 0.05` 在 4 关面板上把 idle 从 260–272 压到 **196（−25%）**；
//      本课 `wIdle 0.12`（×2.4 剂量）在 35 关面板上只压到 **242（−4.7%）**。
//      ⇒ 不是剂量不够，是**这个机制在 35 关面板上失效**。可能原因：35 关里有大量
//      "必须停住等角度"的窄道关（Checkers/Lattice/Iron Curtain），罚 idle 与它们的
//      最优打法直接冲突，梯度互相抵消。
//
// ⑥ 给下一腿的输入：
//      a) **`idle` 这条路到此为止**：剂量 ×2.4 只换来 −4.7%，且 2002 掉 35pp。
//         再调 `wIdle` 没有意义 —— 除非先能区分「卡墙」与「停着打」。
//      b) **区分它们需要 `wallPressTicks` 进 METRICS 列**（现在只在 eval 行，入不了 formula）。
//         那是 TS 侧 `buildMetricsRow` + `METRICS_VERSION` + 双端指纹的改动，属独立任务。
//      c) `z5-safe-base`（本课的孪生腿，wIdle 0.05）仍在跑，到 it130 时胜率已从 42.0% 掉到 35.2%
//         —— 与本课的"七跌六涨对冲"是同一现象的两种表现。
//
// 数据出处：`tmp/z5-idle12/{eval_log,training_log}.jsonl`（11 点，其中 it30 缺 158 局）·
//   `nn-training/weights/z5-idle12/`（54 个权重，it1..it54）· `tmp/z5-final.py` / `tmp/z5-final.txt`。
//   起跑 2026-11-03 00:5x（多处 run_start）· 末次迭代 **01:14:27** · 停课 11:50（人工）。
//   eval 成本：10 个完整点 × ~700s ≈ 1.9h（云机慢点 1304s，快点 400s）。
