    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "nn-training/weights/z2-r5guard/z2-r5guard.it500.20261030-152207.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 500,
  "max_hours": 40.0,
  "lr": 0.00024,
  "epochs": 4,
