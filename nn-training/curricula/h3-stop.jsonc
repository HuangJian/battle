// 课程 h3-stop —— **新纪元第 3 课：x3 rung（ladder-c03），STOP-only**（plan/new-era-stop.plan.md §7）
//
// 状态：**草稿，待用户手工开训**（agent 不得启动训练）。
//   **前置**：h2 过门 + 冠军权重归档后，才能 pin `bc` 开课（起点占位见下）。
//
// 立项：梯子第三 rung。B 案 STOP 语义沿用；均匀 K=10（事件 rung 另开，plan §6 R2）；
//   flat critic（解耦 rung 条件未到：x1/x2 表示已验且 danger 不动才开）。
//
// 配方（= x1-a2 v4 包逐字，x3-rebirth 同款）：
//   wKill 3.0 / wHit 0.6 / wWin 2.0 / wDmg 0.03 / wShot 0.05 / **wExplore 0.2**
//   + terminal lives_exhausted −5.0 / timeout −2.0。
//   （wExplore 衰减表：x1/x2/x3 保留 0.2 → x20 rung 归零，衰减表进 DECISIONS 开腿条目。）
// 位移包（x3-rebirth 原样）：lr 0.0005 / epochs 6 / mb 512 / kl 0.02（25 轮）→0.01。
//
// 起点：h2 冠军 warm start，`kickstart_ref=true`（梯子链 kk=true 绿过；C 事故是同任务续命，另案）。
//   ⚠ `bc` 下面的占位必须在开课前换成 h2 冠军实际文件名，否则拒启。
//   comparator = 本 rung 绝对门 + 自身趋势（跨 rung/跨纪元不配对）。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据（x3 rung 绝对数门，2026-09-27 已 pin；脚注：h2-it15 零射 h3 关 70.5%/123/零伤23.5%，
//   门要求真学习量：+20pp win、dmg 腰斩、零伤翻倍；不达标不停腿持久战，按横盘规则停）
// ══════════════════════════════════════════════════════════════════════════
// **门**：日常段（860001，400 局）`pass ≥ 90%` 且 `dmg/局 ≤ 60` 且 `零伤通关 ≥ 50%`。
// **机制链**：① stopPickRate（侧车计数）② threat/clean ③ pass/dmg 跟随。
// **约束**：超时 >5% ⇒ 人工决策停；kl 连续 3 轮 ≥0.075 ⇒ 记录 + 人工盯盘；
//   ent 跌破 0.25 ⇒ break；分关任一退步 >5pp ⇒ 掉队。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行）
// ══════════════════════════════════════════════════════════════════════════
//   · **专属死刑**：stopPickRate 连续 3 个 eval 点 < 10/千tick（前置：探针链通）⇒ 停腿；
//     熵早期塌陷 ⇒ 先开判别臂，通过后才进 B2。
//   · **对称死刑**：stopPickRate 连续 3 点高于人类基线上四分位 ⇒ 停腿 ⇒ B0。
//   · **机械横盘**：pass/dmg 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮，不得二次宽限。
//   · B1/B3/B4 按 plan §8。

{
  "version": 5,
  "name": "h3-stop",
  "mode": "per-tick",
  // 环境：ladder-c03。任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c03",

  // ── 奖励：x1-a2 v4 包逐字 ──────────────────────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits + wWin*where(clearTick>=0, 1, 0) - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wWin": 2.0,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.2
    },
    "terminal": {
      "lives_exhausted": -5.0,
      "timeout": -2.0
    },
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：h2 冠军 warm start（2026-09-27 已 pin：h2 it25 96.2%/35.9/零伤75.7，sha 已验）─
  "bc": "nn-training/weights/h2-stop-best/h2-stop.it25.best.json",
  "kickstart_ref": true,
  "warmup_iters": 0,

  // ── 预算（x3-rebirth 原样：小时封顶；轮数 artifact 化）─────────────────────
  "iters": 150,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：x3-rebirth 原样 ─────────────────────────────────────────────
  "lr": 0.0005,
  "epochs": 6,
  "mb": 512,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "until_iter": 25, "kl_coef": 0.02, "lr": 0.0005, "kl_cap": 0.2 },
    { "kl_coef": 0.01, "lr": 0.00025 }
  ],

  // ── 采集 ───────────────────────────────────────────────────────────────
  "target_transitions": 24000,
  "est_samples_per_game": 130,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/h3-stop/weights.json",
  "traj": "tmp/h3-stop",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/h3-stop",
  "backup_prefix": "h3-stop",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① h2 过门（it25 96.2%/35.9/零伤75.7）+ 冠军归档 + `bc` 已 pin 真实文件（已验）。
// ② 门 X/Y 按 §1 梯子门原则 pin 死（以 h2 终点 + rung 难度定，不拍脑袋）。
// ③ 公式编译验证（validate_reward；与 v4 逐字同是正确原因）。
// ④ 新 out/traj 目录（禁续跑）。⑤ 节点心跳。⑥ paired-kill 默认关（opt-in）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台开课）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it0/it5…（860001 段 400 局）pass/dmg/stopPickRate（侧车）/cells。
// · 事件 rung（plan §6 R2）另开课程，不进本文件。
//
// ── 结算节（跑完回填）──────────────────────────────────────────────────────
// 必填：① pass/dmg it0 → 终点 ② stopPickRate ③ 分关表 ④ 超时/换血
//   ⑤ 实际轮数与耗时 ⑥ 判语（过门⇒ h4；idle 平 ⇒ B2；停太多 ⇒ B0）。
//
// ── 结算（2026-09-27 回填：it1–121，用户横盘+宽限后停腿；日常到 it120）──
// ① 日常（860001，it0 200 局 / it5+ 400 局）：it0 64.5%/132 → **it115 87.5%/59/零伤58.2**
//    （+23pp/−55%/零伤过 50% 门）；it95–110 横盘触发（win/dmg 四点无改善），宽限 +10 →
//    it115 dmg 新低 59（宽限买到了东西），it120 86.5/63 回吐。门（90/60/50）：dmg 过、零伤过、
//    win 差 2.5pp——**三门中两门，差一口气**。
// ② stopPickRate：it25 起痕量（0.03–0.73%），全程 <10/千tick；梯子豁免（死刑不执行）。
//    STOP 在 h3 从未进入选择集（wExplore＋弱威胁预期内；c20 见）。
// ③ 分关：待补（需要时从 eval_log 按 stageId 切；h2xfer 已知 s2002 最弱，归档备查）。
// ④ 超时全 0；换血 dmg 132→59（−55%）；rollout wr it11 起 0.93~0.95 天花板后 it61+ 回落 0.74~0.88。
// ⑤ 实际：it1–121（~08:25→12:47，~4.4h；预算 150/12h，用 40%）。
// 判语：**门边未过**（非判负）：改善幅度大（+23pp/−55%）、宽限内仍创新低（it115 dmg 59）、
//    2/3 子门过——B 式"有效、强改善、差一口气"。终点 = it115，冠军归档
//    `nn-training/weights/h3-stop-best/h3-stop.it115.best.json`（sha 已验）。
//    下一步 h4（bc 已 pin 冠军，待开）；h4b bc 同步换冠军（先行版 caveat 解除）。
// 数据：`tmp/h3-stop/eval_log.jsonl`（it0/5/…/120）。
