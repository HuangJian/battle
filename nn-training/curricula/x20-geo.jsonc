// 课程 x20-geo —— **c20 几何塑形腿（back/side hits＋豁免桶定价）**（§59/§64，plan 待定）
//
// 状态：**草稿，禁开训**。前置三件缺一即拒启（开课前逐项打勾）：
//   ① instrumentation 落地（`backHits/sideHits/frontHitsExempt/farHits`＋`geoFallback`
//      列存在，`bun run check` 绿）；② hit 几何剂量重测完成，`wGeoBack/wGeoSide`
//      换成 pin 值（当前 1.0/0.5 是 kill 口径锚，**TO-BE-PINNED**）；③ DECISIONS 新实验条目
//      （奖励语义变更，§15.5：新 out/traj＋一条 DECISIONS）。
//   公式引用新列时旧版控制台/节点会响亮拒收（未知 metrics），属预期行为。
//
// 立项：由 x20-steady.jsonc 逐字节派生，仅改动以下 7 处，其余逐字同：
//   1. name/out/traj/backup → tmp/x20-geo（fresh，新实验隔离，§15.5）。
//   2. 配方：B 包逐字 ＋ 尾部追加三项（唯一变量）：
//      `+ wGeoBack*backHits + wGeoSide*sideHits + wGeoBack*frontHitsExempt`
//      （豁免桶按 back 价，用户口径；普通 front 免费；farHits/geoFallback 无项）。
//   3. `bc`：x20-rebirth.it30 → **x20-steady.it175 终点冠军**
//      （`nn-training/weights/x20-steady/x20-steady.it175.20260920-215502.json`，
//      判决 low 35.5%/p10 2 现役最优；核验 sha 后 pin，课程文件内不写 sha）。
//   4. `kickstart_init`：缺省 → **0.1**（新奖励项需要小锚防洗；C 腿教训 kk=1 洗脑，
//      小开快衰减，x20-human-anchor 同值先例）。
//   5. `iters`：0 → **150**（B 腿 iters:0 是时间封顶形态；新腿预算封顶，
//      烧完门未过即停，不许“再等等”；可经控制台 停止→启动 加轮）。
//   6. 判据见下（c20 门＋机制＋回测＋反证；跨 rung/跨纪元不配对）。
//   7. 采集：target 48000 → **49152**（mb 对齐现行标准：48 × mb(1024)，per-stage 配额
//      12288 = 12 × mb，与 state-init/dodge-l1/clutch 同值）。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据（c20 任务绝对门，不在本文件重定，只引用）：
// ══════════════════════════════════════════════════════════════════════════
// **门**：判决段 414000（800 局/权重）`low% ≤ 35%` 且 `p10 ≥ 2`；回测段 415000 不劣于 it0。
// **机制链**：① backHits 占比（it0 新列首测即基线）上升 ② threat/clean（如有）
// ③ pass/dmg 跟随（三环缺一不算；只①动而③不动 ⇒ 价格买了动作没买到结果，判无效）。
// **约束**：超时 >5% ⇒ 人工决策停；kl 连续 3 轮 ≥0.075 ⇒ 记录＋盯盘；
//   ent 跌破 0.25 ⇒ break；刷甲哨兵：`cellsVisited` 塌（it0 基线 −30%）或通关局
//   ticks 恶化 >10% ⇒ 复现 x20 A 腿死法（变保守），停腿。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行；paired-kill 默认关 opt-in）
// ══════════════════════════════════════════════════════════════════════════
//   · **机械横盘**：pass/dmg 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 ＋10 轮，不得二次。
//   · B0/B1/B3 按 plan/new-era-stop.plan.md §8（B2 不适用——本腿不含事件门）。

{
  "version": 5,
  "name": "x20-geo",
  "mode": "per-tick",
  // 环境：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：B 包逐字 ＋ 单变量三项 ─────────────────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected - wApproach * where(pickupDist < 0, 0, pickupDist) + wGeoBack*backHits + wGeoSide*sideHits + wGeoBack*frontHitsExempt",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.2,
      "wPickup": 3.0,
      "wApproach": 0.008,
      "wGeoBack": 1.0,
      "wGeoSide": 0.5
    },
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：it175 冠军 warm start ＋ 小缰绳 ──────────────────────────────────
  "bc": "nn-training/weights/x20-steady/x20-steady.it175.20260920-215502.json",
  "kickstart_ref": true,
  "kickstart_init": 0.1,
  "warmup_iters": 0,

  // ── 预算（150 轮 / 12h；B 腿同量级，烧完即停）─────────────────────────────
  "iters": 150,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：B 原样 ─────────────────────────────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：mb 对齐（x20 现行标准，与 state-init/dodge-l1/clutch 同值）────────
  // 49152 = 48 × mb(1024)；per-stage 配额 12288 = 12 × mb ⇒ 无 ragged tail。
  "target_transitions": 49152,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/x20-geo/weights.json",
  "traj": "tmp/x20-geo",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-geo",
  "backup_prefix": "x20-geo",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置（agent 不得启动训练，用户手工经控制台开课）────────────────────
// ① 本文件头三件套打勾。② 公式编译验证（validate_reward；新列未知符号拒启是正确行为）。
// ③ 新 out/traj 为空目录（禁续跑）。④ 节点心跳。⑤ paired-kill 默认关。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it0/it5…（860001 段 400 局）pass/dmg/backHits 占比/cells/ticks。
// · 判决：414000（800 局）＋回测 415000（800 局），McNemar 配对＋CI。
//
// ── 结算节（跑完回填）──────────────────────────────────────────────────────
// 必填：① pass/dmg/low it0 → 终点 ② backHits 占比 it0 → 终点（威胁上下文分解优先）
//   ③ 分关表 ④ 超时/换血/cells ⑤ 实际轮数与耗时 ⑥ 判语（过门⇒ router；机制动＋门远⇒
//   剂量 ladder（×2，上限注定）；横盘⇒停）。
//
// ── 结算（2026-09-29 回填：it1–57，用户手工停腿；日常到 it55，池外 it45 双段 2×800 局）──
// ① 日常（860001）：it0 15.5%/251/7.42杀 → it45 峰值 16.5%/255/8.26杀 → it55 13.0%/252/7.49杀；
//    全程 10–17% 横盘；back 占比 it0 0.212 → it45 0.211 → it55 0.221（±0.01 噪声，零位移）。
// ② 判决 414000（800 局，it45）：mean 7.56 / low 38.0%（CI 34.6–41.4）/ p10 1 / pass 13.9%——
//    门（low≤35 且 p10≥2）未过；相对 it0（it175 存档：35.5/2/7.84）三项全劣
//    （low +2.5pp、p10 −1、mean −0.28）。分关仅 s2003 low 33.5% 单项过；无一关 p10≥2 且 low 过
//    （s2001 p10=2 但 low 47%）。数据 `tmp/x20-geo/settle/judge-414000-it45.jsonl`。
// ③ 回测 415000（800 局，it45）：mean 7.25 / low 41.9%（CI 38.5–45.3）/ p10 1——
//    相对 it0（it175 存档：38.9/2/7.76）三项全劣（low +3.0pp，CI 重叠 p≈0.22 不显著；p10 −1、
//    mean −0.51），回测门（不劣于 it0）未过。it0 档引用 §19 存档（同权重同种子确定性复算等价；
//    逐局行已清盘， gameplay 不涉 metrics，freeze 签名绿）。数据 `tmp/x20-geo/settle/backtest-415000-it45.jsonl`。
//    （全列账本在同名 `.run/eval_log.jsonl`。`--out` 行缺 v9 列是 `_to_tool_row` 缺口，另案修。）
// ④ 超时全 0；cells 79.3 → 80.9/77.4（无刷甲）；ticks ~2000 稳；kl ~0.01、ent 0.61→0.46
//    （健康，未碰 break）；far/fb 全程 0；exempt 4.0–4.4/局量级稳定（非刷甲指纹）。
// ⑤ 实际 it1–57（~1h55m；预算 150 未用满，用户停腿）。
// 判语：**门未过＋回测劣＋机制零位移 → 判负**；本腿在 overdose（1.0/0.5 ≈ 2.7× kill 口径预算）
//    下 57 轮未买到动作，不触发剂量 ladder（ladder 要"机制动＋门远"）；c20 几何通道关闭
//    （h4-geo 是 h4 新实验，非本腿续跑）。
// 数据：`tmp/x20-geo/eval_log.jsonl`（it0/5/…/55）＋池外见②③。
