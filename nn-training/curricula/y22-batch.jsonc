// 课程 y22-batch —— 阶段 A 腿三：只把每轮采样量翻倍（其余逐字 = y22-null）。
// 规格来源 = 本头注（agent 只给文件，**开课 = 人在控制台点**；与 y22-null/lr/gamma 并行）。
//
// 立项 → 2026-10-18（`plan/y22-winrate-ladder.plan.md` §3）：
//   y21 四腿每轮只采 **37582 个样本 / 57 局**（6587 拍/局 ÷ 10 拍一决策）。整轮梯度只由 57 局估出来，
//   而每局承伤方差极大（CV ≈ 1）⇒ 每轮的方向里噪声占大头。翻倍采样把梯度标准差压到 1/√2。
//
// ── 单变量声明（相对 y22-null：只动采样量）──────────────────────────────────
//   `target_transitions` 24576 → **49152**（其余 reward/lr 表/gamma/lam/epochs/mb/K/流/eval 逐字）。
//   `mb` **不动** 1024（每轮 minibatch 数 24 → 48，仍是 PPO 正常范围）。
//   `max_hours` 48 → **72**：这是**预算而非变量**——采样翻倍后单轮墙钟约 ×1.8，
//     500 轮 × 3.6 min ≈ 30h → ≈ 54h。若仍按 48h 停，本腿会在 ~440 轮被砍，
//     按斜率读数不影响（斜率是 /100 轮），但为省事直接给 72h cap。
//   双分支：Φ 斜率回到 ≥ −0.02/轮 ⇒ 梯度方差是主因；
//     Φ 斜率与 y22-null 无差别 ⇒ 方差不是主因（那基本就只剩 gamma/优化器结构与起点）。
//
// ── 门（同 y22-null，换口径：余量为主）──────────────────────────────────────
//   主读数 **余量 = (20/杀速) ÷ (219/(承伤/千拍))**，起点 0.96，目标 ≥ 1.3（人类同座位 1.97）。
//   副门：+60 win ≥ 0.685（起点值）；kills ≥ 16.5/20；timeout ≤ 5%。
//   Φ 斜率每 25 轮回归（**本腿的主判据**）：< −0.05/轮 即红。
//   ⚠ 采样翻倍 ⇒ 每轮 eval 面板不变、但训练语料轮换更快；`paired_rotate_seed` 与其它三腿同值，
//     前 250 轮的 (stage,seed) 集合与兄弟腿**不完全相同**（每轮取样更多）⇒ 跨腿比只比斜率，不比单点。
//   D01 ≤ 85 护栏；fear-watch（shots/局 < 16 且 kills < 10，杀）。fail ⇒ **杀腿**。
//
// ── 训练设置（除 target_transitions / max_hours 外逐字 = y22-null）──────────
//   anchor 0.001；ent_break 0.0＋max_winrate 0.0；K=10；iters 500（cap），workers 8；
//   eval 混合（"2000-2003"×50）。
//   ⚠ 前提：tmp/y22-batch 不存在（§15.5 新 out/traj＋本条 DECISIONS，不得续跑）。
//
// ── 起点纪律 ────────────────────────────────────────────────────────────────
//   · 起点 = `y20-stack2.it200.pool800.json`（sha16 `1a7821240d3c47b9`；kickstart 关）。
//   · §15.5 新实验：新 out/traj（tmp/y22-batch）+ backup 新目录（nn-training/weights/y22-batch）+ opt fresh。
//   · 种子 20270206（y22 四腿共享）；`bc=` 非 resume；开课后核 rotateSeed。
// ── 结课报告（2026-10-18 用户手动停腿：阶段 A 判负，三个旋钮都不动）──────────
//   跑量：第 1–202 轮（最后满局 eval it200），已采 10.67（**2 倍**）M 样本。19:58 有过一次重启
//     （`start_it=None`），重启前后读数无缝（kl/entropy/value 无跳变）。
//   轨迹（anchor 200 座 win）：it0 **0.685** → it100 **0.645** → it150 **0.650** → it200 **0.680**。
//     ⚠ **形状是「中期低谷再爬回来」，不是单调退步**：it55 时的 −0.19/轮 到 it200 已摊平成
//     **+0.014（t +1.5） Φ/轮**；四条腿的末点都在起点的 CI（±0.066）之内。
//   Φ/局：78.7 → **81.0**（+2.3）；余量 0.90（起点 0.90、人类 1.97）——**生死账没动**。
//   配对（McNemar，同 200 座 vs it0）：Δwin **−0.005**；全段判读见 `tmp/y22-progress.py`。
//   行为（it0 → 末点，全部 200 局口径）：实弹/千 7.92→8.45 · 威胁 lane/千 43.1→39.9 ·
//     贴脸/千 115.5→123.0 · 低血时长/千 199.2→184.9 · 中了不跑/千 2.28→2.22 · 开局 600 伤 6.5→7.5。
//   健康：kl 0.0154→0.0142 · value 0.616→0.578 · entropy 0.718→0.677 · policy loss 0.0036→0.0036。
//   结论：**判负（本条腿不单独成立）** —— **Φ 最高（81.0 vs null 77.8）但不可分**（单点 SE 2.7 ⇒ 1.2σ），win 与 null **完全相同**（0.680）。而且它在「轮」轴上显平有一半是数据量：**等样本比较符号会翻**（1.5M 时 +1.7、2.9M 时 −2.3）。⇒ 「降方差有效」**没有证据**；本腿相对 null 的收益 = 0，成本 = 2 倍算力。
//   证据：tmp/y22-batch/{training_log,eval_log}.jsonl · reports/y22-phaseA-stop-it200-20261018.md ·
//     reports/y22-pk-fresh-seats-20261018.md。
{
  "version": 5,
  "name": "y22-batch",
  "mode": "per-tick",
  "level": "ladder-c20-lives1",

  "reward": {
    "formula": "wKill*kills + wHit*aimHits - wDmg*playerDamageTaken - wMiss*aimMisses + wPickup*powerUpsCollected - wApproach*where(pickupDist<0, 0, pickupDist) + wAcc*aimHits/(playerShots+1) + wDist*aimHitDistSum/(aimHits+1) + wWin*where(clearTick>=0, (8000-clearTick)/1400, 0) - wHurt*hurtWeight/(ticks+1) - wEncl*enclWeightTicks/(ticks+1) - wCorner*cornerWeightTicks/(ticks+1) - wThreat*threatTicks/(ticks+1) - wNearSq*nearSqSum/(ticks+1) - wBlock*(idleTicks-stopTicks)/(ticks+1) + wFrFreeze*puGotFreeze + wFrBomb*puGotBomb + wFrStar*starsCollected + wBackHits*backHits + wSideHits*sideHits",
    "params": {
      "wKill": 3.0,
      "wHit": 0.2,
      "wDmg": 0.03,
      "wMiss": 0.35,
      "wPickup": 3.0,
      "wApproach": 0.008,
      "wAcc": 15.3,
      "wDist": 0.6,
      "wWin": 5.0,
      "wHurt": 150.0,
      "wEncl": 12.9,
      "wCorner": 110.0,
      "wThreat": 120.0,
      "wBlock": 110.0,
      "wNearSq": 48.0,
      "wFrFreeze": 2.0,
      "wFrBomb": 2.0,
      "wFrStar": 3.0,
      "wBackHits": 1.0,
      "wSideHits": 0.2
    },
    "terminal": {
      "timeout": -15.0
    },
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：stack2-it200（本实验的"最佳权重"；同代直连，kickstart 关）──
  "bc": "nn-training/weights/y20-stack2/y20-stack2.it200.pool800.json",
  "kickstart_ref": false,
  "warmup_iters": 0,

  // value 门控牵引率 ρ（出生安全件，非变量；legacy 空片下无物可拴，无害）。
  "value_anchor": 0.001,

  "iters": 500,
  "max_hours": 72,

  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "until_iter": 240, "kl_coef": 0.05, "lr": 0.00015, "kl_cap": 0.1 },
    { "kl_coef": 0.05, "lr": 0.0001, "kl_cap": 0.1 }
  ],

  "target_transitions": 49152,
  // y22 系流（新种子 20270206；y22 四腿共享＝四路可比）。
  "paired_rotate_seed": 20270206,

  "decision_events": false,
  // K=10（K5 配对 1600 局终判，K5 训练侧永久关闭，DECISIONS §2026-10-08-k5-verdict）。
  "decision_k": 10,

  "out": "tmp/y22-batch/weights.json",
  "traj": "tmp/y22-batch",
  "ent_break": 0.0,
  "ent_break_max_winrate": 0.0,

  "backup_dir": "nn-training/weights/y22-batch",
  "backup_prefix": "y22-batch",

  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}
