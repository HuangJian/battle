// 课程 x20-noexplore —— **A 腿：关探索奖**（wExplore 0.2 → 0）
//
// 状态：**已收官（2026-09-22 用户手工停腿）** —— it1–181（09-21 23:38 → 09-22 08:37，~9h，
//   ~3min/轮）；最终候选 **it105**（不是终点）；判语：**现象阳性门边未过＋机制阴性，wExplore 无罪**
//  （详见本文件结算节）。
//
// 立项（train-following-by-k3 §5.2；docs/nn/experiments.md §28–§30）：
//   人类 35+26 局全通关，原则"不往敌人堆里钻"；NN 5/6 死在顶部敌区。
//   wExplore 按新格子计价（+0.2/格），恰好奖励"往上逛" ——  Exploration 奖可能在教自杀
//   （逛 ~25 格 +5 vs 死亡总价 -7.5，边际上 sightseeing-then-die 不亏）。
//   本腿是单变量消融：探索奖是不是 rush 的元凶。
//
// 单变量纯度：与 x20-steady **逐字相同**，只改 `wExplore: 0.2 → 0.0`（公式不动，乘零即删项；
//   reward 指纹照常变更，进血缘是正确的 —— 行为变了就该是新实验）。
//   采样 48000 / mb 1024 / lr / epochs / gamma / lam / schedule / seed_rotate 全同 B。
//
// 起点：与 A/B 同起点 it30（`x20-rebirth.it30`），kk=1 natural —— 与 B 同条件，曲线可直接对照。
//   不从 it175 起：A/B 对照要求同一起点，且 it30 起天然 kk=1，无需小 kk 机制。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据（日常口径为主，机制读数为辅）
// ══════════════════════════════════════════════════════════════════════════
// **主读数 = 日常 low% 轨迹**（860001 段 400 局，每 5 轮）：B 是 44.0 → ~34（175 轮）。
//   本腿问：去探索奖后 low% 是否更低 / 更早下移（it40 检查点：B 在 it40 是 44.2，
//   若本腿 it40 已明显下移 ⇒ 奖是元凶实锤）。
// **机制读数 = 顶部死亡占比**：死亡 y≤6 的局占比（traj shard 解码玩家位置，事后脚本分析；
//   B 基线：5/6 死在顶部 —— 该比例下降才是"不钻了"的直接证据，low% 只是结果）。
// **门（2026-09-22 补 p10）**：终点判决段 414000 `low% 相对 B 同 it 点改善 ≥3pp` **且 `p10 ≥ 2`**。
//   ⚠ p10 不能漏：low% 掉了而 p10 原地踏步 = B 腿前半段重演（B 在 it40 的日常 low% 是 44.2、
//   p10 一直到 it90 之后才动）⇒ 只报 low% 的改善不算成功。
// **约束（熔断优先级最高）**：日常 mean < 6.19 立即停；超时 >5% 立即停；
//   另防"不逛=不动"退化：cellsVisited/局 中位不得塌（B 基线 ~25 格，掉一半即停）
//   —— 该监控**有杀腿权**，不是"记录并继续"。
// **回测门**：终点候选 415000 不劣于 B 终点（同段同种子配对）。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损
// ══════════════════════════════════════════════════════════════════════════
//   · **it40 主检点**：low% 相对 it0（日常 44.0）无 ≥−3pp 下移 ⇒ 停腿（奖不是主因， differ 与 B 无异）。
//   · **上/下限熔断**：mean < 6.19 或 timeout >5% ⇒ 立即停。
//   · **机械横盘**：low% 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮。

{
  "version": 5,
  "name": "x20-noexplore",
  "mode": "per-tick",
  // 环境不变：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：B 原公式，**唯一变量 wExplore = 0.0** ─────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected - wApproach * where(pickupDist < 0, 0, pickupDist)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.0,
      "wPickup": 3.0,
      "wApproach": 0.008
    },
    // dense-only（与父腿一致）：terminal 空表合法。
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：与 A/B 同一个 it30 ─────────────────────────────────────────────
  "bc": "nn-training/weights/x20-rebirth/x20-rebirth.it30.20260919-085629.json",
  "kickstart_ref": true,
  "warmup_iters": 0,
  // ── 配对（2026-09-22 补，评审处置）────────────────────────────────────────
  // B 腿（x20-steady）是**老腿**，开跑时课程文件里没有 `paired_rotate_seed` 字段，
  // 其实际 rotateSeed 只记在账本里：`tmp/x20-steady/training_log.jsonl` 的
  // `run_start.rotateSeed = 1789876303`（已核，三次 run_start 同值）。
  // 本腿显式写同一把值 ⇒ 与 B **逐轮同种子流**，low%/p10 可做同 it 点配对对照，
  // 而不是"两条各自抖动的曲线并排看"。
  // ⚠ 改它 = corpus_identity_fp 变 ⇒ 与 B 不再配对（会退化成非配对双比例检验，
  //   门要提到 ≥5pp）。别动。
  "paired_rotate_seed": 1789876303,

  // ── 预算 ───────────────────────────────────────────────────────────────
  "iters": 0,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：回基线（与 B 一致）────────────────────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：与 B 一致 ──────────────────────────────────────────────────────
  "target_transitions": 48000,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/x20-noexplore/weights.json",
  "traj": "tmp/x20-noexplore",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-noexplore",
  "backup_prefix": "x20-noexplore",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① bc 文件存在（与 B 同一个，已验证）。
// ② transport：**必须显式 `--remote-transport pull`**；PPO 云机（禁本机 CPU，事故教训）。
// ③ 新 out/traj 目录（禁续跑，§15.5）。
// ④ remote_hubs 登记 + slot 容量 + worker 心跳（开训前确认，事故 §4 教训）。
// ⑤ 公式编译验证（wExplore=0 不改变编译；开训后首轮 PPO 日志确认 reward 指纹已变）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台）：
//   开课 x20-noexplore（训练模式 在线，rollout 本机，PPO 云机）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it0/it5…（860001 段 400 局）low%/mean/p10 + 与 B 同 it 点并排对照表。
// · 机制读数：traj shard 玩家位置解码 → 死亡 y≤6 占比（脚本按需写，`tmp/diverge-resim.ts` 有现成位置读取可复用）。
// · cellsVisited 中位监控（防不逛=不动）。
//
// ── 结算节（2026-09-22 回填，最终候选 = it105 `x20-noexplore.it105.20260922-053620.json`）──
// ① 日常 low%（内部 eval 即日常口径，已核 it0/it40 与 B 记载逐字吻合）：it0 44.0/6.88/p1 →
//    it40 47.0/6.15/p1（主检点字面未过，未执行）→ it55 37.2/p2 → it105 36.0/8.14/p1 →
//    it125 34.2/7.92/p2（日常最佳）→ it145 44.8 spike → it175 36.2/7.39/p2 → it180 37.0/7.86/p2。
//    B 同期在 it145 亦同步下探（配对种子流共振，公共 batch 噪声）。
// ② 终点多点判决（414000，800 局，B 终点 it175 = 35.5/7.84/p2/pass 15.1%）：it105 **33.0/8.33/
//    p2/17.9%（−2.5pp，四项全优）** · it125 34.5 · it135 34.5 · it165 37.1/p1 · it176/177 42.5 ·
//    it180 37.8 · it181（真终点）39.0。只看终点会错过 it105（it105–135 高原，it165 后漂走）。
//    配对硬数（800/800 同种子）：it105 vs B 逐局均杀差 **+0.49 ± 0.32**。门（−3pp 且 p10≥2）
//    **差 0.5pp/约4局没过**；另 best-of-7 有约 +1pp 挑选红利，真实改善约 −1.5pp。
// ③ 分 unit（it105，414000，各 200 局）：abcd 8.72/29.5%/p1 · bcda 7.59/38.0%/p2 ·
//    cdab 9.37/29.5%/p2 · dabc 7.62/35.0%/p1（unit 标签与 B 的 s2000–2003 非同系，仅记现象）。
//    415000（it105）：36.9/7.44/p1（vs B 38.9/7.76：−2.0pp，mean −0.32）；it125 在 415000 反而
//    最好（35.0/7.64/p2，−3.9pp）——候选取 it105（门段优先，课程原意），it125 备选已记录。
//    回测门：low% 不劣、mean 略劣 → 边缘。
// ④ 顶部死亡占比（机制读数，新脚本 `tmp/topdeath/deathpos.ts`，保真 12/12，resim 1336 局）：
//    it105 终死 row≤6 **26.5%**（174/657，CI 23.1–29.9）vs B it175 **23.6%**（160/679，CI
//    20.4–26.8）；首死复核一致（26.3 vs 22.8）；平均死亡行 13.4 vs 14.0，死亡 tick 1644 vs
//    1548（多活 ~100t，杀多一点，死的位置没变）。**机制阴性** —— low% 动了，路线没动。
//    另：§117 的"5/6 死顶部"只是 7 开局桶种子的特例，全段基线实为 ~24%（小样本基线禁推广）。
// ⑤ 超时/换血：超时全程 0；dmg/局 it105 = 254（≈ hp 263 的 97%，2.6 发额度纹丝不动）。
//    kl 全程 0.010–0.016，cells 中位 54–68 无塌（课程写的"B 基线 ~25 格"与 eval 实测 ~60 对不上，
//    口径疑为 traj shard，杀腿时须先核口径）。
// ⑥ 实际轮数与耗时：it1–181，~9h（预算 12h 未用满，用户提前停）；mean 熔断 it40 单点 6.15 踩线
//    未停（事后对：单点噪声）；横盘门 it160 字面触发＋宽限，it165/175 反弹（又是 B 式误杀门）。
//    it176 与 it177 在 800 局上逐局全同（参数不同，贪心行为零漂移：尾部步长已小到质变不了）。
// 终局判语：**现象阳性门边未过、机制阴性**。因果链第一环即断（关探索奖 → 路线不变 → low% 改善另有
//   原因或即噪声＋挑选），wExplore 无罪。最终候选 it105 归档，不重跑刷门（B §110 先例）。
//   数据：`tmp/x20-noexplore/judge-414000-it{105,125,135,165,176,177,180,181}.jsonl`、
//   `backtest-415000-it{105,125,135,176}.jsonl`、`tmp/topdeath/death-it105-s*.jsonl`。
