// 课程 z2-r3 —— 第 3 级：同一组 4 图 · **4 敌 · 2 命**（2026-10-28）
//
// ── 本级只改两件事（同一根轴：能承受更多接触）─────────────────────────────
//   敌数 2 → 4 · 命 1 → 2。命 +1 的时机放在这里，而不是 r1：r1/r2 先学会「一次接触不亏」，
//   再给它一次犯错机会，否则 2 命会被拿来换杀（y34 的 3 命 1 星先例学到的正是「莽」）。
//   起点 = `tmp/z2-r2/weights.json`。首敌仍是 basic（forces 前 4 位各关不同，天然有敌种混编）。
//
// ── 晋级 ───────────────────────────────────────────────────────────────
//   同前：clearRate ≥50% ×2、zero_kill ≤0.10 ⇒ 开 z2-r4。

// ── 奖励：全阶梯逐字相同 ────────────────────────────────────────────────
//   +15*kills +60*clear +3*墙块(0–8) -0.12*dmg -18*death -min(36, 6*未支付千拍) +0.25*min(bricks,12)
//   反苟：墙价（丢一圈 -24）+ **按拍**的 pace（每杀赠 1200 拍，超出每千拍 -6、封顶 -36）
//         + **无移动/探索项**。超时 -50 = 唯一「没打完」的结局，比任何输法都贵。
//   反莽：命价 18 > 一杀 15、血价 0.12/HP、墙价让「冲出去丢基地」也亏；命尽/基毁 -35。
//   汇率（真 RewardFn 的 Φ 差分，§50.3）：完胜 +72.7 · 清关 4 杀 +92.5 · 基地被毁 3 杀 -30.5
//         · 莽（1 杀后死）-73.5 · 苟（超时满墙）-86.0 ⇒ **苟比莽更贵**，赢比两者高 140+。
//
// ── 晋级 / 停腿 ─────────────────────────────────────────────────────────
//   · 晋级下一级：in-loop eval **连续 2 个评估点** clearRate ≥ 50% 且 zero_kill_frac ≤ 0.10。
//   · 停腿：40 轮内 clearRate 始终 0 ⇒ 停，**先查任务侧再谈奖励**（§50.4 的 commander floor）。
//   · it0 的 greedy 是恒定动作（近均匀初始化的正常形态），判据从 it20+ 读。

{
  "version": 5,
  "name": "z2-r3",
  "mode": "per-tick",
  "level": "classic35",
  "stage_select": "16,22,3,6",
  "enemies": 4,
  "lives": 2,
  "max_ticks": 10000,
  "reward": {
    "formula": "wKill*kills + wWin*where(clearTick>=0, 1, 0) + wBase*baseWallIntact - wDmg*playerDamageTaken - wDeath*playerDeaths - min(paceCap, wPace*max(0, ticks - kills*paceTicks)/paceWindow) + wBrick*min(aimBricks, brickCap)",
    "params": {
      "wKill": 15.0,
      "wWin": 60.0,
      "wBase": 3.0,
      "wDmg": 0.12,
      "wDeath": 18.0,
      "wPace": 6.0,
      "paceTicks": 1200.0,
      "paceWindow": 1000.0,
      "paceCap": 36.0,
      "wBrick": 0.25,
      "brickCap": 12.0,
    },
    "terminal": {
      "timeout": -50.0,
      "lives_exhausted": -35.0,
      "base_destroyed": -35.0,
      "stage_clear": 0.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "tmp/z2-r2/weights.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 150,
  "max_hours": 30.0,
  "lr": 0.00012,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": false,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "kl_coef": 0.05,
      "lr": 0.00012,
      "kl_cap": 0.1,
    },
  ],
  "target_transitions": 24576,
  "paired_rotate_seed": 20261028,
  "decision_events": false,
  "decision_k": 10,
  "out": "tmp/z2-r3/weights.json",
  "traj": "tmp/z2-r3",
  "ent_break": 0.0,
  "ent_break_max_winrate": 0.0,
  "backup_dir": "nn-training/weights/z2-r3",
  "backup_prefix": "z2-r3",
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 20,
  "eval_every": 5,
}
