    "formula": "wKill*kills + wHit*aimHits + wWin*where(clearTick>=0, 1, 0) + wBase*baseWallIntact - wDmg*playerDamageTaken - wDeath*playerDeaths - min(paceCap, wPace*max(0, ticks - kills*paceTicks)/paceWindow) + wBrick*min(aimBricks, brickCap) + wWalk*where(cellsVisited>walkCap, walkCap, cellsVisited) + wPickup*min(powerUpsCollected, pickupCap) + wOther*min(puGotOther, otherCap) + wWinHit*min(hitsInFreezeShieldWindow, winHitCap) + wLevel*playerLevel - wHurt*max(0, hurtWeight - hurtRate*ticks) - wEncl*max(0, enclWeightTicks - enclRate*ticks) - wPostHit*max(0, postHitLaneTicks - postHitRate*ticks) - wDef*min(capDef, max(0, basePressureSum - pDef*basePressureSamples)) - wStuck*max(0, stuckTicks - stuckRate*ticks) - wOnLane*max(0, onLaneTicks - onLaneExemptTicks - laneRate*ticks)",
