// 课程 x20-clutch-null —— **C 腿空对照臂**（与 x20-clutch 配对并行）
//
// 状态：**设计定稿，待用户手工开训**（agent 不得启动训练；与 C-w 两臂同时开）。
//   2026-09-25 redesign 与 C-w 同步：基座 B→noexplore、起点→noex-it105、缰绳→false、
//   采样→49152（理由见 C-w §6⑦；本臂除公式外与 C-w 逐字相同）。
//
// 本文件的唯一作用：给 C-w 提供配对差值（`C0 low% − Cw low%`），分离"加权效应"与
// "续跑效应"（B 腿的总量混杂教训，§109）。除奖励公式外，与 x20-clutch **逐字相同**
// （2026-09-25 起基座 = noexplore 原公式逐字，wExplore 乘零）。
// 若 C-w 在 6h 中点被证伪杀掉，本臂自动转正为"续跑臂"独享容量（顺带回答"续跑会怎样"）。
//
// ══════════════════════════════════════════════════════════════════════════
// 0. 一句话
// ══════════════════════════════════════════════════════════════════════════
// **B 配置原样续跑，不加权** —— C-w 公式里多出的那一项，这里没有。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据与止损（与 C-w 同一页，方向相反）
// ══════════════════════════════════════════════════════════════════════════
// · 主读数相同：终点判决段配对差 + McNemar（414000，800 局，两臂各自同 seed 跑）。
//   门：差值 ≥ +2pp 且 McNemar p < 0.05；|差| < 2pp = 「无结论」。
//   配对失败回退：rotateSeed 不等 ⇒ 非配对 z 检验、门提到 ≥ +5pp（见 C-w §3）。
// · 6h 中点：**连续 2 个 eval 点差值 < −3pp** ⇒ 杀 Cw，本臂转正独享容量；否则双臂跑满
//   （单点 ±2pp 不杀；|差|小 = 无结论）。
// · 上限熔断（日常 mean < 6.19）/ 超时熔断（timeout_frac > 5%）同 C-w，停该臂。
// · 回测门（415000）：各自跑；C-0 的回测同时是"续跑回测"。
// · 起点 noex-it105、位移包、采样 49152 / mb 1024、seed_rotate 150 —— 全与 C-w 相同；
//   **同 `--seed` 且同 `--rotate-seed <V>` 起跑**（配对要求；开腿核对 rotateSeed，不等走回退）。
// · 半速风险与 C-w 相同（§6⑤）：12h 各约 85–90 轮，无结论也是答案。
//
{
  "version": 5,
  "name": "x20-clutch-null",
  "mode": "per-tick",
  // 环境不变：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：noexplore 原公式逐字（无惜败奖；wExplore 乘零）────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected - wApproach * where(pickupDist < 0, 0, pickupDist)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.0,
      "wPickup": 3.0,
      "wApproach": 0.008
    },
    // dense-only（与父腿一致）：terminal 空表合法。
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：noexplore 最优 it105（与 C-w 同起点 ⇒ 配对；2026-09-25 由 B-it175 切换）─
  "bc": "nn-training/weights/x20-noexplore/x20-noexplore.it105.20260922-053620.json",
  "kickstart_ref": false,

  // ── 配对（plan/accident.plan.md §2，2026-09-21）────────────────────────────
  // 与 x20-clutch **同一把 V**（机器按「同 V = 配对」核对两臂账本 run_start.rotateSeed）。
  // 20260921 = C 双腿实际起跑值（两臂账本一致）。改它 = corpus_identity_fp 变 ⇒ 本地一次重采。
  "paired_rotate_seed": 20260921,
  "warmup_iters": 0,

  // ── 预算（两臂共享集群，各约半速）────────────────────────────────────────
  "iters": 0,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：回基线（与 B / C-w 一致）──────────────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：与 noexplore / C-w 一致 ────────────────────────────────────────
  // 49152 = 48 × mb(1024) ⇒ 无 ragged tail。
  "target_transitions": 49152,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/x20-clutch-null/weights.json",
  "traj": "tmp/x20-clutch-null",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-clutch-null",
  "backup_prefix": "x20-clutch-null",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① bc 同 C-w（已存在）。② `remote_hubs["x20-clutch-null"]` 写入 rl-config，三课并行 slot
//    （双臂占一 GPU worker + floor 占第二个；2026-09-25 由两课口径更新）。
// ③ 新 out/traj 目录。④ 配对 rotateSeed 写在课程文件里（`paired_rotate_seed`，与 C-w **同一把 V**；
//    起跑即配对，不再经手指传——2026-09-21 §2 事故就是手工传错）。
//
// 启动：**控制台开课**（`bun run dashboard` → http://127.0.0.1:8900 → 选本课 → 开课），与 C-w 同时。
//   裸 CLI 启动已下线（plan/accident.plan.md §1）；agent 不得启动训练。
//
// ── 结算节（跑完回填）────────────────────────────────────────────────────
// 必填：① 判决段配对差 ② 本臂 vs it0 / noex-it105 绝对对照 ③ 分关表 ④ PPO 健康
//   ⑤ 超时/换血 ⑥ 中点决策记录。若转正为"续跑臂"，加填"续跑 verdict"。
//   2026-09-25 基座切换记录见 C-w §6⑦（本臂同步）。
//
// ── 结算（2026-09-26 回填；本臂 it201 由用户手动停，转正续跑任务完成）──────────
// 判语：**续跑零效应 + 配对 verdict 里对照胜出**。C-0 的角色已从"配对对照"转为"续跑臂"再到
//   "归档基线"：`nn-training/weights/x20-clutch-null/x20-clutch-null.it190.20260926-062625.json`
//   冻结为扩展基线（dodge 重试腿的同期对照候选）。
// ① 判决段配对差（414000，800 局同 seed；`tmp/x20-clutch-settle/judge-414000.jsonl`）：
//    本臂 low 34.62 vs C-w 32.38（配对差 +2.25pp 归 C-w 方向，但 McNemar p=0.35 不显著）。
// ② 绝对对照（414000，C-0@it190 vs it0=noex-it105）：low 34.62 vs 33.0（+1.62pp 反向）；
//    pass 18.75 vs 18.1（+0.65）；mean 8.38 vs 8.33（+0.05）；p10 2=2。
// ③ 分关表（本臂终点，414000）：s2000 low 35.0 / s2001 38.0 / s2002 33.0 / s2003 32.5
//   （it0 分关基线未设，只列本臂；约束"无 >5pp 退步"按配对差表判，见 C-w 文件③ ✓）。
// ④ PPO 健康（全程）：kl 均值 0.0114（max 0.0147）/ ent 均值 0.5971（min 0.518），无 break。
// ⑤ 超时全 0；换血见 C-w 文件⑤（两段反号，无一致结论）。
// ⑥ 中点决策：it46 22:08 被对称自杀**误杀**（实现 bug，非课程本意；DECISIONS
//    §2026-09-25-clutch-null-kill）→ it47 复活 + `self_kill=false` 开关 → 此后再无触发
//    （含 it223 C-w 被杀时本臂 streak 反向，开关生效只记录不停车）。
//    实际：账本 207 条 iteration 事件（最大 it201；含 it41 中断重采 + it46 误杀 + 两次
//    serve 重启；19:14→约07:00）。
// ⑦ 续跑 verdict（转正任务）——**零超噪声改善**：
//    · 414000（@it190）：上表 ②（low 反向 +1.62pp，mean +0.05）。
//    · 415000（@it190）：low 33.00 vs it0 36.9（−3.9pp）；mean 8.29 vs 7.44（+0.85）——
//      与判决段反号，两段合读 = 噪声（800 局 SE~1.7pp）。
//    · 日常配对基线实验（bc 现跑 400 局 vs it201，同 860001 种子；
//      `tmp/x20-clutch-null-settle/daily-baseline-860001.jsonl`）：胜率 +1.0pp，
//      McNemar p=**0.77**（53/49）；均杀 +0.52，z=+1.17——不显著。
//    · 峰值核查（it190 为 13 点最高，专挑它验；`.../daily-peak-860001.jsonl`）：
//      it190 +4.75pp p=0.079（13 选 1 未校正）、it195 −0.50pp p=0.92——瞬态尖峰，
//      5 轮即过期，"稳定高于"不成立。
//    ⇒ 续跑 ~95 轮（it105→it201 有效训练）：**不会怎样**。C 腿至此全结。
