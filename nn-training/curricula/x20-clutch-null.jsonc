// 课程 x20-clutch-null —— **C 腿空对照臂**（与 x20-clutch 配对并行）
//
// 状态：**已起草，待用户手工开训**（agent 不得启动训练；与 C-w 两臂同时开）。
//
// 本文件的唯一作用：给 C-w 提供配对差值（`C0 low% − Cw low%`），分离"加权效应"与
// "续跑效应"（B 腿的总量混杂教训，§109）。除奖励公式外，与 x20-clutch **逐字相同**。
// 若 C-w 在 6h 中点被证伪杀掉，本臂自动转正为"B 续命臂"（顺带回答"B 续命会怎样"）。
//
// ══════════════════════════════════════════════════════════════════════════
// 0. 一句话
// ══════════════════════════════════════════════════════════════════════════
// **B 配置原样续跑，不加权** —— C-w 公式里多出的那一项，这里没有。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据与止损（与 C-w 同一页，方向相反）
// ══════════════════════════════════════════════════════════════════════════
// · 主读数相同：终点判决段配对差 + McNemar（414000，800 局，两臂各自同 seed 跑）。
//   门：差值 ≥ +2pp 且 McNemar p < 0.05；|差| < 2pp = 「无结论」。
//   配对失败回退：rotateSeed 不等 ⇒ 非配对 z 检验、门提到 ≥ +5pp（见 C-w §3）。
// · 6h 中点：**连续 2 个 eval 点差值 < −3pp** ⇒ 杀 Cw，本臂转正独享容量；否则双臂跑满
//   （单点 ±2pp 不杀；|差|小 = 无结论）。
// · 上限熔断（日常 mean < 6.19）/ 超时熔断（timeout_frac > 5%）同 C-w，停该臂。
// · 回测门（415000）：各自跑；C-0 的回测同时是"B 续跑回测"。
// · 起点 it175、位移包、采样 48000 / mb 1024、seed_rotate 150 —— 全与 C-w 相同；
//   **同 `--seed` 且同 `--rotate-seed <V>` 起跑**（配对要求；开腿核对 rotateSeed，不等走回退）。
// · 半速风险与 C-w 相同（§6⑤）：12h 各约 85–90 轮，无结论也是答案。
//
{
  "version": 5,
  "name": "x20-clutch-null",
  "mode": "per-tick",
  // 环境不变：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：B 原公式逐字（无惜败奖）────────────────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected - wApproach * where(pickupDist < 0, 0, pickupDist)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.2,
      "wPickup": 3.0,
      "wApproach": 0.008
    },
    // dense-only（与父腿一致）：terminal 空表合法。
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：B 终点 it175（与 C-w 同起点 ⇒ 配对）────────────────────────────
  "bc": "nn-training/weights/x20-steady/x20-steady.it175.20260920-215502.json",
  "kickstart_ref": true,
  "warmup_iters": 0,

  // ── 预算（两臂共享集群，各约半速）────────────────────────────────────────
  "iters": 0,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：回基线（与 B / C-w 一致）──────────────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：与 B / C-w 一致 ────────────────────────────────────────────────
  "target_transitions": 48000,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/x20-clutch-null/weights.json",
  "traj": "tmp/x20-clutch-null",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-clutch-null",
  "backup_prefix": "x20-clutch-null",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① bc 同 C-w（已存在）。② `remote_hubs["x20-clutch-null"]` 写入 rl-config，两课并行 slot。
// ③ transport 必须显式 `--remote-transport pull`。④ 新 out/traj 目录。
// ⑤ 同 `--seed` 且同 `--rotate-seed <V>` 配对（V 与 C-w 相同；开腿核对 rotateSeed）。
//
// 启动（**用户手工；agent 不得启动训练**，与 C-w 同时开）：
//   bun dashboard/src/launch/cli.ts --script run_rl.py --course x20-clutch-null \
//     --remote-transport pull --rotate-seed <V> --detach
//
// ── 结算节（跑完回填）────────────────────────────────────────────────────
// 必填：① 判决段配对差 ② 本臂 vs it0 / B 终点绝对对照 ③ 分关表 ④ PPO 健康
//   ⑤ 超时/换血 ⑥ 中点决策记录。若转正为"B 续命臂"，加填"B 续跑 verdict"。
