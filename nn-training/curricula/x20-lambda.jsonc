// 课程 x20-lambda —— **λ 腿：信用窗 0.95 → 0.98**（train-following §5.1 首选）
//
// 状态：**已收官（2026-09-22 07:45 用户手工停腿）** —— it1–156（09-21 23:48 → 09-22 07:45，~8h）；
//   判语：**双阴性（曲线无趋势＋value 无改善），信用窗不是瓶颈**（详见本文件结算节）。
//   ⚠ 本腿开跑时课程文件无 `paired_rotate_seed`（评审只给 noexplore 补了），实际 rotateSeed =
//   1790012785 ≠ B（1789876303）⇒ 与 B 只能做非配对对照；终点判决差距远大于配对/非配对之差，
//   结论不受影响，但下次开腿前配对字段必须先行。
//
// 立项：§117 结构机制 —— γλ 视界 ~150t，死亡因果链 230–500t，早期决策学不到"活下去再 farm"；
//   V 无法自举没去过的状态。λ 0.95→0.98 把信用窗推到 ~500t，覆盖死亡链全程。
//   仓内先例 c5-gae（λ 单变量 +18pp，不同课程）；与 wExplore 腿正交（一个管"看得见多远"，
//   一个管"往哪看"），三腿（B/noexplore/lambda）同一起点可直接比较。
//
// 单变量纯度：与 x20-steady **逐字相同**，只改 `lam: 0.95 → 0.98`。
//   gamma 不动（0.998）；其余采样/mb/奖励/schedule 全同 B。
//
// 起点：与 A/B 同起点 it30（`x20-rebirth.it30`），kk=1 natural。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据
// ══════════════════════════════════════════════════════════════════════════
// **主读数 = 日常 low% 轨迹**（860001 段 400 局，每 5 轮）+ 与 B/noexplore 同 it 点三路对照。
//   it40 检查点：三腿分叉即有读数（哪条先下移）。
// **机制读数 = value 曲线下面积**：λ 生效应伴随 value 头拟合改善（§5.1 观察项：头宽 128 是否欠拟合）。
//   若 low% 动而 value 不动 ⇒ 读数存疑，查实现。
// **约束（熔断优先级最高）**：日常 mean < 6.19 立即停；超时 >5% 立即停；
//   另盯方差（λ↑ 天然增方差：kl/ent 抖动幅度 vs B 对照，炸了即停）。
// **回测门**：终点候选 415000 不劣于 B 终点（同段同种子配对）。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损
// ══════════════════════════════════════════════════════════════════════════
//   · **it40 主检点**：low% 相对 it0 无 ≥−3pp 下移 ⇒ 停腿（信用窗不是瓶颈）。
//   · **上限熔断**：日常 mean < 6.19 ⇒ 立即停。**超时熔断**：>5% ⇒ 立即停。
//   · **方差熔断**（本腿特有）：kl 连续 3 轮 ≥0.075（B 健康带 ~0.01）⇒ 停腿（λ 的方差税爆了）。
//   · **机械横盘**：low% 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮。

{
  "version": 5,
  "name": "x20-lambda",
  "mode": "per-tick",
  // 环境不变：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：B 原公式逐字（本腿不动奖励）────────────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected - wApproach * where(pickupDist < 0, 0, pickupDist)",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.2,
      "wPickup": 3.0,
      "wApproach": 0.008
    },
    // dense-only（与父腿一致）：terminal 空表合法。
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：与 A/B 同一个 it30 ─────────────────────────────────────────────
  "bc": "nn-training/weights/x20-rebirth/x20-rebirth.it30.20260919-085629.json",
  "kickstart_ref": true,
  "warmup_iters": 0,

  // ── 预算 ───────────────────────────────────────────────────────────────
  "iters": 0,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：回基线（与 B 一致）────────────────────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  // ★ 唯一变量：lam 0.95 → 0.98（信用窗 ~150t → ~500t）
  "lam": 0.98,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：与 B 一致 ──────────────────────────────────────────────────────
  "target_transitions": 48000,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/x20-lambda/weights.json",
  "traj": "tmp/x20-lambda",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-lambda",
  "backup_prefix": "x20-lambda",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① bc 文件存在（与 A/B 同一个，已验证）。
// ② transport：**必须显式 `--remote-transport pull`**；PPO 云机（禁本机 CPU）。
// ③ 新 out/traj 目录（禁续跑，§15.5）。
// ④ remote_hubs 登记 + slot 容量 + worker 心跳（开训前确认；与 x20-noexplore 共享集群，
//    双腿并行约半速，属预期内 —— 三腿（B 已结束，只剩两条活腿）实际是双腿并行）。
// ⑤ lam 值三重核对（0.98，见 §5.1；错一位小数就是另一个实验）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台，可与 x20-noexplore 同时开）：
//   开课 x20-lambda（训练模式 在线，rollout 本机，PPO 云机）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常三路对照表：B（历史）/ noexplore / lambda 同 it 点 low%/mean/p10。
// · value 头曲线（机制读数）+ kl/ent 方差对照（熔断用）。
//
// ── 结算节（2026-09-22 回填，终点 = it156 `x20-lambda.it156.20260922-074523.json`）──
// ① 日常 low%：it0 44.0/6.88/p1 → it25 mean 5.94（单点跌破熔断未停，事后对）→ it40 42.5/6.86/p1
//    （主检点 −1.5pp 未过）→ it55 34.2 孤点 spike（it50 44.2/it60 44.8，立刻 revert）→ it130 34.5
//    孤点（同剧本）→ 终点 it155 41.8/6.66/p1（−2.2pp，p10 万年 1）。全程无趋势，走势复刻 x20-floor
//    式震荡。rollout 胜率 0.06–0.11 全程偏低（终点 it156：0.088）。
// ② pooled 均杀（停机后补跑，800 局）：414000 = **36.0/7.12/p1/pass 10.9%**（vs B 终点 35.5/
//    7.84/p2/15.1%：low% 持平 +0.5pp，mean −0.72，p10/pass 全劣）；415000 = **40.2/6.91/p1/
//    11.2%**（vs B 38.9/7.76/15.4%：全劣）。回测门（415000 不劣于 B）**不过**。
// ③ 分关表：未达判读价值（终点全劣），略（414000 四 unit low% 32–41 档，p10 全 1）。
// ④ value 拟合（机制读数）：PPO value loss 全程 ~0.58–0.66 平坦；同期 noexplore ~0.45–0.50 且
//    缓慢下降。λ 预期带来的 value 改善**没出现** —— 机制阴性（且方向反向，欠拟合另有原因，
//    非信用窗）。
// ⑤ 超时/换血：超时全程 0；kl 全程 0.010–0.016（max 0.0156），方差熔断（≥0.075×3）从未接近 ——
//    "λ 引爆方差"的担忧结案，但属"无税也无效"；ent 0.59–0.69 远高于 0.25 线。
// ⑥ 实际轮数与耗时：it1–156，~8h（预算 12h 未用满；it150 已无趋势，提前停合理）。
// 终局判语：**双阴性**。信用窗 150t→500t 既没有带来 low% 趋势，也没有带来 value 改善，
//   §117 的结构机制假说（看不见死亡链）在本课程上不成立。数据：
//   `tmp/x20-lambda/judge-414000-it156.jsonl`、`backtest-415000-it156.jsonl`。
