// 课程 y20-dist2 —— 时间轴重标腿：y20-dist 崩盘修复（只动时间轴，其余逐字）。
// 状态：已结课（2026-10-17 停腿；超时清零但胜率平台 0.65 未过门；见尾部结课报告）。
// 规格来源 = 本头注（agent 只给文件，**开课 = 人在控制台点**；与 y20-stack2 并行）。
//
// 立项 → 用户 2026-10-16：y20-dist/y20-stack 已停课（eval 超时占比 dist 23%/stack 43%，
//   胜 ticks 7928→9500~10000 越学越慢；y20-obs 全程超时 0%、胜 7928→6159 越学越快）。
//   根因 = 时间锚未跨场：wWin (3900-clearTick)/1400 是 c05 锚（c05 胜 ~2038 ticks → +6.65），
//   到 c20（胜 6500~9500）恒为 -9~-20/胜，慢胜不如超时（-5）、超时不如速败（0）；
//   terminal.timeout -5 在 c05 是 killEV~14.5 的 34%，到 c20（killEV~46）只剩 ~6%，威慑稀释。
//   关卡 `ladder-c20-lives1` 不变。
//   起点 y5-dist.it270（`weights/y5-dist/y5-dist.it270.20261016-102810.json`，
//   sha16 `65ec5b9224028b35`；同代直连，kickstart 关，opt fresh §15.5）。
//   与崩盘腿同起点 = 干净对照（成了是修复的功，败了是剂量不对）；不用 y20-obs 中间权重
//   （运行中 it212/500 无冻结"最佳"，且政策偏置反向会混淆归因；obs 毕业后再链式加速另开）。
//   两腿共享新种子 20270202（20270201 三腿已用过，§15.1 防记忆化；dist2/stack2 共享＝两路可比）。
//
// ── 单变量声明（相对 y20-dist：只动时间轴两键；其余逐字）──────────────────────
//   wWin 分子 3900→**8000**（分母 1400/wWin 5.0 不动）：healthy 胜 6200 → +6.4（对齐 c05 +6.65）；
//     慢胜 9500 → -5.4（难受但可接受）；
//   terminal.timeout -5.0→**-15.0**（c20 killEV~46 的 33%，对齐 c05 34%；且慢胜 -5.4 > -15，
//     收尾恒优于拖满，倒置排名消失）；
//   wDist 0.6/wMiss 0.35/wEncl 12.9/wNearSq 48/wCorner 110/wThreat 120/wHurt 110/wHit 0.6/wAcc 15.3
//     及退火表/K/流/eval 全 HOLD（shaping 过载若还在，下轮再调，本轮不混）。
//   双分支：超时占比回落到 ≤5% 且胜 ticks 不再膨胀 ⇒ 时间轴是病根；超时仍爆 ⇒ 另有病根，杀。
//
// ── 门（同 y20-dist：c20 暂定线，it0 基线条款照旧）────────────────────────────
//   主：+60 win ≥ 0.70；次：kills ≥ 16.5/20；命耗线：+60 gameover 占比 ≤ 30%（基线 ~38%）；
//   反 watch：timeout 占比 ≤ 5%，超 ⇒ 仍为避战而苟，**杀腿**；
//   D01 ≤ 85 护栏（+it0 校准）；fear-watch：shots/局 < 16 且 kills < 10 即恐惧塌，杀（c20 量级，+it0 校准）；
//   fail ⇒ **杀腿**。门读 headline（混合 eval）；s2000 切片为 c20 真值附读（2000=abcd）。
//   上报：policy_new_rms＋it5 analytic 照旧。
//   终点：三线全过 ⇒ 收官（iters 500 为 cap，以落盘值为准）。
//
// ── 训练设置 ────────────────────────────────────────────────────────────────
//   anchor 0.001（legacy 空片，无害）；ent_break 0.0＋max_winrate 0.0（熔断全拆，y 系现行惯例）；
//   batch 24576；优化器/K 冻结（退火表与 y20-dist 同）。
//   iters 500，max_hours 48，workers 8，eval 混合（"2000-2003"×50，同口径逐行可比）。
//   ⚠ 前提：tmp/y20-dist2 不存在（§15.5 新 out/traj＋本条 DECISIONS，不得续跑）。
//
// ── 起点纪律 ────────────────────────────────────────────────────────────────
//   · 环境键全在 level（`ladder-c20-lives1`），课程**不重复** stages 等键。
//   · 起点播种后核对 rotateSeed；`manifest.it == plan.start_it + 1`（课程轮从 1 起，与 bc 轮号无关）；
//     `bc=` 非 resume。
//   · §15.5 新实验：新 out/traj（tmp/y20-dist2）+ backup 新目录（nn-training/weights/y20-dist2）+ opt fresh。
//
// ── 结课报告（2026-10-17 停课；时间轴修复成功、三线未过，用户拍板）──────────
//   跑量：第 1 到 319 轮（最后一轮 21:43 用户掐停；评估到第 315 轮，第 0 轮 200 局其余 400 局）。
//   轨迹：第 0 轮胜率 0.595 → 第 200 轮 0.665/杀敌 16.55 → 第 260 轮 0.665/16.83（队史峰）
//     → 第 315 轮 0.652/16.43。64 轮评估超时基本是 0；获胜耗时 6600~7500 拍不再膨胀；
//     训练采样胜率 0.55~0.63；策略熵 0.70~0.78 健康；无崩盘，是平台期。
//   池外 800 局（新种子段，集群派发）：第 260 轮胜率 0.686、杀敌 16.80 为本腿最优，
//     仍低于 stack2 第 200 轮（0.701/17.04）。
//   门（终盘第 315 轮）：主线 0.652<0.70 不通过；次线 16.43<16.5（差 0.07）接近；
//     命耗尽 34.7%>30% 不通过；超时 0% 通过。峰值第 260 轮同样三线未全过。
//   结论：时间轴重标成功（超时从 23% 清零、胜耗时止涨），杀线解除；但 plateau 在 0.65~0.67，
//     病根从时间轴转成 shaping 过重（威胁/角落/贴脸/打空惩罚约 obs 腿 1.5~2 倍，
//     获胜耗时慢 obs 约 1000 拍）。原定接续 dist3 文件已删，本腿暂无后继。
//   证据：tmp/y20-dist2/{training_log,eval_log}.jsonl · tmp/pool800/rows.jsonl ·
//     nn-training/weights/y20-dist2（第 260 轮池外最优＋最后一轮 319）。
{
  "version": 5,
  "name": "y20-dist2",
  "mode": "per-tick",
  "level": "ladder-c20-lives1",

  "reward": {
    "formula": "wKill*kills + wHit*aimHits - wDmg*playerDamageTaken - wMiss*aimMisses + wPickup*powerUpsCollected - wApproach*where(pickupDist<0, 0, pickupDist) + wAcc*aimHits/(playerShots+1) + wDist*aimHitDistSum/(aimHits+1) + wWin*where(clearTick>=0, (8000-clearTick)/1400, 0) - wHurt*hurtWeight/(ticks+1) - wEncl*enclWeightTicks/(ticks+1) - wCorner*cornerWeightTicks/(ticks+1) - wThreat*threatTicks/(ticks+1) - wNearSq*nearSqSum/(ticks+1) - wBlock*(idleTicks-stopTicks)/(ticks+1) + wFrFreeze*puGotFreeze + wFrBomb*puGotBomb + wFrStar*starsCollected + wBackHits*backHits",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wMiss": 0.35,
      "wPickup": 3.0,
      "wApproach": 0.008,
      "wAcc": 15.3,
      "wDist": 0.6,
      "wWin": 5.0,
      "wHurt": 110.0,
      "wEncl": 12.9,
      "wCorner": 110.0,
      "wThreat": 120.0,
      "wBlock": 110.0,
      "wNearSq": 48.0,
      "wFrFreeze": 2.0,
      "wFrBomb": 2.0,
      "wFrStar": 3.0,
      "wBackHits": 0.4
    },
    "terminal": {
      "timeout": -15.0
    },
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：y5-dist.it270（sha 见头注；同代直连，kickstart 关）──
  "bc": "nn-training/weights/y5-dist/y5-dist.it270.20261016-102810.json",
  "kickstart_ref": false,
  "warmup_iters": 0,

  // value 门控牵引率 ρ（出生安全件，非变量；legacy 空片下无物可拴，无害）。
  "value_anchor": 0.001,

  "iters": 500,
  "max_hours": 48,

  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "until_iter": 240, "kl_coef": 0.05, "lr": 0.00015, "kl_cap": 0.1 },
    { "kl_coef": 0.05, "lr": 0.0001, "kl_cap": 0.1 }
  ],

  "target_transitions": 24576,
  // y 系流（新种子 20270202；与 y20-stack2 共享＝两路可比）。
  "paired_rotate_seed": 20270202,

  "decision_events": false,
  // K=10（K=1 探针已证 cadence 无罪）。
  "decision_k": 10,

  "out": "tmp/y20-dist2/weights.json",
  "traj": "tmp/y20-dist2",
  "ent_break": 0.0,
  "ent_break_max_winrate": 0.0,

  "backup_dir": "nn-training/weights/y20-dist2",
  "backup_prefix": "y20-dist2",

  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}
