// 课程 z2-r5nav —— E2-A 观测距离场：v7 **单通道** ch16 distEnemy（2026-11-01）
//
// 状态：**未开课**（本文件只做预注册；开课由人在控制台走 W4 会话）。
//
// ══ 唯一变量 ═══════════════════════════════════════════════════════════
//   观测 v7（全局代码）：`OBS_CHANNELS 16→17`，ch16 = 单位成本多源 BFS 到最近激活敌。
//   **不做** ch17 distPickup / s46 bestPickupValue（E0b′ 判 ch17 冗余；单变量纪律）。
//   本课配置与对照 `z3-p2002ctl` **逐字相同**（reward / 关卡 / 预算 / eval / seed），
//   只有 name / out / traj / backup_* 与 `bc` 不同 ⇒ A vs C 的差分只归因观测。
//
// ── 起点 ───────────────────────────────────────────────────────────────
//   guard it500（wver 0c8795f767f161e1）→ `worker/scripts/migrate_obs_channel.py`
//   三段式迁移（旧 obs | 新列 0 | coord 后移）：
//   `nn-training/weights/z2-r5nav/z2-r5nav.it0.20261101-230656.json`
//   迁移自检：旧 schema 输入下四头 logits **逐位相等**（新列权重 = 0）
//   ⇒ it0 与 guard it500 行为相同（TS 侧 inCh 由 stem 形状反推）。
//
// ── 对照臂 ─────────────────────────────────────────────────────────────
//   `z3-p2002ctl` it150（200 局/关 × 4 = 800 局，`tmp/_z3an/fresh-p2002ctl`）：
//   2002 基毁 **90.0%** / clear **6.0%**（与起点同值 ⇒ 干净对照）。
//   主判决 = it150 的 2002 **基毁率配对**（灰区规则见 plan/r5-next.plan.md §5.2），
//   clear 降为副读数。
//
// ── 预注册判据（开课前冻结，不要事后改）───────────────────────────────
//   1) 主：it150 vs C 的 2002 基毁率配对（净降 ≥8 局且 p<0.05 = 过；
//      净降 4–7 且 p∈(0.05,0.25) = 未定；其余 = 不过）。
//   2) 机制：it150 `wallPress/千` ≤ 本课 **it0** 的 75%（−25%）。
//      ⚠ C 的 800 行产在机制两列落地之前，没有 wallPressTicks/aliveTicks
//      ⇒ 基线一律取本课 it0（drop0 起点 = guard it500 行为），不拿旧行硬算。
//   3) 接线：it150 `--ablate-ch 16` 的翻转率 ≥ 同批 `--ablate-ch 0`（地形砖，阳性对照）
//      的 1/3；并同报 `stem.weight` 第 16 列（新通道）的 L2。
//   4) 止损：entropy <0.7×起点连续 5 点；共同反签名（`lives_exhausted` >20% /
//      `aimHits` 掉 >15% / `cellsVisited` 掉 >10% / `aimBricks` 涨 >30%）任一即停。
//   5) 逐关：2000 / 2001 / 2003 各 −3pp 内；OOD 70 局掉 >5pp ⇒ 专化/记忆化。
//
// ── 运行约束 ───────────────────────────────────────────────────────────
//   · W4 独立会话（`OBS_SCHEMA_MAJOR 7`）；不与任何旧 schema 腿并发（代码快照会话锚定）；
//   · 节点先换到本次 v7 代码快照（`src/nn/*` 与 `tools/sim/export-*` 在 codehash 集）；
//   · `iters 160 / eval_every 25` ⇒ 只认 **it150**；it25–125 只作止损，不用于晋级；
//   · 开课后不要编辑本文件（课程字节变 = 新实验版本，热加载会按 A 类拒收）。
//
// ── 语义护栏 ───────────────────────────────────────────────────────────
//   ch16 是「到最近敌的路距」：E0b′ 实测最近敌 ≠ 距基地最近敌占 29.0%（2002 关 36.2%）
//   ⇒ 它是**导航/交战**通道，**不是**回防通道；读数不得按「保护基地」解释。

{
  "version": 5,
  "name": "z2-r5nav",
  "mode": "per-tick",
  "level": "classic35",
  "stage_select": "16,22,3,6",
  "enemies": 20,
  "lives": 3,
  "max_ticks": 20000,
  "reward": {
    "formula": [
      // 收入
      "wKill*kills",
      "+ wHit*aimHits",
      "+ wWin*where(clearTick>=0, 1, 0)",
      // 机制
      "+ wBase*baseWallIntact",
      // 价格
      "- wDmg*playerDamageTaken",
      "- wDeath*playerDeaths",
      "- min(paceCap, wPace*max(0, ticks - kills*paceTicks)/paceWindow)",
      // 塑形
      "+ wBrick*min(aimBricks, brickCap)",
      "+ wWalk*where(cellsVisited>walkCap, walkCap, cellsVisited)",
      // 收入
      "+ wPickup*min(powerUpsCollected, pickupCap)",
      // 机制
      "- wThreat*min(threatTicks, threatCap)",
      "- wDef*min(capDef, max(0, basePressureSum - pDef*basePressureSamples))",
    ],
    "params": {
      "wKill": 15.0,
      "wHit": 1.5,
      "wWin": 60.0,
      "wBase": 3.0,
      "wDmg": 0.12,
      "wDeath": 18.0,
      "wPace": 6.0,
      "paceTicks": 1200.0,
      "paceWindow": 1000.0,
      "paceCap": 36.0,
      "wBrick": 0.25,
      "brickCap": 12.0,
      "wWalk": 1.0,
      "walkCap": 20.0,
      "wPickup": 4.0,
      "pickupCap": 6.0,
      "wThreat": 0.01,
      "threatCap": 500.0,
      "wDef": 2.5,
      "pDef": 0.15,
      "capDef": 80.0,
    },
    "terminal": {
      "timeout": -50.0,
      "lives_exhausted": -35.0,
      "base_destroyed": -35.0,
      "stage_clear": 0.0,
    },
    "scheme": "toy",
  },
  "dodge": "",
  "bc": "nn-training/weights/z2-r5nav/z2-r5nav.it0.20261101-230656.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  "value_anchor": 0.001,
  "iters": 160,
  "max_hours": 4.0,
  "lr": 0.00012,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": false,
  "gamma": 0.998,
  "lam": 0.95,
  "ppo_schedule": [
    {
      "kl_coef": 0.05,
      "lr": 0.00012,
      "kl_cap": 0.1,
    },
  ],
  "target_transitions": 24576,
  "paired_rotate_seed": 20261028,
  "decision_events": false,
  "decision_k": 10,
  "out": "tmp/z2-r5nav/weights.json",
  "traj": "tmp/z2-r5nav",
  "ent_break": 0.0,
  "ent_break_max_winrate": 0.0,
  "backup_dir": "nn-training/weights/z2-r5nav",
  "backup_prefix": "z2-r5nav",
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 200,
  "eval_every": 25,
}
