//      2000 局 clear 84.85% / timeout 9.15% / gameover 6.00% ⇒ 两种死法都得砍。
//   ② 语料侧两处实测缺陷（`o2-win-polish-recon.txt` / `o2-polish-quota.txt`）：易关吃
//      **50.7%** 采样预算（已饱和 95%+）；greedy **loss 桶只填 0.59×**、
//      `degraded=cap_hit=0.72` ⇒ 抬比例是空操作，杠杆是抬 `oversample_cap`。
//      ⇒ 后继 `o2-polish` 钉 2002/2003（相对浓度 2:1）+ cap 2→4，**不动奖励**。
//   ③ 只读引用本腿权重的后继：`o2-pick` / `o2-nomove` 用 **it175**（拾取线）、
//      `o2-polish` 用 **it236**（胜率线）。归档权重完整，停课**不破坏**任何后继起点。
//   ④ **停课非破坏**；复跑须按 §15.5 用新 out/traj，禁续跑 `tmp/o2-notax3`。
//   ⑤ **B/C 锚未测**是本课最大遗留；`polishbc` 未出前，不许把本节 A 层数字当 B/C 成绩。
//   ⑥ 产物：`tmp/o2-notax3/{eval_log,training_log}.jsonl` · `weights/o2-notax3/*.json` ·
//     `tmp/o2-analysis/o2-closeout-20261112.txt`（48 点全表 + 判据扫描）·
//     `o2-win-polish-{recon,stability}.txt` · `o2-winpolish-{gap,probe}.txt` ·
//     `o2-polish-{quota,stage-trend}.txt`；结课档案即本文件头注 + 本节。
//   ⑦ 本结课报告**只改注释** ⇒ `course_formula_hash`（reward spec identity）不变；
//     文件字节 sha256 变，本课已停课不再启动，不影响在跑腿。
// ══════════════════════════════════════════════════════════════════════════

{
  "version": 5,
  "name": "o2-notax3",
  "mode": "per-tick",
  "level": "classic35-safe-base",
  "stage_select": "16,22,3,6",
  "enemies": 2,
  "lives": 1,
  "max_ticks": 3000,
  "reward": {
    "formula": [
      "wKill*kills",
      "+ wHit*aimHits",
      "+ wWin*where(clearTick>=0, 1, 0)*min(cellsVisited/runCap, 1)",
      "+ wFast*where(clearTick>=0, 1, 0)*max(0, fastCap - clearTick)/fastCap",
      "+ wMove*min(ticks - idleTicks, moveCap)",
      "- wShot*min(playerShots, shotCap)",
      "- wWall*min(wallPressTicks, wallCap)",
      "- wWall2*min(max(0, wallPressTicks - wallCap), wallCap2)",
      "- wStuck*min(stuckTicks, stuckCap)",
      "- wStuck2*min(max(0, stuckTicks - stuckCap), stuckCap2)",
      "- wIdle*min(max(0, idleTicks - idleFree*min(ticks, ticksShouldWin)), idleCap)",
      "- wIdle2*min(max(0, idleTicks - idleFree*min(ticks, ticksShouldWin) - idleCap), idleCap2)",
      "- wDmg*min(playerDamageTaken, dmgCap)",
      "- wDeath*playerDeaths",
      "- wThreat*min(threatTicks, threatCap)",
      "- wThreat2*min(max(0, threatTicks - threatCap), threatCap2)",
      "+ wLaneMove*min(onLaneMoveTicks, laneCap)",
      "- wDanger*min(dangerTicks, dangerCap)",
      "- wDanger2*min(max(0, dangerTicks - dangerCap), dangerCap2)",
