// 课程 x3-start —— v3 阶梯 3 敌 RL 起步课（对齐 roadmap c03 / ladder_factory）
//
// 命名：v3 用 **xN** 前缀，避免与 v2 的 cN/pN 混淆（有意为之，不改回 cN）。
// x3-start <=> count=3 · RL 起步。对照：roadmap §5.3「c03 破包围」+ I3 工厂
// emit_course(count=3)；奖励按 N3 + rewards.codex.md；c01-c03 不上 wChip
// （roadmap 总规则优先，表内「轻剂量」作废，以总规则为准）。
// xN 与工厂 ladder-c03 曾是两套 count=3 任务定义并存；B 案落地后工厂已吸收
// xN 语义（多变体 + 干净奖励，DECISIONS §2026-09-15-goalnn-xn-absorb · 全文 → docs/nn/experiments.md §33），
// ladder-c03 与 arena3 逐关同形（单测钉死），x3-start 转为试点存档腿（权重链保留）。
//
// 环境：`"level": "arena3"` —— 空场 3 敌，**四种三元组**（abc/abd/acd/bcd，
//   a=basic b=fast c=power d=armor），自定义关 ID 2000-2003。max_ticks=2700。
// 起步权重：实为 x2-start.it50（第一轮正式门 967/1200=80.6% 权重；§5.7 暖启=
//   初始化手段，跨 count 跌落见下）。x2 后两轮门 79.2%/79.7% 未毕业，acbc 专项腿
//   证伪后用户特批 x3 先行（毕业链弯一次，x2 门日后召回补）——实际开工即 it50，
//   占位转正。
// 起点探针（2026-09-14，贪心各 4 关×100 局种子 0-99：
//   tmp/r1-arena3/arena3-student-it50.jsonl + arena3-god.jsonl）：
//   student（实际暖启 x2-start.it50 零样本；it75 同口径 226/400=56.5%，方向一致）：
//   ┌────────┬─────────────┬───────┬─────────┬───────────┬─────────┬────────┐
//   │ 关     │ 类型组        │ pass  │ kills均 │ 被击中/局  │ 开枪/局   │ 均tick │
//   ├────────┼─────────────┼───────┼─────────┼───────────┼─────────┼────────┤
//   │ abc    │ b+f+p       │ 62%   │ 2.09    │ 0.38      │ 10.9    │ 934    │
//   │ abd    │ b+f+a       │ 59%   │ 2.04    │ 0.41      │ 12.1    │ 989    │
//   │ acd    │ b+p+a       │ 39%   │ 1.36    │ 0.61      │ 9.0     │ 733    │
//   │ bcd    │ f+p+a       │ 55%   │ 2.01    │ 0.45      │ 10.5    │ 883    │
//   │ pooled │ 全部         │ 53.8% │ 1.88    │ 0.46      │ 10.7    │ 885    │
//   └────────┴─────────────┴───────┴─────────┴───────────┴─────────┴────────┘
//   god（2026-09-14，贪心 4 关×100 局种子 0-99：tmp/r1-arena3/arena3-god.jsonl）：
//   ┌────────┬─────────────┬───────┬─────────┬───────────┬─────────┬────────┐
//   │ 关     │ 类型组        │ pass  │ kills均 │ 被击中/局  │ 开枪/局   │ 均tick │
//   ├────────┼─────────────┼───────┼─────────┼───────────┼─────────┼────────┤
//   │ abc    │ b+f+p       │ 82%   │ 2.57    │ 0.21      │ 10.5    │ 908    │
//   │ abd    │ b+f+a       │ 85%   │ 2.64    │ 0.16      │ 13.5    │ 1154   │
//   │ acd    │ b+p+a       │ 56%   │ 1.90    │ 0.44      │ 10.4    │ 912    │
//   │ bcd    │ f+p+a       │ 77%   │ 2.46    │ 0.26      │ 12.3    │ 1030   │
//   │ pooled │ 全部         │ 75.0% │ 2.39    │ 0.27      │ 11.7    │ 1001   │
//   └────────┴─────────────┴───────┴─────────┴───────────┴─────────┴────────┘
// 解读：学生起点 53.8% 未饱和，可开腿；教师只管 BC 起步，不判难度/门 §0.2。
//   跨 count 跌落 x2~80%→53.8%（−26pp）大于 D10 先验 9-13pp/级——主因是 power
//   三元组相对更难（非几何本身），且显著提升须来自级内杠杆（D10，本腿 it10
//   即 +8pp 已兑现一半）。it75 同口径 56.5%，与 it50 方向一致。
//   god 分布事实（非难度判定）：最弱关 acd 56%（power+armor 双肉组合；x2 门里
//   含 power 的 ac/bc 同样最弱——跨 count 同构现象，I4 报告继续按关拆）；
//   god pooled 75.0% < 80% 门是常态（教师有缺陷非天花板），学生靠级内 PPO 超越。
// 先验（x2 正式门证据）：含 power 的关最弱（x2 门 ac 0.65/bc 0.715，均为含 power
//   关）；零样本学生亦然（acd 39% 最弱），但 abd 59% 未如预期最高（abc 62% 反超）
//   ——排序未全中，I4 报告继续按关拆，以实测为准。
// 晋级门（roadmap D4 单轨门，I4 双轮）：
//   两次正式门评估 pooled 点估计 >=80%（每次 4 关×200=800 局，共 1600；
//   两轮种子不重叠、间隔 >=5 训练轮，pass=win ∪ cleared）。日常 eval 用 50/关
//   降开销（4×50=200 局/次），门前才跑 200/关。
// 开工假说（§5.7）：kill/hit 稠密信号 + wWin 清场尖峰驱动，it40 前 pooled 爬升；
//   60 轮内无爬升即证伪停腿（防 c6-bonus 式盲跑）。
//
// 收官总结（2026-09-15，it333 收账：云机用户已停，loop 无进展；60 轮证伪条款
//   已触发，停腿待用户一句话）：
//   曲线：零样本 53.8% → it10 日常 67.5%（+14pp，假说前半兑现），之后 320 轮
//   横盘 0.65-0.72（67 个日常点 mean 0.669，800 局三锚点 it180/it280/it333 =
//   69.4/67.8/69.5，带宽 1.7pp）——后半未兑现，证伪条款已触发（停腿待决断）。
//   正式门一（it333，种子 0-199）：pooled 556/800=69.5%
//  （abc 73.5/abd 76.0/acd 60.0/bcd 68.5），距 80% 差 10pp，无趋势。
//   机器健康（value 0.23/熵 0.58/KL 0.002，无 halt）—— plateau 是信号配方到顶，
//   不是训练事故。acd 被钉死 59-60（三锚点），power+armor 为跨 count 稳定病灶。
//   教训：① 同配方加轮/加密度不搬运偏科关（x2-acbc 已证一次，本腿证第二次）；
//   ② 量纲按 transitions/轮记账（※ 2026-09-15 勘误：transitions=samples，本腿
//      60×4×97 ≈ 2.33 万/轮，原写「60×4×967≈23 万」是 ticks，10×；c4-dodge
//      原写 ~66 万+ 同为 ticks ⇒ 实际 ~6.6 万 samples。见 DECISIONS
//      §2026-09-15-goalnn-x3-power-negative 与 plan/dynamic-rollout-volume §1）；
//   ③ 在途 eval 行 iter=权重轮（P0 事后口径），日常数右移一轮读。
//   后续：x3-power（杀/中信用比）接棒；本腿归档保留 it180/it333 双点。
//
// 启动：
//   启动走**控制台开课**：`bun run dashboard` → http://127.0.0.1:8900 → 选本课 → 开课。
//   （裸 CLI 启动已下线：绕过控制台 = 漏开课标记/暂停解禁/hub 模式三件套 —— plan/accident.plan.md §1；agent 不得启动训练）
{
  "version": 5,
  "name": "x3-start",
  // 每一决策步一条样本（非 intent/goal 窗口）。与 Student 双头 BC / 当前 PPO 管线匹配。
  "mode": "per-tick",
  // 环境唯一来源 = levels/ladder-c03.jsonc（与 arena3 逐关同形，arena3 已退役删除）。
  // 课程侧禁止再写 stages/difficulty/max_ticks/player。
  "level": "ladder-c03",

  // ── 采集 / 语料 ────────────────────────────────────────────────────────────
  // 每关每轮 rollout 局数（实现语义：每关抽 seed_rotate 个新 seed，
  // 全轮 = seed_rotate × 关数；见 rl/course.py build_pairs）。
  // arena3 四关 × 60 = 240 局/轮（与 x2-start 同量级；v2 实测 150~300 局差别不大，
  // 先按小批量快迭代；若 advantage/value 噪声大再往上加）。
  // 注意：单关课 seed_rotate 即总量，多关课必须除以关数——600 在此会采 2400/轮。
  "seed_rotate": 60,
  // 并发采样 worker 数（LAN 节点槽位合计；8 = 本机+局域网常见配额）。
  "workers": 8,

  // ── 奖励（v3 早期关；语义变更 = 新 reward_identity，禁止续旧 traj）─────────
  "reward": {
    // 只保留：击杀 + 命中 + 统一过关（公式内阶跃项）+ 死亡 terminal。
    // 不上：wDmg（与死亡重复）/ wChip（c01-c03 承伤基数过小）/ wTick（线性时间会
    // 压过通关）/ wStuck / wShot / 泛化 wPickup。
    // toy 力学注意：outcome 虚拟量（is_lives_exhausted 等）是全 episode 常量，
    // 经 diff(Φ) 后恒为零——终局信号必须走 terminal，禁止写进 formula。
    // 反之 clearTick 是阶跃函数（清场前 -1、后恒 C），where 项经 diff 后在清场步
    // 打出 +wWin 尖峰（含清场后被 max_ticks 截断的 BONUS 局），故留公式内。
    "formula": "wKill*kills + wHit*enemyHits + wWin*where(clearTick>=0, 1, 0)",
    "params": {
      // 杀一个敌人的主要信用。完成目标的锚点（roadmap：wKill 固定，早期关主信号）。
      "wKill": 3.0,
      // 打中一发的稠密信用。与 wKill 不重复：一个管「打死」，一个管「打得准」。
      // 血量偏差已知（pool 模型 0 星玩家每杀所需命中：armor 4 vs basic 3、
      // fast/power 2——classic 的 4:1 口径不适用）：I4 报告须按关拆 shots/kill 与命中率。
      "wHit": 0.3,
      // 统一过关奖：clearTick>=0 即发（含清场后被 max_ticks 截断的 BONUS 局）。
      // 对应 win = stage_clear ∪ cleared，避免「做对了却按超时罚」。
      "wWin": 2.0,
    },
    // 死亡罚进 terminal（公式内写恒为零，见上）。timeout 刻意 0：速度靠关卡 max_ticks；
    // 死亡 -1 < 超时 0，「2 杀后活到超时」优于「2 杀后阵亡」。
    "terminal": {
      "lives_exhausted": -1.0,
    },
    // Phi 势差 + 末样本 terminal 的玩具场方案（非 score_reconcile 对账）。
    "scheme": "toy",
  },

  // ── 策略起点 / 缰绳 ────────────────────────────────────────────────────────
  // x2-start.it50 暖启（实际开工权重，见文件头）。暖启 = 初始化手段，不是能力继承（D10）。
  "bc": "nn-training/weights/x2-start/x2-start.it50.20260914-202927.json",
  // 开：冻结 BC 作 kickstart 参考策略，PPO 前期用 KL 缰绳防止冲掉暖启。
  "kickstart_ref": true,
  // 必须为 0：kickstart 要求 it1 就上缰绳；非 0 会把首轮系数归零（config 硬校验，
  // 改 1 直接启动失败——故 warmup_iters=1 不是可选项）。
  // 注：BC 无 value 头；it1 必须记录 value loss 起始值（I4 报告字段）。若 >0.8，
  // 救济只能是离线 value 预训或接受尖峰（normalize_ret 已开），禁改本字段。
  "warmup_iters": 0,

  // ── PPO 优化器 ─────────────────────────────────────────────────────────────
  // 学习率。热启偏保守，防一步冲掉暖启特征（工厂默认 1.5e-4）。
  "lr": 0.00015,
  // 每轮把采到的 transition 过几遍。4 = 短局下兼顾样本利用与 off-policy 程度。
  "epochs": 4,
  // mini-batch 大小。512 与历史课程一致；短局轮里再大容易抬 KL 噪声。
  "mb": 512,
  // 把本轮 return 在 batch 内标准化。工厂默认开：短局回报尺度波动大，归一后 value 更稳。
  "normalize_ret": true,
  // 折扣因子。0.998 偏长视野（对齐工厂）；3 敌局一般 800~2000 tick 结束。
  "gamma": 0.998,
  // GAE lambda。工厂定 0.95（bias-variance 折中）；比旧 p2-step 的 0.99 更偏低方差。
  "lam": 0.95,

  // ── 学习率 / KL 日程（按轮分段；直到 until_iter 含端点）────────────────────
  "ppo_schedule": [
    // 前 40 轮：稳住缰绳。kl_coef 0.2 = 允许偏离暖启但不乱飞；kl_cap 0.2 = KL 硬顶。
    { "until_iter": 40, "kl_coef": 0.2, "lr": 0.00015, "kl_cap": 0.2 },
    // 40 轮后：放缰 + 更小步长精修。kl_coef 0.03（工厂；不是 0——完全松开容易漂）。
    { "kl_coef": 0.03, "lr": 0.00005 },
  ],

  // ── 预算 / 路径 ────────────────────────────────────────────────────────────
  // 本腿总轮数。0 = 无限轮。
  "iters": 0,
  // 墙钟上限（小时）。0 = 不按墙钟砍；12 = 工厂默认一班岗。
  "max_hours": 12,
  // 输出权重指针（每轮覆盖写）。
  "out": "tmp/x3-start/weights.json",
  // 轨迹/账本目录。reward 或语料语义变更后必须换新目录（§15.5），禁止续跑。
  "traj": "tmp/x3-start",
  // 归档目录与文件名前缀（it 后自动接 .itN.timestamp.json）。
  "backup_dir": "nn-training/weights/x3-start",
  "backup_prefix": "x3-start",

  // ── 护栏 ───────────────────────────────────────────────────────────────────
  // 熵熔断：entropy 连续低于阈值过多轮则停车。0.25 比默认 0.60 更紧——
  // 暖启策略天生低熵，防「假性坍塌」误停要用相对崩塌语义（breaker 配套）。
  "ent_break": 0.25,

  // ── 评估 ───────────────────────────────────────────────────────────────────
  // arena3 四种类型三元组：ID 2000-2003（abc/abd/acd/bcd）。每关各 eval_games_per_stage 局。
  // 日常 50/关（4×50=200 局/次，降开销）；正式门评估才上 200/关（4×200=800 局/次，
  // 两轮 pooled 1600 局判 ≥80%，种子不重叠、间隔 ≥5 轮——见文件头晋级门）。
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  // 每 N 轮 eval 一次。
  "eval_every": 5,
}
