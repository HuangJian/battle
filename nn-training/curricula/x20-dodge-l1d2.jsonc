// 课程 x20-dodge-l1d2 —— **开局闪避腿剂量重试：wOpen 0.01→0.02**（dodge-avoidance §4 L1 二轮）
//
// 状态：**草稿，待用户手工开训**（agent 不得启动训练）。
//
// 立项（L1 首轮结算 2026-09-25 判负后的预注册下一步）：首轮 wOpen=0.01 跑满 it300，机制
//   （clean600 52.5→51.0% / dmg600 71.0→68.9）零进展、门控四候选全灭；唯一亮带 it55~65
//   （clean 58~62% / dmg 58~61 + 配对 low −7~−10pp）未维持。判语原文："下一步按剂量梯升
//   wOpen=0.02（§4 剂量重试）"。本腿就是那次重试：**只升一档，不做第三轮**
//   （plan §4 剂量重试：每条腿只允许升一档重试一次；重试结论与首轮合并结算）。
//
// 单变量纯度：与 L1 首轮文件**逐字相同**，只改 `wOpen: 0.01 → 0.02`（reward 进血缘正确）。
//   base 仍是 noexplore 原公式 + 开局窗双倍定价（wOpen 与 wDmg 同量纲：开局每滴血 4×）。
//   采样 49152 / mb 1024 / lr / epochs / gamma / lam / schedule / seed_rotate 全同。
//   剂量：0.02 档典型局 −1.7 ≈ 0.6杀（仍在量纲锚内；上限 0.03 留空，若本轮再负则判死不断杯）。
//
// 起点：noexplore 最优 it105（`x20-noexplore.it105`），纯 warm start，`kickstart_ref=false`。
//   comparator = noexplore 同绝对 it 点历史（run 内 itN = 绝对 it105+N；abs>180 后无对照裸奔，
//   与 L1 首轮同口径）。配对：`paired_rotate_seed` 与 L1 首轮**同值 1789876303**
//   ⇒ 训练语料与首轮逐轮同 batch（同 key 同数据）：剂量是唯一的差，比较干净。
//   414000 无 demo 污染（无 demo 参与），判决主段 = 414000。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据
// ══════════════════════════════════════════════════════════════════════════
// **主读数顺序写死：机制先行**（plan §8 链条）：① clean600% + dmgFirst600 分布是否上移
//   （日常 eval 自带，无需 resim；首轮真基线 it0 = 52.5%/71.0，n=200 bc——被污染的
//   53.0%/68.5 不用，见 L1 结算⑦）② low% 是否跟随下移 ③ 顶部死亡占比。
//   it40 只记录、不停腿（it40 误杀门已废）。
// **门**：414000 段 `low% 相对 noexplore 同 it 点改善 ≥3pp` 且 `p10 ≥ 2`
//   （noexplore it105 段值 33.0/8.33/p2）。
// **约束（只记录 + 人工盯盘决策，不自动停）**：日常 mean < 6.19；超时 >5%；
//   kl 连续 3 轮 ≥0.075；保守陷阱（cells/move/pass 任一显著下降）。
// **回测门**：终点候选 415000 不劣于 noexplore 同 it 点（同段同种子配对）。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行）
// ══════════════════════════════════════════════════════════════════════════
//   · **专属死刑（比横盘更早）**：clean600% + dmgFirst600 分布连续 3 个 eval 点不动
//     ⇒ 停腿（信号没进去，后面免谈；首轮 it55~65 亮带若重现则续看，不杀）。
//   · **上/下限**：mean < 6.19 或 timeout >5% ⇒ 人工决策停。
//   · **机械横盘**：low% 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮。
//   · B1 分支预注册：T2/T3（clean600/dmg600）动 + low% 不动 ⇒ 下一腿 state-init，
//     本腿按达标归档（过程改善≠失败）。首轮未触发（双双零进展），本轮重判。
//   · 本轮再负 ⇒ L1 方向判死（B1/B2 分支按 plan §6 走，不开 wOpen=0.03 第三轮）。

{
  "version": 5,
  "name": "x20-dodge-l1d2",
  "mode": "per-tick",
  // 环境不变：ladder-c20-lives1（4 关 2000-2003、20 敌、max_ticks 12900、lives 1、hard）。
  // 任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c20-lives1",

  // ── 奖励：L1 首轮公式 + ★wOpen 升一档 ────────────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited + wPickup*powerUpsCollected - wApproach * where(pickupDist < 0, 0, pickupDist) - wOpen * dmgFirst600",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.0,
      "wPickup": 3.0,
      "wApproach": 0.008,
      "wOpen": 0.02
    },
    // dense-only（与父腿一致）：terminal 空表合法。
    "terminal": {},
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：noexplore 最优 it105，纯 warm start ──────────────────────────────
  "bc": "nn-training/weights/x20-noexplore/x20-noexplore.it105.20260922-053620.json",
  "kickstart_ref": false,
  "warmup_iters": 0,
  // ── 配对：与 L1 首轮同 V（1789876303）──────────────────────────────────────
  // 同 key 同 batch ⇒ 剂量是唯一的差。⚠ 改它 = 非配对（且与首轮不可比）。
  // 本腿不开 paired-kill（默认关；单腿绝对门，无配对杀臂——2026-09-26 opt-in 教训）。
  "paired_rotate_seed": 1789876303,

  // ── 预算 ───────────────────────────────────────────────────────────────
  "iters": 300,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：回基线（与 noexplore / L1 首轮一致）────────────────────────────
  "lr": 0.0003,
  "epochs": 4,
  "mb": 1024,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "kl_coef": 0.05, "lr": 0.0003, "kl_cap": 0.2 }
  ],

  // ── 采集：mb 对齐 ────────────────────────────────────────────────────────
  // 49152 = 48 × mb(1024)；per-stage quota = 12288 = 12 × mb ⇒ 无 ragged tail。
  "target_transitions": 49152,
  "est_samples_per_game": 147,
  "seed_rotate": 150,

  // ── 路径：新目录、禁续跑（§15.5；剂量语义变更 = 新实验）────────────────────
  "out": "tmp/x20-dodge-l1d2/weights.json",
  "traj": "tmp/x20-dodge-l1d2",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/x20-dodge-l1d2",
  "backup_prefix": "x20-dodge-l1d2",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2003",
  "eval_games_per_stage": 50,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① bc 文件存在（noexplore it105）。② 公式编译验证（validate_reward 零错误零警告；
//    wOpen=0.02 进血缘是指纹变化的正确原因）。③ metrics v8 全链路（首轮已部署，复用）。
// ④ 新 out/traj 目录（禁续跑，§15.5）。⑤ remote_hubs 登记 + slot 容量 + worker 心跳。
// ⑥ it0 基线现跑：开训后先用 bc 跑 400 局日常段（860001，同种子），单 wver 校验通过
//    才算数——C-0 教训（200 局 it0 分母太小，+2.65pp 都判不了）+ L1 事故（it0 混入 it43
//    权重误标）：400 行同 wver 否则重跑；首轮 200 局旧基线仅作参考，判读以 400 局为准。
//    已跑（2026-09-26，开训前）：n=400 win 15.50%（62/400）kills 7.71 low% 37.50 p10 1
//    p50 5，单权重源（spec 锁定 noex-it105；与 C-0 那次 bc 现跑逐局一致，确定性旁证）。
//    数据：`tmp/dodge-it0-baseline-860001.jsonl`（四腿共用，同 bc 同段）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it0/it5…（860001 段 400 局）clean600%/dmg600 分布/low%/mean/p10 +
//   与 L1 首轮同 run-it 对照（同 V 同 batch，剂量差的直接读数）+ noexplore 同绝对 it 点对照。
// · 首轮数据：`tmp/x20-dodge-l1/settle/judge-414000.jsonl` + `backtest-415000.jsonl`。
// · value 首行均值每 eval 点记录（state-init 教训：V 的 it0 基线被 workdir sweep 吃掉；
//   本腿从 it0 起每点 pin 一份，workdir 清理不得删该记录）。
//
// ── 结算节（跑完回填；结论与首轮合并，plan §4）──────────────────────────────
// 必填：① clean600%/dmg600 it0 → 终点 + 首轮同 it 对照 ② low% 是否跟随 ③ 414000 主段 +
//   415000 回测（800 局）④ 分关表 ⑤ 顶部死亡占比 ⑥ 超时/换血读数 ⑦ 实际轮数与耗时
//   ⑧ 合并判语：两轮剂量 (0.01, 0.02) 联合结论（若本轮亦负 ⇒ L1 方向判死）。
//
// ── 结算（2026-09-26 回填：it1–31，用户手工停腿，07:59→10:37 ~2.6h；门控同日）──
// ① 机制（日常，腿内趋势；历史臂 pre-v8 无 dmg 字段，无配对基线）：it0 真基线 52.5%/71.0
//    （n=200 bc）→ it30 51.2%/69.4（Δ−1.3pp/−1.6，噪声），零进展；唯一亮带 it15
//    （58.2%/62.7）未维持；it20 全程最差（48.5%/78.0）。专属死刑按字面成立。
//    首轮同 it 对照：首轮 it10/25/30 clean ≈ 53~55%/dmg ≈ 68~72，本轮 53.2/50.7/51.2% /
//    70.7/73.6/69.4——两轮同窗同平，加量未改变形状。
// ② 日常 low：it0 40.0/7.64 → it30 37.2/7.82（Δ−2.8pp 日常）；最优 it10 35.8/7.55
//    （−4.2pp），it20 崩 39.2/7.01。judge 行无 v8 列，门控段机制不可测（与首轮同）。
// ③ 414000 主段（800局/权重，用户点名 it10/25/30 + noex-it105 同命令同 seed0 四权重配对；
//    noex-it105 复测 33.0/8.33/p2/win18.1，与档案逐字吻合）：it10 38.4/7.26/p2
//    （+5.4pp，McNemar 154/197 p=0.025 显著更差）· it25 37.0/7.77/p2（+4.0pp，p=0.086）·
//    it30 35.5/7.92/p1（+2.5pp，p=0.32）。**门（−3pp 且 p10≥2）三候选全灭**。
// ④ 415000 回测（同口径；noex-it105 36.9/7.44/p1，与档案吻合）：it10 +2.5pp（p=0.32）·
//    it25 +1.8pp（p=0.48）· it30 −3.4pp（p=0.15 不显著）。回测改善＋主段恶化＝跨段不稳定。
// ⑤ 分关：门控段无单关亮点（it10 s2000 low 29.5→48.0 崩；it30 s2001 38.0→31.5 唯一改善，
//    被 s2000 +10pp 淹没）。早死占比（dead 中 ticks≤900）：基线 28.7% → 29.0/34.5/30.6%，无改善。
// ⑥ 超时/换血：两段超时全 0；dmg/局 it0 243 → it30 254（全局换血亦不动）；约束全绿
//    （mean≥7.0、kl≤0.013、ent 0.54~0.66 无塌、cells 74~80 无塌）。
// ⑦ 实际：it1–31（预算 300/12h 的 ~10%）；用户控制台手工停（loop-control paused），
//    in-flight it32 rollout 废弃（dist 残留 36 shards，无 it33）；末归档权重 it31。
//    judge+backtest 各 3200 局（4权重×800，含基线同命令配对——比首轮更强，注记在案）。
//    配对键勘误：行字段是 `stageId` 不是 `stage`，错键压行出伪读数（已更正，结论不变）。
// 判语：**判负**。⑧ 合并：两轮剂量 (0.01, 0.02) 机制双零进展、门控七候选（首轮四+本轮三）
//    全灭 ⇒ **L1 方向判死，不开 wOpen=0.03 第三轮**；B1 不触发（T2/T3 双双不动）。
// 数据：`tmp/x20-dodge-l1d2/settle/judge-414000.jsonl` + `backtest-415000.jsonl`（.run/spec 同目录）。
