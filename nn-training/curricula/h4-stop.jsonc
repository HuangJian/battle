// 课程 h4-stop —— **新纪元第 4 课：x4 rung（ladder-c04），STOP-only**（plan/new-era-stop.plan.md §7）
//
// 状态：**草稿，待用户手工开训**（agent 不得启动训练）。
//   **前置**：h3 过门 + 冠军权重归档后，才能 pin `bc` 开课（起点占位见下）。
//
// 立项：梯子第四 rung。B 案 STOP 语义沿用；均匀 K=10（事件 rung 另开，plan §6 R2）；
//   flat critic（解耦 rung 条件未到：x1/x2 表示已验且 danger 不动才开）。
//
// 配方（= x1-a2 v4 包逐字，x4-rebirth 同款）：
//   wKill 3.0 / wHit 0.6 / wWin 2.0 / wDmg 0.03 / wShot 0.05 / **wExplore 0.2**
//   + terminal lives_exhausted −5.0 / timeout −2.0。
//   （wExplore 衰减表：x1/x2/x3 保留 0.2 → x20 rung 归零，衰减表进 DECISIONS 开腿条目。）
// 位移包（x4-rebirth 原样）：lr 0.0005 / epochs 6 / mb 512 / kl 0.02（25 轮）→0.01。
//
// 起点：h3 冠军 warm start，`kickstart_ref=true`（梯子链 kk=true 绿过；C 事故是同任务续命，另案）。
//   ⚠ `bc` 下面的占位必须在开课前换成 h3 冠军实际文件名，否则拒启。
//   comparator = 本 rung 绝对门 + 自身趋势（跨 rung/跨纪元不配对）。
//
// ══════════════════════════════════════════════════════════════════════════
// 判据（x4 rung 绝对数门，2026-09-27 已 pin；脚注：h3-it80 零射 h4 关 20.0%/196/零伤5.0%，
//   x4-rebirth 前例 53.4→80.4%（+27pp）、dmg 115→47（同图！）；门要求真学习量：
//   +60pp win、dmg 腰斩半多、零伤×6。不达标按横盘停，不判死。200 局分母 SE≈3.5pp，留余量。）
// ══════════════════════════════════════════════════════════════════════════
// **门**：日常段（860001，单关 200 局）`pass ≥ 80%` 且 `dmg/局 ≤ 80` 且 `零伤通关 ≥ 30%`。
// **机制链**：① stopPickRate（侧车计数）② threat/clean ③ pass/dmg 跟随。
// **约束**：超时 >5% ⇒ 人工决策停；kl 连续 3 轮 ≥0.075 ⇒ 记录 + 人工盯盘；
//   ent 跌破 0.25 ⇒ break；掉队不适用（单关）。
// **判据一律不得由教师表现反推**（AGENTS §0.2）。
//
// ══════════════════════════════════════════════════════════════════════════
// 止损（人工盯盘执行）
// ══════════════════════════════════════════════════════════════════════════
//   · **专属死刑**：stopPickRate 连续 3 个 eval 点 < 10/千tick（前置：探针链通）⇒ 停腿；
//     熵早期塌陷 ⇒ 先开判别臂，通过后才进 B2。
//   · **对称死刑**：stopPickRate 连续 3 点高于人类基线上四分位 ⇒ 停腿 ⇒ B0。
//   · **机械横盘**：pass/dmg 连续 4 个 eval 点无改善 ⇒ 停腿；宽限一次 +10 轮，不得二次宽限。
//   · B1/B3/B4 按 plan §8。
//
//   注：x4 eval 为单关 200 局（x4-rebirth 原样：eval 2000-2000/200/5），分母比别 rung 小，
//   读数方差大一档，判读留余量（C-0 教训：200 局分母小，±2.65pp 判不了）。

{
  "version": 5,
  "name": "h4-stop",
  "mode": "per-tick",
  // 环境：ladder-c04。任务侧一个字不动（AGENTS §0.2）。
  "level": "ladder-c04",

  // ── 奖励：x1-a2 v4 包逐字 ──────────────────────────────────────────────
  "reward": {
    "formula": "wKill*kills + wHit*enemyHits + wWin*where(clearTick>=0, 1, 0) - wDmg*playerDamageTaken - wShot*playerShots + wExplore*cellsVisited",
    "params": {
      "wKill": 3.0,
      "wHit": 0.6,
      "wWin": 2.0,
      "wDmg": 0.03,
      "wShot": 0.05,
      "wExplore": 0.2
    },
    "terminal": {
      "lives_exhausted": -5.0,
      "timeout": -2.0
    },
    "scheme": "toy"
  },
  "dodge": "",

  // ── 起点：h3 冠军 warm start（2026-09-27 已 pin：h3 it115 87.5%/59/零伤58.2，sha 已验）─
  "bc": "nn-training/weights/h3-stop-best/h3-stop.it115.best.json",
  "kickstart_ref": true,
  "warmup_iters": 0,

  // ── 预算（x4-rebirth 原样：小时封顶；轮数 artifact 化）─────────────────────
  "iters": 150,
  "max_hours": 12,
  "workers": 8,

  // ── 位移包：x4-rebirth 原样 ─────────────────────────────────────────────
  "lr": 0.0005,
  "epochs": 6,
  "mb": 512,
  "normalize_ret": true,
  "gamma": 0.998,
  "lam": 0.95,

  "ppo_schedule": [
    { "until_iter": 25, "kl_coef": 0.02, "lr": 0.0005, "kl_cap": 0.2 },
    { "kl_coef": 0.01, "lr": 0.00025 }
  ],

  // ── 采集 ───────────────────────────────────────────────────────────────
  "target_transitions": 24000,
  "est_samples_per_game": 180,
  "seed_rotate": 600,

  // ── 路径：新目录、禁续跑（§15.5）────────────────────────────────────────
  "out": "tmp/h4-stop/weights.json",
  "traj": "tmp/h4-stop",
  "ent_break": 0.25,
  "backup_dir": "nn-training/weights/h4-stop",
  "backup_prefix": "h4-stop",

  // ── 评估 ───────────────────────────────────────────────────────────────
  "eval_stages": "2000-2000",
  "eval_games_per_stage": 200,
  "eval_every": 5
}

// ── 开工前置 ─────────────────────────────────────────────────────────────
// ① h3 门边未过（it115 87.5%/59/零伤58.2，最优）+ 冠军归档 + `bc` 已 pin 真实文件（已验）。
// ② 门 X/Y 按 §1 梯子门原则 pin 死（以 h3 终点 + rung 难度定，不拍脑袋；200 局分母小留余量）。
// ③ 公式编译验证（validate_reward；与 v4 逐字同是正确原因）。
// ④ 新 out/traj 目录（禁续跑）。⑤ 节点心跳。⑥ paired-kill 默认关（opt-in）。
//
// 启动（**用户手工；agent 不得启动训练**，经控制台开课）。
//
// ── 诊断工具 ─────────────────────────────────────────────────────────────
// · 日常趋势：it0/it5…（860001 段，单关 200 局）pass/dmg/stopPickRate（侧车）/cells。
// · 事件 rung（plan §6 R2）另开课程，不进本文件。
//
// ── 结算节（跑完回填）──────────────────────────────────────────────────────
// 必填：① pass/dmg it0 → 终点 ② stopPickRate ③ 超时/换血
//   ④ 实际轮数与耗时 ⑤ 判语（过门⇒ h5/c20 rung（critic 解耦 + 事件包，到时按 R2 开）；
//   idle 平 ⇒ B2；停太多 ⇒ B0）。
//
// ── 结算（2026-09-27 回填：it1–150，预算打满；日常到 it145）──
// ① 日常（860001，单关 200 局）：it0 64.0%/136 → it25 84.0%/92 → 其后 74–86%/85–119 震荡
//    120 轮（it30–145），无趋势；rollout wr it11 起 0.93~0.95 天花板，尾部 0.82。
//    门（80/80/30）：仅 it90 84.0/80.0/44.0 全过——压线（dmg 恰 80.0）+ 前后 it85/95/100
//    全败 ⇒ spike 未确认，不加冕（L1d2 教训）。
// ② stopPickRate：it0 4.8%（冠军自带，威胁响应）→ it15 起 ~0，全程痕量；梯子豁免。
//    STOP 在 h4 从未进入选择集（v4 价格下理性弃子，h4 双臂报告）。
// ③ 超时全 0；换血 dmg 136→85（最好）→尾部回升 100+；PPO 健康（kl≤0.01、ent~0.6）。
// ④ 实际：it1–150（预算 150 用满，~10h）。
// 判语：**判负**（门未过：唯一压线未确认；120 轮横盘；尾部下行 it115–145 win 77–85/dmg 97–113）。
//    终点 = **it60**（86.0%/89/41.0：pass 最高，x3 先例"互不可区分取 pass 高者"；it90 spike 注记备选）。
//    冠军归档 `nn-training/weights/h4-stop-best/h4-stop.it60.best.json`（sha 已验）。
//    下一步 h5（x5 rung，bc pin it60，待写；事件/critic rung 条件未到）。
// 数据：`tmp/h4-stop/eval_log.jsonl`（it0/5/…/145）。
