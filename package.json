{
  "name": "battle-city-web",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "oxlint && bun check --no-script && vite build",
    "preview": "vite build && vite preview",
    "test": "bun tools/test-silent.ts",
    "test:changed": "bun tools/test-silent.ts --changed",
    "typecheck": "bun check --no-script",
    "bench": "bun tools/sim/bench-sim.ts",
    "perf:sim": "bun tools/perf/sim-bench.ts",
    "perf:render": "bun tools/perf/render-bench-all.ts",
    "perf:pixdiff": "bun tools/perf/pixdiff.ts",
    "gen-levels": "bun tools/level/level-gen.ts",
    "sim-levels": "bun tools/sim/batch-sim.ts",
    "ai-calibrate": "bun tools/eval/ai-calibrate.ts",
    "calibrate": "bun tools/eval/calibrate.ts",
    "curriculum": "bun tools/optimize/curriculum.ts",
    "gen-thumbnails": "bun tools/level/gen-thumbnails.ts",
    "gen-library": "bun tools/level/gen-library.ts",
    "play-generated": "bun tools/level/play-generated.ts",
    "lint": "oxlint",
    "format": "bun fmt",
    "dashboard": "cd dashboard && bun run start",
    "check": "bun check --no-script && bun tools/check-decisions.ts && bun tools/check-agents-budget.ts && bun tools/run-root-tests.ts",
    "budget:check": "bun tools/check-agents-budget.ts",
    "freeze:check": "bash tools/probe-det-baseline.sh --golden",
    "freeze:l2": "bun tools/diag/archived-reach-audit.ts",
    "pygate": "bash tools/githook/nn-python-gate.sh",
    "setup": "git config core.hooksPath tools/githook"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@types/bun": "^1.3.14",
    "oxlint": "^1.74.0",
    "vite": "8.1.5"
  }
}
